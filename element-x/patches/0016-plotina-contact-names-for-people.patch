+        )
+
+        val shown = roomInfo.withPlotinaContactName(mapOf(bob to "Денчик"))
+
+        assertThat(shown.name).isEqualTo("QA Группа")
+        assertThat(shown.heroes.single().displayName).isEqualTo("Денчик")
+    }
