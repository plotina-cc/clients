+package io.element.android.libraries.matrix.impl.room
+
+import io.element.android.libraries.matrix.api.core.UserId
+import io.element.android.libraries.matrix.api.room.RoomMembersState
+import io.element.android.libraries.matrix.api.room.alias.PlotinaPersonalNames
+import io.element.android.libraries.matrix.api.room.alias.withPlotinaContactNames
+import kotlinx.coroutines.flow.FlowCollector
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.distinctUntilChanged
+
+/**
+ * Plotina: a [StateFlow] of the room's members with the account's personal names laid over them.
+ *
+ * The wrapped flow keeps what the SDK reported; the names are applied to it here, which gives the
+ * two properties the member list needs:
+ *
+ * - [value] is the overlaid state, so a caller reading it right after [BaseRoom.updateMembers] sees
+ *   the same names a collector sees (no "eventually consistent" window);
+ * - collection re-emits whenever the names change, which is what makes an open member list follow a
+ *   rename without a re-fetch — and with it the mention cache, typing notice and receipts built from
+ *   the same objects.
+ */
+internal class PlotinaMembersStateFlow(
+    private val membersState: StateFlow<RoomMembersState>,
+    private val names: StateFlow<Map<UserId, String>>,
+) : StateFlow<RoomMembersState> {
+    override val value: RoomMembersState
+        get() = membersState.value.withPlotinaContactNames(PlotinaPersonalNames(names.value))
+
+    override val replayCache: List<RoomMembersState>
+        get() = listOf(value)
+
+    override suspend fun collect(collector: FlowCollector<RoomMembersState>): Nothing {
+        combine(membersState, names) { state, names ->
+            state.withPlotinaContactNames(PlotinaPersonalNames(names))
+        }
+            .distinctUntilChanged()
+            .collect(collector)
+        // combine() only ends when one of its sources does, and a session scoped state flow never
+        // completes; reaching this point would mean the contract above is broken.
+        throw IllegalStateException("The room members state flow completed")
+    }
+}
