+    @Test
+    fun `a name the user chose is not reported as ambiguous`() {
+        val names = PlotinaPersonalNames(mapOf(bob to "Денчик"))
+
+        // The SDK flagged the real name: two members are called "Даниил".
+        val member = aMember(bob, "Даниил", isNameAmbiguous = true).withPlotinaContactName(names)
+
+        assertThat(member.isNameAmbiguous).isFalse()
+        assertThat(member.disambiguatedDisplayName).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `two contacts named the same are told apart in the member list`() {
+        // Two people with different real names, both given "Дима": the SDK knows nothing about it.
+        val members = listOf(
+            aMember(bob, "Даниил"),
+            aMember(carol, "Карл"),
+        )
+        val names = PlotinaPersonalNames(mapOf(bob to "Дима", carol to "Дима"))
+
+        val shown = members.withPlotinaContactNames(names)
+
+        assertThat(shown.map { it.disambiguatedDisplayName }).containsExactly(
