+    }
+
+    @Test
+    fun `a person renamed away from a duplicated name loses the marker`() {
+        // Two members called "Иван" for the SDK; the account renames one of them.
+        val members = listOf(
+            aMember(bob, "Иван", isNameAmbiguous = true),
+            aMember(carol, "Иван", isNameAmbiguous = true),
+        )
+        val names = PlotinaPersonalNames(mapOf(bob to "Иван Петров"))
+
+        val shown = members.withPlotinaContactNames(names)
+
+        // "Иван Петров" is unique, and the remaining "Иван" is no longer duplicated.
+        assertThat(shown.map { it.disambiguatedDisplayName }).containsExactly("Иван Петров", "Иван")
+    }
