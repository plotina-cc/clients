+/**
+ * Plotina: the personal names of the account's contacts, ready to be laid over the names the SDK
+ * reports. It is the Kotlin mirror of [PlotinaContactNames] for a *person* rather than for a room.
+ *
+ * The SDK builds every human name from the member state and has no notion of a local label, so a
+ * personal name can only be applied after the fact, on the models the app renders. This type is
+ * what those overlays read: [names] is the account's `cc.plotina.contact_names` map, and
+ * [sharedNames] marks the personal names that two people of the same room carry, which is the
+ * disambiguation the SDK cannot compute for us (it counts real names only).
+ *
+ * Nothing here is ever written anywhere: the overlays replace model fields, so no name can reach
+ * `m.room.member`, `m.room.name` or the body of a message.
+ */
+@Immutable
+data class PlotinaPersonalNames(
+    val names: Map<UserId, String> = emptyMap(),
+    /**
+     * Personal names that more than one member of the room carries. Those keep the `(@mxid)` suffix
+     * even though the user chose the name: two people shown under one name are still two people.
+     */
+    val sharedNames: Set<String> = emptySet(),
+) {
+    val isEmpty: Boolean = names.isEmpty() && sharedNames.isEmpty()
+
+    /** The personal name of [userId], or `null` when the account gave them none. */
+    fun nameFor(userId: UserId?): String? {
+        if (userId == null) return null
+        return names[userId]?.takeIf { it.isNotBlank() }
+    }
+
+    /** Whether the personal name [name] is used for more than one person of the room. */
+    fun isShared(name: String?): Boolean = name != null && name in sharedNames
+
+    companion object {
+        /**
+         * The personal names of [names], with the shared ones recomputed over [members].
+         *
+         * A member's effective name is their personal name when they have one, the SDK's name
+         * otherwise; a personal name carried by more than one member of the room is shared and must
+         * be disambiguated. With no members (a room whose member list is not loaded yet) nothing is
+         * marked shared, so an unloaded list never invents a suffix.
+         */
+        fun among(names: Map<UserId, String>, members: List<RoomMember>): PlotinaPersonalNames {
+            if (names.isEmpty() || members.isEmpty()) return PlotinaPersonalNames(names)
+            val effectiveNames = members.mapNotNull { member ->
+                names[member.userId]?.takeIf { it.isNotBlank() } ?: member.displayName?.takeIf { it.isNotBlank() }
+            }
+            val counts = effectiveNames.groupingBy { it }.eachCount()
+            val shared = names.values
+                .map { it.trim() }
+                .filter { it.isNotEmpty() && (counts[it] ?: 0) > 1 }
+                .toSet()
+            return PlotinaPersonalNames(names = names, sharedNames = shared)
+        }
+    }
+}
+
+/**
+ * [RoomMember] with the account's personal name for that person on top of the SDK's name.
+ *
+ * A contact the user named deliberately is no longer reported as ambiguous by the SDK, because the
+ * SDK compares real names: the personal name wins and the flag is cleared. Collisions between
+ * personal names are the caller's business - use [withPlotinaContactNames] on a whole member list
+ * so they can be detected.
+ */
+fun RoomMember.withPlotinaContactName(personalNames: PlotinaPersonalNames): RoomMember {
+    val name = personalNames.nameFor(userId)
+    return if (name == null) {
+        // No personal name: the SDK's name and its ambiguity flag stand as they are.
+        this
+    } else {
+        copy(displayName = name, isNameAmbiguous = personalNames.isShared(name))
+    }
+}
+
+/**
+ * The room's member list with the account's personal names applied, and the `(@mxid)` markers
+ * recomputed over the final list.
+ *
+ * The SDK computes `is_name_ambiguous` from real names only, which is wrong in both directions once
+ * personal names exist: two contacts named "Дима" are not flagged (a false negative), and a person
+ * renamed away from a duplicated name keeps a pointless marker (a false positive). Both are fixed
+ * here, over the names actually shown.
+ */
+fun List<RoomMember>.withPlotinaContactNames(personalNames: PlotinaPersonalNames): List<RoomMember> {
+    if (personalNames.names.isEmpty()) return this
+    val renamed = map { member ->
+        val name = personalNames.nameFor(member.userId)
+        if (name == null) member else member.copy(displayName = name)
+    }
+    val counts = renamed.mapNotNull { it.displayName?.takeIf { name -> name.isNotBlank() } }
+        .groupingBy { it }
+        .eachCount()
+    return renamed.map { member ->
+        val ambiguous = member.displayName?.let { counts[it] ?: 0 }?.let { it > 1 } ?: member.isNameAmbiguous
+        if (ambiguous == member.isNameAmbiguous) member else member.copy(isNameAmbiguous = ambiguous)
+    }
+}
+
+/** [RoomMembersState] with the personal names applied to every list it carries. */
+fun RoomMembersState.withPlotinaContactNames(personalNames: PlotinaPersonalNames): RoomMembersState {
+    if (personalNames.names.isEmpty()) return this
+    return when (this) {
+        is RoomMembersState.Unknown -> this
+        is RoomMembersState.Ready -> RoomMembersState.Ready(roomMembers.withPlotinaContactNames(personalNames).toImmutableList())
+        is RoomMembersState.Pending -> RoomMembersState.Pending(prevRoomMembers?.withPlotinaContactNames(personalNames)?.toImmutableList())
+        is RoomMembersState.Error -> RoomMembersState.Error(failure, prevRoomMembers?.withPlotinaContactNames(personalNames)?.toImmutableList())
+    }
+}
+
+/**
+ * [ProfileDetails] of [userId] with the account's personal name on top.
+ *
+ * `displayNameAmbiguous` is recomputed: a contact the user named is only marked when the room shows
+ * that name for more than one person.
+ */
+fun ProfileDetails.withPlotinaContactName(personalNames: PlotinaPersonalNames, userId: UserId?): ProfileDetails {
+    if (this !is ProfileDetails.Ready) return this
+    val name = personalNames.nameFor(userId) ?: return this
+    return copy(displayName = name, displayNameAmbiguous = personalNames.isShared(name))
+}
+
+/** [MatrixUser] with the account's personal name for that person on top. */
+fun MatrixUser.withPlotinaContactName(personalNames: PlotinaPersonalNames): MatrixUser {
+    val name = personalNames.nameFor(userId) ?: return this
+    return copy(displayName = name)
+}
+
+/** [InReplyTo] with the personal name of the quoted author. */
+fun InReplyTo.withPlotinaContactNames(personalNames: PlotinaPersonalNames): InReplyTo {
+    if (this !is InReplyTo.Ready) return this
+    return copy(senderProfile = senderProfile.withPlotinaContactName(personalNames, senderId))
+}
+
+/** [EventThreadInfo] with the personal name of the author of the last reply. */
+fun EventThreadInfo.withPlotinaContactNames(personalNames: PlotinaPersonalNames): EventThreadInfo {
+    if (this !is EventThreadInfo.ThreadRoot) return this
+    val summary: ThreadSummary = summary
+    return copy(summary = summary.copy(latestEvent = summary.latestEvent.map { it.withPlotinaContactNames(personalNames) }))
+}
+
+/** [EmbeddedEventInfo] with the personal name of its author. */
+fun EmbeddedEventInfo.withPlotinaContactNames(personalNames: PlotinaPersonalNames): EmbeddedEventInfo {
+    return copy(senderProfile = senderProfile.withPlotinaContactName(personalNames, senderId))
+}
+
+/**
+ * [EventContent] with the personal names of the people it mentions: the subject of a membership
+ * change ("X invited Y") and the author of a quote or of the last reply of a thread.
+ */
+fun EventContent.withPlotinaContactNames(personalNames: PlotinaPersonalNames): EventContent {
+    if (personalNames.names.isEmpty()) return this
+    return when (this) {
+        is MessageContent -> copy(
+            inReplyTo = inReplyTo?.withPlotinaContactNames(personalNames),
+            threadInfo = threadInfo?.withPlotinaContactNames(personalNames),
+        )
+        is RoomMembershipContent -> {
+            val name = personalNames.nameFor(userId) ?: return this
+            copy(userDisplayName = name)
+        }
+        else -> this
+    }
+}
+
+/** [EventTimelineItem] with the personal names of its author, forwarder and quoted people. */
+fun EventTimelineItem.withPlotinaContactNames(personalNames: PlotinaPersonalNames): EventTimelineItem {
+    if (personalNames.names.isEmpty()) return this
+    return copy(
+        senderProfile = senderProfile.withPlotinaContactName(personalNames, sender),
+        forwarderProfile = forwarderProfile?.withPlotinaContactName(personalNames, forwarder),
+        content = content.withPlotinaContactNames(personalNames),
+    )
+}
+
+/** [MatrixTimelineItem] with the personal names applied to the events it carries. */
+fun MatrixTimelineItem.withPlotinaContactNames(personalNames: PlotinaPersonalNames): MatrixTimelineItem {
+    if (this !is MatrixTimelineItem.Event) return this
+    return copy(event = event.withPlotinaContactNames(personalNames))
+}
+
+/** [LatestEventValue] with the personal name of its author, or of the member who invited us. */
+fun LatestEventValue.withPlotinaContactNames(personalNames: PlotinaPersonalNames): LatestEventValue {
+    if (personalNames.names.isEmpty()) return this
+    return when (this) {
+        is LatestEventValue.Local -> copy(
+            senderProfile = senderProfile.withPlotinaContactName(personalNames, senderId),
+            content = content.withPlotinaContactNames(personalNames),
+        )
+        is LatestEventValue.Remote -> copy(
+            senderProfile = senderProfile.withPlotinaContactName(personalNames, senderId),
+            content = content.withPlotinaContactNames(personalNames),
+        )
+        is LatestEventValue.RoomInvite -> copy(invitedProfile = invitedProfile.withPlotinaContactName(personalNames, inviterId))
+        is LatestEventValue.None -> this
+    }
+}
