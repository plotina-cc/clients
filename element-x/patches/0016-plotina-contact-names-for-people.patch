+import org.junit.Test
+
+/**
+ * Plotina: the account's personal names of its contacts (`cc.plotina.contact_names`, keyed by mxid)
+ * must reach the people of a **group** room - here the member list that the member screen, the
+ * mention cache and the receipts are all built from - and must follow a rename without the room being
+ * reopened.
+ */
+class RustBaseRoomPersonalNamesTest {
+    @Test
+    fun `a member of a group is shown under the account's personal name`() = runTest {
+        val rustBaseRoom = createRustBaseRoom(
+            contactNameStore = FakeContactNameStore(mapOf(A_USER_ID_2 to "Денчик")),
+        )
+
+        rustBaseRoom.updateMembers()
+
+        assertThat(rustBaseRoom.membersStateFlow.value.displayNameOf(A_USER_ID_2)).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `a group keeps every member it has no personal name for`() = runTest {
+        val rustBaseRoom = createRustBaseRoom(
+            contactNameStore = FakeContactNameStore(mapOf(A_USER_ID_2 to "Денчик")),
+        )
+
+        rustBaseRoom.updateMembers()
+
+        assertThat(rustBaseRoom.membersStateFlow.value.displayNameOf(A_USER_ID)).isEqualTo("Алиса")
+    }
+
+    @Test
+    fun `a name change reaches an open member list without a re-fetch`() = runTest {
+        val contactNameStore = FakeContactNameStore(mapOf(A_USER_ID_2 to "Денчик"))
+        val rustBaseRoom = createRustBaseRoom(contactNameStore = contactNameStore)
+        rustBaseRoom.updateMembers()
+
+        rustBaseRoom.membersStateFlow.test {
+            assertThat(awaitItem().displayNameOf(A_USER_ID_2)).isEqualTo("Денчик")
+
+            // As if the user renamed the contact, here or from another client of the account.
+            contactNameStore.givenNames(mapOf(A_USER_ID_2 to "Денчик-новый"))
+
+            assertThat(awaitItem().displayNameOf(A_USER_ID_2)).isEqualTo("Денчик-новый")
+        }
+    }
+
+    @Test
+    fun `the room info names its heroes with the account's personal names`() = runTest {
+        val rustBaseRoom = createRustBaseRoom(
+            initialRoomInfo = aRoomInfo(
+                name = "QA Группа",
+                rawName = "QA Группа",
+                isDm = false,
+                activeMembersCount = 3,
+                heroes = listOf(MatrixUser(A_USER_ID_2, displayName = "Даниил")),
+            ),
+            contactNameStore = FakeContactNameStore(mapOf(A_USER_ID_2 to "Денчик")),
+        )
+
+        val roomInfo = rustBaseRoom.roomInfoFlow.value
+
+        // Requirement A: a group keeps its own name, whatever names its members have.
+        assertThat(roomInfo.name).isEqualTo("QA Группа")
+        assertThat(roomInfo.heroes.single().displayName).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `the display name of a member follows the account's personal name`() = runTest {
+        val rustBaseRoom = createRustBaseRoom(
+            contactNameStore = FakeContactNameStore(mapOf(A_USER_ID_2 to "Денчик")),
+        )
+
+        assertThat(rustBaseRoom.userDisplayName(A_USER_ID_2).getOrThrow()).isEqualTo("Денчик")
+    }
+
+    private fun RoomMembersState.displayNameOf(userId: UserId): String? {
+        return roomMembers().orEmpty().first { it.userId == userId }.displayName
+    }
+
+    private fun TestScope.createRustBaseRoom(
+        initialRoomInfo: RoomInfo = aRoomInfo(),
+        contactNameStore: ContactNameStore = FakeContactNameStore(),
+    ): RustBaseRoom {
+        val dispatchers = testCoroutineDispatchers()
+        return RustBaseRoom(
+            sessionId = A_SESSION_ID,
+            deviceId = A_DEVICE_ID,
+            innerRoom = FakeFfiRoom(
+                getMembers = { FakeFfiRoomMembersIterator(aGroupMembers()) },
+                getMembersNoSync = { FakeFfiRoomMembersIterator(aGroupMembers()) },
+            ),
+            coroutineDispatchers = dispatchers,
+            roomSyncSubscriber = RoomSyncSubscriber(
+                roomListService = FakeFfiRoomListService(),
+                dispatchers = dispatchers,
+            ),
+            roomMembershipObserver = RoomMembershipObserver(),
+            contactNameStore = contactNameStore,
+            sessionCoroutineScope = backgroundScope,
+            roomInfoMapper = RoomInfoMapper(),
+            initialRoomInfo = initialRoomInfo,
+        )
+    }
+
+    /** A three-member group: the account itself and two other people, one of them named by the account. */
+    private fun aGroupMembers() = listOf(
+        aRustRoomMember(A_USER_ID, displayName = "Алиса"),
+        aRustRoomMember(A_USER_ID_2, displayName = "Даниил"),
+    )
+}
