+        assertThat((shown as RoomMembersState.Ready).roomMembers.single().displayName).isEqualTo("Денчик")
+        assertThat((RoomMembersState.Unknown).withPlotinaContactNames(PlotinaPersonalNames(mapOf(bob to "Денчик"))))
+            .isEqualTo(RoomMembersState.Unknown)
+    }
+
+    @Test
+    fun `a sender profile is renamed and keeps the sdk flag when the person has no name`() {
+        val names = PlotinaPersonalNames(mapOf(bob to "Денчик"))
+
