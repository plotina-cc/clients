+package io.element.android.libraries.matrix.impl.room.alias
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.core.coroutine.CoroutineDispatchers
+import io.element.android.libraries.matrix.api.core.UserId
+import io.element.android.libraries.matrix.api.room.alias.PLOTINA_CONTACT_NAMES_EVENT_TYPE
+import io.element.android.libraries.matrix.api.room.alias.PlotinaContactNames
+import io.element.android.libraries.matrix.api.sync.SyncService
+import io.element.android.libraries.matrix.impl.fixtures.fakes.FakeFfiClient
+import io.element.android.libraries.matrix.test.A_ROOM_ID
+import io.element.android.libraries.matrix.test.A_USER_ID
+import io.element.android.libraries.matrix.test.A_USER_ID_2
+import io.element.android.libraries.matrix.test.sync.FakeSyncService
+import io.element.android.tests.testutils.testCoroutineDispatchers
+import kotlinx.coroutines.test.TestScope
+import kotlinx.coroutines.test.runTest
+import org.junit.Test
+import org.matrix.rustcomponents.sdk.Client
+
+class RustContactNameStoreTest {
+    @Test
+    fun `setting a name writes the account data event and nothing else`() = runTest {
+        val accountData = mutableMapOf<String, String>()
+        val setAccountDataCalls = mutableListOf<Pair<String, String>>()
+        val store = aRustContactNameStore(
+            client = FakeFfiClient(
+                accountDataResult = { accountData[it] },
+                setAccountDataResult = { type, content ->
+                    setAccountDataCalls.add(type to content)
+                    accountData[type] = content
+                },
+            ),
+        )
+
+        val result = store.setName(A_USER_ID_2, "Денчик")
+
+        assertThat(result.isSuccess).isTrue()
+        // The only write is the account data event: no room state event, no m.room.name.
+        assertThat(setAccountDataCalls.map { it.first }).containsExactly(PLOTINA_CONTACT_NAMES_EVENT_TYPE)
+        assertThat(setAccountDataCalls.single().second).isEqualTo("""{"@bob:server.org":"Денчик"}""")
+        assertThat(store.names.value).containsExactly(A_USER_ID_2, "Денчик")
+        assertThat(store.nameFor(A_USER_ID_2)).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `a name is trimmed before it is written`() = runTest {
+        val accountData = mutableMapOf<String, String>()
+        val store = aRustContactNameStore(client = anAccountDataClient(accountData))
+
+        store.setName(A_USER_ID_2, "  Денчик  ").getOrThrow()
+
+        assertThat(accountData[PLOTINA_CONTACT_NAMES_EVENT_TYPE]).isEqualTo("""{"@bob:server.org":"Денчик"}""")
+    }
+
+    @Test
+    fun `resetting a name removes its key and leaves no empty value`() = runTest {
+        val accountData = mutableMapOf(PLOTINA_CONTACT_NAMES_EVENT_TYPE to """{"@bob:server.org":"Денчик"}""")
+        val store = aRustContactNameStore(client = anAccountDataClient(accountData))
+        store.refresh().getOrThrow()
+
+        store.setName(A_USER_ID_2, null).getOrThrow()
+
+        assertThat(accountData[PLOTINA_CONTACT_NAMES_EVENT_TYPE]).isEqualTo("{}")
+        assertThat(store.names.value).isEmpty()
+        assertThat(store.nameFor(A_USER_ID_2)).isNull()
+    }
+
+    @Test
+    fun `resetting a blank name is a reset too`() = runTest {
+        val accountData = mutableMapOf(PLOTINA_CONTACT_NAMES_EVENT_TYPE to """{"@bob:server.org":"Денчик"}""")
+        val store = aRustContactNameStore(client = anAccountDataClient(accountData))
+        store.refresh().getOrThrow()
+
+        store.setName(A_USER_ID_2, "   ").getOrThrow()
+
+        assertThat(accountData[PLOTINA_CONTACT_NAMES_EVENT_TYPE]).isEqualTo("{}")
+        assertThat(store.names.value).isEmpty()
+    }
+
+    @Test
+    fun `writing one name keeps the other names of the account`() = runTest {
+        val accountData = mutableMapOf(PLOTINA_CONTACT_NAMES_EVENT_TYPE to """{"@alice:server.org":"Мама"}""")
+        val store = aRustContactNameStore(client = anAccountDataClient(accountData))
+
+        store.setName(A_USER_ID_2, "Денчик").getOrThrow()
+
+        assertThat(PlotinaContactNames.parse(accountData[PLOTINA_CONTACT_NAMES_EVENT_TYPE]))
+            .containsExactly(A_USER_ID, "Мама", A_USER_ID_2, "Денчик")
+        assertThat(store.names.value).containsExactly(A_USER_ID, "Мама", A_USER_ID_2, "Денчик")
+    }
+
+    @Test
+    fun `a name set from another client of the same account is read on refresh`() = runTest {
+        // This is the cross-client case: the other client writes the contract's event keyed by mxid.
+        val accountData = mutableMapOf(PLOTINA_CONTACT_NAMES_EVENT_TYPE to """{"@bob:server.org":"Денчик"}""")
+        val store = aRustContactNameStore(client = anAccountDataClient(accountData))
+
+        store.refresh().getOrThrow()
+
+        assertThat(store.nameFor(A_USER_ID_2)).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `the old room keyed event is not read`() = runTest {
+        // cc.plotina.room_aliases stays in account data forever (an event type cannot be deleted), and
+        // it is deliberately not migrated: its room-id keys are junk for the contact model.
+        val accountData = mutableMapOf("cc.plotina.room_aliases" to """{"!aRoomId:domain":"Денчик"}""")
+        val store = aRustContactNameStore(client = anAccountDataClient(accountData))
+
+        val result = store.refresh()
+
+        assertThat(result.isSuccess).isTrue()
+        assertThat(store.names.value).isEmpty()
+    }
+
+    @Test
+    fun `reading broken json does not fail and leaves no name behind`() = runTest {
+        val accountData = mutableMapOf(PLOTINA_CONTACT_NAMES_EVENT_TYPE to "{ this is not json")
+        val store = aRustContactNameStore(client = anAccountDataClient(accountData))
+
+        val result = store.refresh()
+
+        assertThat(result.isSuccess).isTrue()
+        assertThat(store.names.value).isEmpty()
+    }
+
+    @Test
+    fun `reading broken m direct content does not fail`() = runTest {
+        val accountData = mutableMapOf(
+            PLOTINA_CONTACT_NAMES_EVENT_TYPE to """{"@bob:server.org":"Денчик"}""",
+            "m.direct" to "{ this is not json",
+        )
+        val store = aRustContactNameStore(client = anAccountDataClient(accountData))
+
+        val result = store.refresh()
+
+        assertThat(result.isSuccess).isTrue()
+        assertThat(store.names.value).containsExactly(A_USER_ID_2, "Денчик")
+        assertThat(store.directRooms.value).isEmpty()
+    }
+
+    @Test
+    fun `the account's m direct map is read so a direct room resolves to its contact`() = runTest {
+        val accountData = mutableMapOf(
+            PLOTINA_CONTACT_NAMES_EVENT_TYPE to """{"@bob:server.org":"Денчик"}""",
+            "m.direct" to """{"@bob:server.org":["!aRoomId:domain"]}""",
+        )
+        val store = aRustContactNameStore(client = anAccountDataClient(accountData))
+
+        store.refresh().getOrThrow()
+
+        assertThat(store.directRooms.value).containsExactly(A_ROOM_ID, A_USER_ID_2)
+    }
+
+    @Test
+    fun `a failed write leaves the published names untouched`() = runTest {
+        val store = aRustContactNameStore(
+            client = FakeFfiClient(
+                accountDataResult = { """{"@bob:server.org":"Денчик"}""" },
+                setAccountDataResult = { _, _ -> error("the server said no") },
+            ),
+        )
+        store.refresh().getOrThrow()
+
+        val result = store.setName(A_USER_ID, "Мама")
+
+        assertThat(result.isFailure).isTrue()
+        assertThat(store.names.value).containsExactly(A_USER_ID_2, "Денчик")
+    }
+
+    @Test
+    fun `a failed read keeps the names already published`() = runTest {
+        var shouldFail = false
+        val store = aRustContactNameStore(
+            client = FakeFfiClient(
+                accountDataResult = {
+                    if (shouldFail) error("the store is locked") else """{"@bob:server.org":"Денчик"}"""
+                },
+            ),
+        )
+        store.refresh().getOrThrow()
+
+        shouldFail = true
+        val result = store.refresh()
+
+        assertThat(result.isFailure).isTrue()
+        assertThat(store.names.value).containsExactly(A_USER_ID_2, "Денчик")
+    }
+
+    private fun anAccountDataClient(accountData: MutableMap<String, String>) = FakeFfiClient(
+        accountDataResult = { accountData[it] },
+        setAccountDataResult = { type, content -> accountData[type] = content },
+    )
+
+    private fun TestScope.aRustContactNameStore(
+        client: Client = FakeFfiClient(),
+        syncService: SyncService = FakeSyncService(),
+        dispatchers: CoroutineDispatchers = testCoroutineDispatchers(),
+    ) = RustContactNameStore(
+        client = client,
+        syncService = syncService,
+        sessionCoroutineScope = backgroundScope,
+        dispatchers = dispatchers,
+    )
+}
