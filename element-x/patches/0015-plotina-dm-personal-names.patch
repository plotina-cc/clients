+package io.element.android.libraries.matrix.test.room.alias
+
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.core.UserId
+import io.element.android.libraries.matrix.api.room.alias.ContactNameStore
+import io.element.android.libraries.matrix.api.room.alias.PlotinaContactNames
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+
+class FakeContactNameStore(
+    initialNames: Map<UserId, String> = emptyMap(),
+    initialDirectRooms: Map<RoomId, UserId> = emptyMap(),
+    var setNameResult: Result<Unit> = Result.success(Unit),
+    var refreshResult: Result<Unit> = Result.success(Unit),
+) : ContactNameStore {
+    private val namesState = MutableStateFlow(initialNames)
+    override val names: StateFlow<Map<UserId, String>> = namesState.asStateFlow()
+
+    private val directRoomsState = MutableStateFlow(initialDirectRooms)
+    override val directRooms: StateFlow<Map<RoomId, UserId>> = directRoomsState.asStateFlow()
+
+    /** The writes this fake received, as (userId, name) pairs, name null for a reset. */
+    val setNameCalls = mutableListOf<Pair<UserId, String?>>()
+
+    override fun nameFor(userId: UserId): String? = namesState.value[userId]
+
+    override suspend fun refresh(): Result<Unit> = refreshResult
+
+    override suspend fun setName(userId: UserId, name: String?): Result<Unit> {
+        setNameCalls.add(userId to name)
+        setNameResult.onSuccess {
+            namesState.update { current ->
+                val trimmed = name?.trim()
+                if (trimmed.isNullOrEmpty()) current - userId else current + (userId to trimmed)
+            }
+        }
+        return setNameResult
+    }
+
+    /** Replaces the published names, as if the account data had been changed elsewhere. */
+    fun givenNames(names: Map<UserId, String>) {
+        namesState.value = names
+    }
+
+    /** Replaces the published `m.direct` map, as if a dialogue had been created elsewhere. */
+    fun givenDirectRooms(rooms: Map<RoomId, UserId>) {
+        directRoomsState.value = rooms
+    }
+
+    /** The account data content this fake would have written, for assertions on the payload shape. */
+    fun content(): String = PlotinaContactNames.serialize(namesState.value)
+}
