+package io.element.android.libraries.matrix.api.room.alias
+
+import io.element.android.libraries.matrix.api.core.MatrixPatterns
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.core.UserId
+import io.element.android.libraries.matrix.api.room.RoomInfo
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+/**
+ * The account data type holding the user's personal names for contacts.
+ *
+ * Plotina: a personal name is a label the account owner gives to a person. It lives in this account
+ * data event as `{"<mxid>": "<name>"}`, so only that account sees it: nothing is ever written to
+ * `m.room.member`, `m.room.name` or the other side's profile. The key is the contact, not the room,
+ * which is what makes one name cover every conversation with that person - a second dialogue with
+ * the same person shows the same name without a second write, and a newly created one shows it at
+ * once.
+ *
+ * The contract is shared with the other Plotina clients (Mobile and Web/Desktop write and read the
+ * same event), so the parsing here is deliberately forgiving: anything that is not a JSON object of
+ * mxid to non-blank string is ignored instead of failing, which keeps a broken or foreign payload
+ * from breaking the room list. The previous, room-keyed event `cc.plotina.room_aliases` is not read
+ * and not migrated: its keys are not mxids, so it falls out as junk like any other foreign content.
+ */
+const val PLOTINA_CONTACT_NAMES_EVENT_TYPE = "cc.plotina.contact_names"
+
+object PlotinaContactNames {
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /**
+     * The personal names in an account data [content] payload, keyed by the contact's matrix id.
+     *
+     * Never throws: blank, malformed or non-object content yields an empty map, and entries whose key
+     * is not an mxid or whose value is not a non-blank string are dropped.
+     */
+    fun parse(content: String?): Map<UserId, String> {
+        if (content.isNullOrBlank()) return emptyMap()
+        val root = runCatching { json.parseToJsonElement(content) }.getOrNull() as? JsonObject ?: return emptyMap()
+        val names = LinkedHashMap<UserId, String>(root.size)
+        root.forEach { (key, value) ->
+            // Only keys that a UserId accepts end up here: UserId validates itself in debug builds,
+            // so a foreign key (a room id from the old model, say) must be filtered before it is wrapped.
+            if (!MatrixPatterns.isUserId(key)) return@forEach
+            val name = (value as? JsonPrimitive)?.takeIf { it.isString }?.content?.trim()
+            if (name.isNullOrEmpty()) return@forEach
+            names[UserId(key)] = name
+        }
+        return names
+    }
+
+    /**
+     * The account data content for [names], as a compact JSON object with sorted keys.
+     *
+     * Blank names are dropped, so the payload never carries an empty value: a reset removes the key,
+     * and resetting the last name writes `{}`. Sorted keys keep the written content stable: saving the
+     * same map twice writes the same bytes.
+     */
+    fun serialize(names: Map<UserId, String>): String = buildJsonObject {
+        names.entries
+            .mapNotNull { (userId, name) -> name.trim().takeIf { it.isNotEmpty() }?.let { userId.value to it } }
+            .sortedBy { (userId, _) -> userId }
+            .forEach { (userId, name) -> put(userId, name) }
+    }.toString()
+
+    /**
+     * The contact this room is a personal dialogue with, or null when the room is not one.
+     *
+     * A personal dialogue is either what the SDK flags as direct (`m.direct`) or the two-member room
+     * the app already presents as a DM. The SDK hands us the counterpart as the single hero of a DM;
+     * for a room that is only flagged direct (an `m.direct` entry with more members) there is no hero,
+     * so the account's own `m.direct` map answers instead.
+     */
+    fun counterpart(roomInfo: RoomInfo, directRooms: Map<RoomId, UserId> = emptyMap()): UserId? {
+        if (!roomInfo.isDirect && !roomInfo.isDm) return null
+        return roomInfo.heroes.firstOrNull()?.userId ?: directRooms[roomInfo.id]
+    }
+
+    /**
+     * The personal name to show for [roomInfo], or null to keep the room's own name.
+     *
+     * A name is only applied to a personal dialogue: a name left over for a group must never mask the
+     * group's real name. An explicit `m.room.name` keeps the title, exactly as the Mobile client does
+     * (`getLocalizedDisplayname` returns the room's name before the heroes): a personal name renames a
+     * person, not a room.
+     */
+    fun nameFor(
+        names: Map<UserId, String>,
+        roomInfo: RoomInfo,
+        directRooms: Map<RoomId, UserId> = emptyMap(),
+    ): String? {
+        if (!roomInfo.rawName.isNullOrBlank()) return null
+        val contact = counterpart(roomInfo, directRooms) ?: return null
+        return names[contact]
+    }
+}
+
+/**
+ * The `m.direct` account data event, read backwards: room id to the account it names as the contact.
+ *
+ * `m.direct` is written by every client as `{"<mxid>": ["<room id>", ...]}`, so inverting it is the
+ * only way to know who a direct room is with when the room has more members than the two the app
+ * treats as a DM. Parsing is as forgiving as the names: anything that is not an array of room ids
+ * under an mxid is skipped.
+ */
+object PlotinaDirectRooms {
+    private val json = Json { ignoreUnknownKeys = true }
+
+    fun parse(content: String?): Map<RoomId, UserId> {
+        if (content.isNullOrBlank()) return emptyMap()
+        val root = runCatching { json.parseToJsonElement(content) }.getOrNull() as? JsonObject ?: return emptyMap()
+        val rooms = LinkedHashMap<RoomId, UserId>()
+        root.forEach { (key, value) ->
+            if (!MatrixPatterns.isUserId(key)) return@forEach
+            val roomIds = value as? JsonArray ?: return@forEach
+            val userId = UserId(key)
+            roomIds.forEach { roomId ->
+                val id = (roomId as? JsonPrimitive)?.takeIf { it.isString }?.content
+                if (id == null || !MatrixPatterns.isRoomId(id)) return@forEach
+                // A room may appear under more than one account only if the payload is broken; the
+                // first entry wins, so the answer does not depend on the order of the object.
+                rooms.putIfAbsent(RoomId(id), userId)
+            }
+        }
+        return rooms
+    }
+}
+
+/**
+ * The [RoomInfo] to display: the room's own name, with the account's personal name for the contact on
+ * top when the room is a personal dialogue and that contact has one.
+ *
+ * Only [RoomInfo.name] is replaced - the one field the app renders. [RoomInfo.rawName], which mirrors
+ * the `m.room.name` state event, and everything else stay as the SDK reported them, so nothing here
+ * can travel back to the room's state or to the other side.
+ */
+fun RoomInfo.withPlotinaContactName(
+    names: Map<UserId, String>,
+    directRooms: Map<RoomId, UserId> = emptyMap(),
+): RoomInfo {
+    val name = PlotinaContactNames.nameFor(names, this, directRooms) ?: return this
+    return copy(name = name)
+}
