+import org.junit.Test
+import org.matrix.rustcomponents.sdk.Client
+
+class RustRoomAliasStoreTest {
+    @Test
+    fun `setting a name writes the account data event and nothing else`() = runTest {
+        val accountData = mutableMapOf<String, String>()
+        val setAccountDataCalls = mutableListOf<Pair<String, String>>()
+        val store = aRustRoomAliasStore(
+            client = FakeFfiClient(
+                accountDataResult = { accountData[it] },
+                setAccountDataResult = { type, content ->
+                    setAccountDataCalls.add(type to content)
+                    accountData[type] = content
+                },
+            ),
+        )
+
+        val result = store.setAlias(A_ROOM_ID, "Денчик")
+
+        assertThat(result.isSuccess).isTrue()
+        // The only write is the account data event: no room state event, no m.room.name.
+        assertThat(setAccountDataCalls.map { it.first }).containsExactly(PLOTINA_ROOM_ALIASES_EVENT_TYPE)
+        assertThat(setAccountDataCalls.single().second).isEqualTo("""{"!aRoomId:domain":"Денчик"}""")
+        assertThat(store.aliases.value).containsExactly(A_ROOM_ID, "Денчик")
+        assertThat(store.nameFor(A_ROOM_ID)).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `a name is trimmed before it is written`() = runTest {
+        val accountData = mutableMapOf<String, String>()
+        val store = aRustRoomAliasStore(client = anAccountDataClient(accountData))
+
+        store.setAlias(A_ROOM_ID, "  Денчик  ").getOrThrow()
+
+        assertThat(accountData[PLOTINA_ROOM_ALIASES_EVENT_TYPE]).isEqualTo("""{"!aRoomId:domain":"Денчик"}""")
+    }
+
+    @Test
+    fun `resetting a name removes its key and leaves no empty value`() = runTest {
+        val accountData = mutableMapOf(PLOTINA_ROOM_ALIASES_EVENT_TYPE to """{"!aRoomId:domain":"Денчик"}""")
+        val store = aRustRoomAliasStore(client = anAccountDataClient(accountData))
+        store.refresh().getOrThrow()
+
+        store.setAlias(A_ROOM_ID, null).getOrThrow()
+
+        assertThat(accountData[PLOTINA_ROOM_ALIASES_EVENT_TYPE]).isEqualTo("{}")
+        assertThat(store.aliases.value).isEmpty()
+        assertThat(store.nameFor(A_ROOM_ID)).isNull()
+    }
+
+    @Test
+    fun `resetting a blank name is a reset too`() = runTest {
+        val accountData = mutableMapOf(PLOTINA_ROOM_ALIASES_EVENT_TYPE to """{"!aRoomId:domain":"Денчик"}""")
+        val store = aRustRoomAliasStore(client = anAccountDataClient(accountData))
+        store.refresh().getOrThrow()
+
+        store.setAlias(A_ROOM_ID, "   ").getOrThrow()
+
+        assertThat(accountData[PLOTINA_ROOM_ALIASES_EVENT_TYPE]).isEqualTo("{}")
+        assertThat(store.aliases.value).isEmpty()
+    }
+
+    @Test
+    fun `writing one name keeps the other names of the account`() = runTest {
+        val accountData = mutableMapOf(PLOTINA_ROOM_ALIASES_EVENT_TYPE to """{"!aRoomId:domain":"Денчик"}""")
+        val store = aRustRoomAliasStore(client = anAccountDataClient(accountData))
+
+        store.setAlias(A_ROOM_ID_2, "Мама").getOrThrow()
+
+        assertThat(PlotinaRoomAliases.parse(accountData[PLOTINA_ROOM_ALIASES_EVENT_TYPE]))
+            .containsExactly(A_ROOM_ID, "Денчик", A_ROOM_ID_2, "Мама")
+        assertThat(store.aliases.value).containsExactly(A_ROOM_ID, "Денчик", A_ROOM_ID_2, "Мама")
+    }
+
+    @Test
+    fun `reading broken json does not fail and leaves no name behind`() = runTest {
+        val accountData = mutableMapOf(PLOTINA_ROOM_ALIASES_EVENT_TYPE to "{ this is not json")
+        val store = aRustRoomAliasStore(client = anAccountDataClient(accountData))
+
+        val result = store.refresh()
+
+        assertThat(result.isSuccess).isTrue()
+        assertThat(store.aliases.value).isEmpty()
+    }
+
+    @Test
+    fun `a failed write leaves the published names untouched`() = runTest {
+        val store = aRustRoomAliasStore(
+            client = FakeFfiClient(
+                accountDataResult = { """{"!aRoomId:domain":"Денчик"}""" },
+                setAccountDataResult = { _, _ -> error("the server said no") },
+            ),
+        )
+        store.refresh().getOrThrow()
+
+        val result = store.setAlias(A_ROOM_ID_2, "Мама")
+
+        assertThat(result.isFailure).isTrue()
+        assertThat(store.aliases.value).containsExactly(A_ROOM_ID, "Денчик")
+    }
+
+    @Test
+    fun `a failed read keeps the names already published`() = runTest {
+        var shouldFail = false
+        val store = aRustRoomAliasStore(
+            client = FakeFfiClient(
+                accountDataResult = {
+                    if (shouldFail) error("the store is locked") else """{"!aRoomId:domain":"Денчик"}"""
+                },
+            ),
+        )
+        store.refresh().getOrThrow()
+
+        shouldFail = true
+        val result = store.refresh()
+
+        assertThat(result.isFailure).isTrue()
+        assertThat(store.aliases.value).containsExactly(A_ROOM_ID, "Денчик")
+    }
+
+    private fun anAccountDataClient(accountData: MutableMap<String, String>) = FakeFfiClient(
+        accountDataResult = { accountData[it] },
+        setAccountDataResult = { type, content -> accountData[type] = content },
+    )
+
+    private fun TestScope.aRustRoomAliasStore(
+        client: Client = FakeFfiClient(),
+        syncService: SyncService = FakeSyncService(),
+        dispatchers: CoroutineDispatchers = testCoroutineDispatchers(),
+    ) = RustRoomAliasStore(
+        client = client,
+        syncService = syncService,
+        sessionCoroutineScope = backgroundScope,
+        dispatchers = dispatchers,
+    )
+}
