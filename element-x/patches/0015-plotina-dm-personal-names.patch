+import io.element.android.libraries.designsystem.theme.components.Text
+import io.element.android.libraries.designsystem.theme.components.TextButton
+import io.element.android.libraries.designsystem.theme.components.TextField
+import io.element.android.libraries.ui.strings.CommonStrings
+
+/**
+ * Plotina: the dialog behind "Personal name" in the room details screen of a personal dialogue.
+ *
+ * The name typed here is saved in the account's own account data (see `ContactNameStore`), under
+ * the contact's matrix id, so it changes nothing for the other side and applies to every dialogue
+ * with that person: [onSave] with a blank field or [onReset] both mean "forget my name for this
+ * contact".
+ */
+@Composable
+internal fun PlotinaPersonalNameDialog(
+    currentName: String?,
+    onDismiss: () -> Unit,
+    onSave: (String) -> Unit,
+    onReset: () -> Unit,
+) {
+    var name by remember { mutableStateOf(currentName.orEmpty()) }
+    BasicAlertDialog(onDismissRequest = onDismiss) {
+        Surface(
+            shape = RoundedCornerShape(12.dp),
+            color = ElementTheme.colors.bgCanvasDefault,
+        ) {
+            Column(
+                modifier = Modifier
+                    .sizeIn(minWidth = 280.dp, maxWidth = 560.dp)
+                    .padding(24.dp),
+                verticalArrangement = Arrangement.spacedBy(16.dp),
+            ) {
+                Text(
+                    text = stringResource(R.string.screen_room_details_plotina_personal_name_title),
+                    style = ElementTheme.typography.fontHeadingSmMedium,
+                )
+                Text(
+                    text = stringResource(R.string.screen_room_details_plotina_personal_name_hint),
+                    style = ElementTheme.typography.fontBodyMdRegular,
+                    color = ElementTheme.colors.textSecondary,
+                )
+                TextField(
+                    value = name,
+                    onValueChange = { name = it },
+                    singleLine = true,
+                )
+                Row(
+                    modifier = Modifier.align(Alignment.End),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    TextButton(
+                        text = stringResource(CommonStrings.action_cancel),
+                        onClick = onDismiss,
+                    )
+                    if (!currentName.isNullOrEmpty()) {
+                        TextButton(
+                            text = stringResource(R.string.screen_room_details_plotina_personal_name_reset),
+                            onClick = onReset,
+                        )
+                    }
+                    TextButton(
+                        text = stringResource(CommonStrings.action_save),
+                        onClick = { onSave(name) },
+                    )
+                }
+            }
+        }
+    }
+}
