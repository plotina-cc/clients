+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.debounce
+import kotlinx.coroutines.flow.drop
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.merge
+import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import org.matrix.rustcomponents.sdk.Client
+import timber.log.Timber
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Plotina: [RoomAliasStore] on top of the account data API of the Rust SDK.
+ *
+ * The event is read once at start and then re-read after every sync round trip, so a name set from
+ * another client of the same account shows up here as soon as that client's account data has been
+ * synced. Writing goes through `setAccountData` only: the room's own state is never touched, which is
+ * what makes the name private to this account.
+ */
+class RustRoomAliasStore(
+    private val client: Client,
+    private val syncService: SyncService,
+    sessionCoroutineScope: CoroutineScope,
+    dispatchers: CoroutineDispatchers,
+) : RoomAliasStore {
+    private val dispatcher = dispatchers.io.limitedParallelism(2)
+    private val storeScope = sessionCoroutineScope.childScope(dispatchers.main, "RoomAliasStore")
+
+    // The reads and the read-modify-write of setAlias() must not interleave: a refresh landing in the
+    // middle of a save would otherwise publish the map from before the save.
+    private val mutex = Mutex()
+
+    private val _aliases = MutableStateFlow<Map<RoomId, String>>(emptyMap())
+    override val aliases: StateFlow<Map<RoomId, String>> = _aliases.asStateFlow()
+
+    init {
+        storeScope.launch { observeSync() }
+    }
+
+    override fun nameFor(roomId: RoomId): String? = _aliases.value[roomId]
+
+    override suspend fun refresh(): Result<Unit> = withContext(dispatcher) {
+        runCatchingExceptions {
+            // Read and publish under the same lock as setAlias(): a read that started before a write
+            // must not publish its stale map after it.
+            mutex.withLock {
+                _aliases.value = PlotinaRoomAliases.parse(client.accountData(PLOTINA_ROOM_ALIASES_EVENT_TYPE))
+            }
+        }.onFailure {
+            // A failure to read must not clear what is already displayed: keep the previous map.
+            Timber.e(it, "Plotina: could not read $PLOTINA_ROOM_ALIASES_EVENT_TYPE")
+        }
+    }
+
+    override suspend fun setAlias(roomId: RoomId, name: String?): Result<Unit> = withContext(dispatcher) {
+        mutex.withLock {
+            runCatchingExceptions {
+                // Build the new content from what the server has, not from the snapshot: another
+                // client of this account may have added a name we have not synced yet, and this
+                // write replaces the whole event.
+                val stored = PlotinaRoomAliases.parse(client.accountData(PLOTINA_ROOM_ALIASES_EVENT_TYPE))
+                val updated = stored.toMutableMap()
+                val trimmed = name?.trim()
+                if (trimmed.isNullOrEmpty()) {
+                    updated.remove(roomId)
+                } else {
+                    updated[roomId] = trimmed
+                }
+                client.setAccountData(PLOTINA_ROOM_ALIASES_EVENT_TYPE, PlotinaRoomAliases.serialize(updated))
+                _aliases.value = updated
+            }.onFailure {
+                Timber.e(it, "Plotina: could not write $PLOTINA_ROOM_ALIASES_EVENT_TYPE")
+            }
+        }
+    }
+
+    @OptIn(FlowPreview::class)
+    private fun observeSync() {
+        // The account data of a round trip is in the local store by the time the sync reports itself
+        // running again, so this is where names set from another client are picked up. The sync state
+        // is watched as well as the beat: a session that starts syncing before its first read leaves
+        // nothing else to notice the account data has arrived.
+        merge(syncService.syncState.drop(1), syncService.heartBeat)
+            .map { }
+            .debounce(1.seconds)
+            .onEach { refresh() }
+            .launchIn(storeScope)
+    }
+}
