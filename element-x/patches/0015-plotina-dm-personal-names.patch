@@ -0,0 +1,185 @@
+/*
+ * Copyright (c) 2026 Element Creations Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial.
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.matrix.api.room.alias
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.test.room.aRoomInfo
+import org.junit.Test
+
+class PlotinaRoomAliasesTest {
+    private val aRoomId = RoomId("!aRoomId:domain")
+    private val anotherRoomId = RoomId("!anotherRoomId:domain")
+
+    // region apply
+
+    @Test
+    fun `a personal name replaces the name of a dm`() {
+        val info = aRoomInfo(id = aRoomId, name = "Alice", isDm = true)
+
+        val result = info.withPlotinaAlias(mapOf(aRoomId to "Денчик"))
+
+        assertThat(result.name).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `a personal name replaces the name of a room the sdk flags as direct`() {
+        val info = aRoomInfo(id = aRoomId, name = "Alice", isDm = false, isDirect = true)
+
+        val result = info.withPlotinaAlias(mapOf(aRoomId to "Денчик"))
+
+        assertThat(result.name).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `a group keeps its own name even when it has a personal name`() {
+        val info = aRoomInfo(id = aRoomId, name = "Weekend plans", isDm = false, isDirect = false)
+
+        val result = info.withPlotinaAlias(mapOf(aRoomId to "Денчик"))
+
+        assertThat(result.name).isEqualTo("Weekend plans")
+    }
+
+    @Test
+    fun `a room without a personal name keeps its name`() {
+        val info = aRoomInfo(id = aRoomId, name = "Alice", isDm = true)
+
+        val result = info.withPlotinaAlias(mapOf(anotherRoomId to "Денчик"))
+
+        assertThat(result.name).isEqualTo("Alice")
+    }
+
+    @Test
+    fun `the name from the room state is never replaced`() {
+        val info = aRoomInfo(id = aRoomId, name = "Alice", rawName = "The real room name", isDm = true)
+
+        val result = info.withPlotinaAlias(mapOf(aRoomId to "Денчик"))
+
+        assertThat(result.rawName).isEqualTo("The real room name")
+    }
+
+    @Test
+    fun `nothing but the name changes`() {
+        val info = aRoomInfo(id = aRoomId, name = "Alice", isDm = true)
+
+        val result = info.withPlotinaAlias(mapOf(aRoomId to "Денчик"))
+
+        assertThat(result.copy(name = info.name)).isEqualTo(info)
+    }
+
+    @Test
+    fun `an empty alias map changes nothing`() {
+        val info = aRoomInfo(id = aRoomId, name = "Alice", isDm = true)
+
+        assertThat(info.withPlotinaAlias(emptyMap())).isSameInstanceAs(info)
+    }
+
+    // endregion
+
+    // region parse
+
+    @Test
+    fun `a payload is read as a room id to name map`() {
+        val content = """{"!aRoomId:domain":"Денчик","!anotherRoomId:domain":"Мама"}"""
+
+        val aliases = PlotinaRoomAliases.parse(content)
+
+        assertThat(aliases).containsExactly(aRoomId, "Денчик", anotherRoomId, "Мама")
+    }
+
+    @Test
+    fun `names are trimmed`() {
+        val aliases = PlotinaRoomAliases.parse("""{"!aRoomId:domain":"  Денчик  "}""")
+
+        assertThat(aliases).containsExactly(aRoomId, "Денчик")
+    }
+
+    @Test
+    fun `a blank payload is an empty map`() {
+        assertThat(PlotinaRoomAliases.parse(null)).isEmpty()
+        assertThat(PlotinaRoomAliases.parse("")).isEmpty()
+        assertThat(PlotinaRoomAliases.parse("   ")).isEmpty()
+    }
+
+    @Test
+    fun `broken json is an empty map rather than a crash`() {
+        assertThat(PlotinaRoomAliases.parse("""{"!aRoomId:domain":""")).isEmpty()
+        assertThat(PlotinaRoomAliases.parse("not json at all")).isEmpty()
+        assertThat(PlotinaRoomAliases.parse("{]")).isEmpty()
+    }
+
+    @Test
+    fun `content that is not a json object is an empty map`() {
+        assertThat(PlotinaRoomAliases.parse("[]")).isEmpty()
+        assertThat(PlotinaRoomAliases.parse("""["!aRoomId:domain"]""")).isEmpty()
+        assertThat(PlotinaRoomAliases.parse("\"a string\"")).isEmpty()
+        assertThat(PlotinaRoomAliases.parse("42")).isEmpty()
+    }
+
+    @Test
+    fun `keys that are not room ids are dropped`() {
+        val content = """{"aRoomId:domain":"Денчик","#alias:domain":"Мама","!not a room id":"x","":"y"}"""
+
+        val aliases = PlotinaRoomAliases.parse(content)
+
+        assertThat(aliases).isEmpty()
+    }
+
+    @Test
+    fun `values that are not non blank strings are dropped`() {
+        val content = """{"!aRoomId:domain":"","!anotherRoomId:domain":"   ","!third:domain":42,"!fourth:domain":null}"""
+
+        val aliases = PlotinaRoomAliases.parse(content)
+
+        assertThat(aliases).isEmpty()
+    }
+
+    @Test
+    fun `a v12 opaque room id is accepted`() {
+        val opaque = RoomId("!opaqueBase64Url-Id_NoDomain")
+
+        val aliases = PlotinaRoomAliases.parse("""{"!opaqueBase64Url-Id_NoDomain":"Денчик"}""")
+
+        assertThat(aliases).containsExactly(opaque, "Денчик")
+    }
+
+    // endregion
+
+    // region serialize
+
+    @Test
+    fun `a map is written as room id to name json`() {
+        val content = PlotinaRoomAliases.serialize(mapOf(aRoomId to "Денчик"))
+
+        assertThat(content).isEqualTo("""{"!aRoomId:domain":"Денчик"}""")
+    }
+
+    @Test
+    fun `a reset writes no empty value`() {
+        // A blank name cannot be represented: the entry disappears, and a map that becomes empty is
+        // written as {} rather than as an empty value the other clients would have to understand.
+        val content = PlotinaRoomAliases.serialize(mapOf(aRoomId to "  ", anotherRoomId to "Мама"))
+
+        assertThat(content).isEqualTo("""{"!anotherRoomId:domain":"Мама"}""")
+        assertThat(PlotinaRoomAliases.serialize(mapOf(aRoomId to ""))).isEqualTo("{}")
+        assertThat(PlotinaRoomAliases.serialize(emptyMap())).isEqualTo("{}")
+    }
+
+    @Test
+    fun `written content is stable and round trips`() {
+        val aliases = mapOf(anotherRoomId to " Мама ", aRoomId to "Денчик")
+
+        val first = PlotinaRoomAliases.serialize(aliases)
+        val second = PlotinaRoomAliases.serialize(aliases.entries.reversed().associate { it.toPair() })
+
+        assertThat(first).isEqualTo(second)
+        assertThat(PlotinaRoomAliases.parse(first)).containsExactly(aRoomId, "Денчик", anotherRoomId, "Мама")
+    }
+
+    // endregion
+}
