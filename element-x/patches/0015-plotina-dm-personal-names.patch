+package io.element.android.libraries.matrix.api.room.alias
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.core.UserId
+import io.element.android.libraries.matrix.api.user.MatrixUser
+import io.element.android.libraries.matrix.test.A_USER_ID
+import io.element.android.libraries.matrix.test.A_USER_ID_2
+import io.element.android.libraries.matrix.test.room.aRoomInfo
+import org.junit.Test
+
+class PlotinaContactNamesTest {
+    private val aUserId = UserId("@aUserId:domain")
+    private val anotherUserId = UserId("@anotherUserId:domain")
+    private val dm1 = RoomId("!firstDm:domain")
+    private val dm2 = RoomId("!secondDm:domain")
+
+    // region apply
+
+    @Test
+    fun `a personal name replaces the name of a dm`() {
+        val info = aRoomInfo(id = dm1, name = "Bob", rawName = null, isDm = true, heroes = listOf(MatrixUser(A_USER_ID_2)))
+
+        val result = info.withPlotinaContactName(mapOf(A_USER_ID_2 to "Денчик"))
+
+        assertThat(result.name).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `a personal name replaces the name of a room the sdk flags as direct`() {
+        val info = aRoomInfo(id = dm1, name = "Bob", rawName = null, isDm = false, isDirect = true)
+
+        val result = info.withPlotinaContactName(
+            names = mapOf(A_USER_ID_2 to "Денчик"),
+            directRooms = mapOf(dm1 to A_USER_ID_2),
+        )
+
+        assertThat(result.name).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `one person in two dms shows the same name in both`() {
+        // The contract keys by the contact, so a second dialogue with the same person needs no second
+        // write and cannot show a different name: both rooms resolve through the same key.
+        val names = mapOf(A_USER_ID_2 to "Денчик")
+        val first = aRoomInfo(id = dm1, name = "Bob", rawName = null, isDm = true, heroes = listOf(MatrixUser(A_USER_ID_2)))
+        val second = aRoomInfo(id = dm2, name = "Bob", rawName = null, isDm = true, heroes = listOf(MatrixUser(A_USER_ID_2)))
+
+        assertThat(first.withPlotinaContactName(names).name).isEqualTo("Денчик")
+        assertThat(second.withPlotinaContactName(names).name).isEqualTo("Денчик")
+    }
+
+    @Test
+    fun `a group keeps its own name even when its members have personal names`() {
+        val info = aRoomInfo(
+            id = dm1,
+            name = "Weekend plans",
+            isDm = false,
+            isDirect = false,
+            heroes = listOf(MatrixUser(A_USER_ID_2)),
+        )
+
+        val result = info.withPlotinaContactName(mapOf(A_USER_ID_2 to "Денчик"))
+
+        assertThat(result.name).isEqualTo("Weekend plans")
+    }
+
+    @Test
+    fun `a room whose own name was set keeps it`() {
+        // A personal name renames a person, not a room: an explicit m.room.name wins in the title,
+        // exactly as in the Mobile client (getLocalizedDisplayname returns it before the heroes).
+        val info = aRoomInfo(id = dm1, name = "Our chat", rawName = "Our chat", isDm = true, heroes = listOf(MatrixUser(A_USER_ID_2)))
+
+        val result = info.withPlotinaContactName(mapOf(A_USER_ID_2 to "Денчик"))
+
+        assertThat(result.name).isEqualTo("Our chat")
+    }
+
+    @Test
+    fun `a contact without a personal name keeps the room's name`() {
+        val info = aRoomInfo(id = dm1, name = "Bob", rawName = null, isDm = true, heroes = listOf(MatrixUser(A_USER_ID_2)))
+
+        val result = info.withPlotinaContactName(mapOf(anotherUserId to "Денчик"))
+
+        assertThat(result.name).isEqualTo("Bob")
+    }
+
+    @Test
+    fun `the name from the room state is never replaced`() {
+        val info = aRoomInfo(id = dm1, name = "Bob", rawName = "The real room name", isDm = true, heroes = listOf(MatrixUser(A_USER_ID_2)))
+
+        val result = info.withPlotinaContactName(mapOf(A_USER_ID_2 to "Денчик"))
+
+        assertThat(result.rawName).isEqualTo("The real room name")
+    }
+
+    @Test
+    fun `nothing but the name changes`() {
+        val info = aRoomInfo(id = dm1, name = "Bob", rawName = null, isDm = true, heroes = listOf(MatrixUser(A_USER_ID_2)))
+
+        val result = info.withPlotinaContactName(mapOf(A_USER_ID_2 to "Денчик"))
+
+        assertThat(result.copy(name = info.name)).isEqualTo(info)
+    }
+
+    @Test
+    fun `an empty name map changes nothing`() {
+        val info = aRoomInfo(id = dm1, name = "Bob", rawName = null, isDm = true, heroes = listOf(MatrixUser(A_USER_ID_2)))
+
+        assertThat(info.withPlotinaContactName(emptyMap())).isSameInstanceAs(info)
+    }
+
+    @Test
+    fun `a dm without a hero falls back to the account's m direct map`() {
+        val info = aRoomInfo(id = dm1, name = "Bob", rawName = null, isDm = false, isDirect = true, heroes = emptyList())
+
+        val result = info.withPlotinaContactName(
+            names = mapOf(A_USER_ID_2 to "Денчик"),
+            directRooms = mapOf(dm1 to A_USER_ID_2),
+        )
+
+        assertThat(result.name).isEqualTo("Денчик")
+    }
+
+    // endregion
+
+    // region parse
+
+    @Test
+    fun `a payload is read as a contact mxid to name map`() {
+        val content = """{"@aUserId:domain":"Денчик","@anotherUserId:domain":"Мама"}"""
+
+        val names = PlotinaContactNames.parse(content)
+
+        assertThat(names).containsExactly(aUserId, "Денчик", anotherUserId, "Мама")
+    }
+
+    @Test
+    fun `the payload the other clients write is read`() {
+        // Byte for byte the shape Mobile's plotinaContactNamesAfterSet and Web's overlay produce.
+        val names = PlotinaContactNames.parse("""{"@bob:plotina.cc":"Денчик"}""")
+
+        assertThat(names).containsExactly(UserId("@bob:plotina.cc"), "Денчик")
+    }
+
+    @Test
+    fun `names are trimmed`() {
+        val names = PlotinaContactNames.parse("""{"@aUserId:domain":"  Денчик  "}""")
+
+        assertThat(names).containsExactly(aUserId, "Денчик")
+    }
+
+    @Test
+    fun `a blank payload is an empty map`() {
+        assertThat(PlotinaContactNames.parse(null)).isEmpty()
+        assertThat(PlotinaContactNames.parse("")).isEmpty()
+        assertThat(PlotinaContactNames.parse("   ")).isEmpty()
+    }
+
+    @Test
+    fun `broken json is an empty map rather than a crash`() {
+        assertThat(PlotinaContactNames.parse("""{"@aUserId:domain":""")).isEmpty()
+        assertThat(PlotinaContactNames.parse("not json at all")).isEmpty()
+        assertThat(PlotinaContactNames.parse("{]")).isEmpty()
+    }
+
+    @Test
+    fun `content that is not a json object is an empty map`() {
+        assertThat(PlotinaContactNames.parse("[]")).isEmpty()
+        assertThat(PlotinaContactNames.parse("""["@aUserId:domain"]""")).isEmpty()
+        assertThat(PlotinaContactNames.parse("\"a string\"")).isEmpty()
+        assertThat(PlotinaContactNames.parse("42")).isEmpty()
+    }
+
+    @Test
+    fun `keys that are not mxids are dropped`() {
+        val content = """{"aUserId:domain":"Денчик","#alias:domain":"Мама","!aRoomId:domain":"Петя","":"y"}"""
+
+        assertThat(PlotinaContactNames.parse(content)).isEmpty()
+    }
+
+    @Test
+    fun `the old room keyed event is junk, not a name`() {
+        // cc.plotina.room_aliases is never read and never migrated: its keys are room ids, so the
+        // contact parser drops all of them and the client behaves as if there were no names.
+        val oldEvent = """{"!aRoomId:domain":"Денчик","!anotherRoomId:domain":"Мама"}"""
+
+        assertThat(PlotinaContactNames.parse(oldEvent)).isEmpty()
+    }
+
+    @Test
+    fun `values that are not non blank strings are dropped`() {
+        val content = """{"@aUserId:domain":"","@anotherUserId:domain":"   ","@c:domain":42,"@d:domain":null}"""
+
+        assertThat(PlotinaContactNames.parse(content)).isEmpty()
+    }
+
+    // endregion
+
+    // region serialize
+
+    @Test
+    fun `a map is written as mxid to name json`() {
+        val content = PlotinaContactNames.serialize(mapOf(aUserId to "Денчик"))
+
+        assertThat(content).isEqualTo("""{"@aUserId:domain":"Денчик"}""")
+    }
+
+    @Test
+    fun `a reset writes no empty value`() {
+        // A blank name cannot be represented: the entry disappears, and a map that becomes empty is
+        // written as {} rather than as an empty value the other clients would have to understand.
+        val content = PlotinaContactNames.serialize(mapOf(aUserId to "  ", anotherUserId to "Мама"))
+
+        assertThat(content).isEqualTo("""{"@anotherUserId:domain":"Мама"}""")
+        assertThat(PlotinaContactNames.serialize(mapOf(aUserId to ""))).isEqualTo("{}")
+        assertThat(PlotinaContactNames.serialize(emptyMap())).isEqualTo("{}")
+    }
+
+    @Test
+    fun `written content is stable and round trips`() {
+        val names = mapOf(anotherUserId to " Мама ", aUserId to "Денчик")
+
+        val first = PlotinaContactNames.serialize(names)
+        val second = PlotinaContactNames.serialize(names.entries.reversed().associate { it.toPair() })
+
+        assertThat(first).isEqualTo(second)
+        assertThat(PlotinaContactNames.parse(first)).containsExactly(aUserId, "Денчик", anotherUserId, "Мама")
+    }
+
+    // endregion
+
+    // region m.direct
+
+    @Test
+    fun `the m direct event is read as room id to contact`() {
+        val content = """{"@aUserId:domain":["!firstDm:domain","!secondDm:domain"],"@anotherUserId:domain":["!third:domain"]}"""
+
+        val rooms = PlotinaDirectRooms.parse(content)
+
+        assertThat(rooms).containsExactly(
+            dm1, aUserId,
+            dm2, aUserId,
+            RoomId("!third:domain"), anotherUserId,
+        )
+    }
+
+    @Test
+    fun `a broken m direct event is an empty map`() {
+        assertThat(PlotinaDirectRooms.parse(null)).isEmpty()
+        assertThat(PlotinaDirectRooms.parse("""{"@aUserId:domain":{"!firstDm:domain":"x"}}""")).isEmpty()
+        assertThat(PlotinaDirectRooms.parse("""{"@aUserId:domain":["not a room id"]}""")).isEmpty()
+        assertThat(PlotinaDirectRooms.parse("""["@aUserId:domain"]""")).isEmpty()
+        assertThat(PlotinaDirectRooms.parse("{ this is not json")).isEmpty()
+    }
+
+    // endregion
+
+    @Test
+    fun `the event type is the contract's, not the old room keyed one`() {
+        assertThat(PLOTINA_CONTACT_NAMES_EVENT_TYPE).isEqualTo("cc.plotina.contact_names")
+    }
+
+    @Test
+    fun `the account's own user is not mistaken for a contact`() {
+        // A payload that names ourselves must not be applied; the guard is on the room, so this only
+        // checks the resolver does not invent a name for a non-dialogue room of ours.
+        val info = aRoomInfo(id = dm1, name = "Notes", isDm = false, isDirect = false, heroes = listOf(MatrixUser(A_USER_ID)))
+
+        assertThat(info.withPlotinaContactName(mapOf(A_USER_ID to "Я")).name).isEqualTo("Notes")
+    }
+}
