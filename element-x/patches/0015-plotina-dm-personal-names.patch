+
+package io.element.android.libraries.matrix.api.room.alias
+
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.core.UserId
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * The account's personal names for its contacts, read from the [PLOTINA_CONTACT_NAMES_EVENT_TYPE]
+ * account data event.
+ *
+ * Session scoped: one store per logged-in account, so two accounts on the same device never see each
+ * other's names. [names] is hot and re-emits whenever the stored map changes, which is what the room
+ * list and the open chat listen to.
+ */
+interface ContactNameStore {
+    /**
+     * The current map of contact mxid to personal name. Empty until the first read completes, and
+     * empty again if the stored content cannot be understood.
+     */
+    val names: StateFlow<Map<UserId, String>>
+
+    /**
+     * Who each direct room is with, from the account's `m.direct` event. Only used to find the
+     * contact of a room the app does not treat as a two-member DM: for those the SDK already hands
+     * us the counterpart as the room's single hero.
+     */
+    val directRooms: StateFlow<Map<RoomId, UserId>>
+
+    /**
+     * The personal name saved for [userId], or null when it has none. Does not check whether any room
+     * is a personal dialogue with that contact: use [PlotinaContactNames.nameFor] for that.
+     */
+    fun nameFor(userId: UserId): String?
+
+    /**
+     * Re-reads the account data events and publishes the result.
+     *
+     * Fails only when the events cannot be read at all; content that is not valid JSON is not a
+     * failure, it is an empty map. Callers can ignore the result: [names] keeps its previous value.
+     */
+    suspend fun refresh(): Result<Unit>
+
+    /**
+     * Sets the personal name of [userId] to [name], or removes it when [name] is null or blank.
+     *
+     * Writes the whole [PLOTINA_CONTACT_NAMES_EVENT_TYPE] account data event, preserving the other
+     * entries, and never touches any room's state. The local map is updated only once the write
+     * succeeded.
+     */
+    suspend fun setName(userId: UserId, name: String?): Result<Unit>
+}
