+/*
+ * Copyright (c) 2026 Element Creations Ltd.
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial.
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.matrix.api.room.alias
+
+import io.element.android.libraries.matrix.api.core.RoomId
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * The account's personal names for its personal dialogues, read from the
+ * [PLOTINA_ROOM_ALIASES_EVENT_TYPE] account data event.
+ *
+ * Session scoped: one store per logged-in account, so two accounts on the same device never see each
+ * other's names. [aliases] is hot and re-emits whenever the stored map changes, which is what the room
+ * list and the open chat listen to.
+ */
+interface RoomAliasStore {
+    /**
+     * The current map of room id to personal name. Empty until the first read completes, and empty
+     * again if the stored content cannot be understood.
+     */
+    val aliases: StateFlow<Map<RoomId, String>>
+
+    /**
+     * The personal name saved for [roomId], or null when it has none. Does not check whether the room
+     * is a personal dialogue: use [PlotinaRoomAliases.aliasFor] for that.
+     */
+    fun nameFor(roomId: RoomId): String?
+
+    /**
+     * Re-reads the account data event and publishes the result.
+     *
+     * Fails only when the event cannot be read at all; content that is not valid JSON is not a failure,
+     * it is an empty map. Callers can ignore the result: [aliases] simply keeps its previous value.
+     */
+    suspend fun refresh(): Result<Unit>
+
+    /**
+     * Sets the personal name of [roomId] to [name], or removes it when [name] is null or blank.
+     *
+     * Writes the whole [PLOTINA_ROOM_ALIASES_EVENT_TYPE] account data event, preserving the other
+     * entries, and never touches the room's state. The local map is updated only once the write
+     * succeeded.
+     */
+    suspend fun setAlias(roomId: RoomId, name: String?): Result<Unit>
+}
