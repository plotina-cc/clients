+package io.element.android.libraries.matrix.api.room.alias
+
+import io.element.android.libraries.matrix.api.core.MatrixPatterns
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.room.RoomInfo
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+/**
+ * The account data type holding the user's personal names for rooms.
+ *
+ * Plotina: a personal name is a label the account owner gives to a personal dialogue (a DM). It lives
+ * in this account data event as `{"<room_id>": "<name>"}`, so only that account sees it: the room's
+ * `m.room.name` state event is never written and the other side keeps the name it always had. An
+ * empty value means "no personal name" and the key is dropped, so resetting the last alias leaves
+ * `{}` behind rather than an empty string.
+ *
+ * The contract is shared with the other Plotina clients (Element Web/Desktop writes and reads the
+ * same event), so the parsing here is deliberately forgiving: anything that is not a JSON object of
+ * room id to non-blank string is ignored instead of failing, which keeps a broken or foreign payload
+ * from breaking the room list.
+ */
+const val PLOTINA_ROOM_ALIASES_EVENT_TYPE = "cc.plotina.room_aliases"
+
+object PlotinaRoomAliases {
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /**
+     * The personal names in an account data [content] payload, keyed by room id.
+     *
+     * Never throws: blank, malformed or non-object content yields an empty map, and entries whose key
+     * is not a room id or whose value is not a non-blank string are dropped.
+     */
+    fun parse(content: String?): Map<RoomId, String> {
+        if (content.isNullOrBlank()) return emptyMap()
+        val root = runCatching { json.parseToJsonElement(content) }.getOrNull() as? JsonObject ?: return emptyMap()
+        val aliases = LinkedHashMap<RoomId, String>(root.size)
+        root.forEach { (key, value) ->
+            // Only keys that a RoomId accepts end up here: RoomId validates itself in debug builds,
+            // so a foreign key must be filtered before it is wrapped.
+            if (!MatrixPatterns.isRoomId(key)) return@forEach
+            val name = (value as? JsonPrimitive)?.takeIf { it.isString }?.content?.trim()
+            if (name.isNullOrEmpty()) return@forEach
+            aliases[RoomId(key)] = name
+        }
+        return aliases
+    }
+
+    /**
+     * The account data content for [aliases], as a compact JSON object with sorted keys.
+     *
+     * Blank names are dropped, so the payload never carries an empty value. Sorted keys keep the
+     * written content stable: saving the same map twice writes the same bytes.
+     */
+    fun serialize(aliases: Map<RoomId, String>): String = buildJsonObject {
+        aliases.entries
+            .mapNotNull { (roomId, name) -> name.trim().takeIf { it.isNotEmpty() }?.let { roomId.value to it } }
+            .sortedBy { (roomId, _) -> roomId }
+            .forEach { (roomId, name) -> put(roomId, name) }
+    }.toString()
+
+    /**
+     * The personal name to show for [roomId], or null to keep the room's own name.
+     *
+     * A room only takes its personal name when it is a personal dialogue: an alias left over for a
+     * group (or set by another client for one) must never mask the group's real name. A personal
+     * dialogue is either what the SDK flags as direct (`m.direct`) or the two-member room the app
+     * already presents as a DM.
+     */
+    fun aliasFor(aliases: Map<RoomId, String>, roomId: RoomId, isDirect: Boolean, isDm: Boolean): String? {
+        if (!isDirect && !isDm) return null
+        return aliases[roomId]
+    }
+}
+
+/**
+ * The [RoomInfo] to display: the room's own name, with the user's personal name on top when the room
+ * is a personal dialogue and has one.
+ *
+ * Only [RoomInfo.name] is replaced - the one field the app renders. [RoomInfo.rawName], which mirrors
+ * the `m.room.name` state event, and everything else stay as the SDK reported them, so nothing here
+ * can travel back to the room's state or to the other side.
+ */
+fun RoomInfo.withPlotinaAlias(aliases: Map<RoomId, String>): RoomInfo {
+    val alias = PlotinaRoomAliases.aliasFor(aliases, id, isDirect, isDm) ?: return this
+    return copy(name = alias)
+}
