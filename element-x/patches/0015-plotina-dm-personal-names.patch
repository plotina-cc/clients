+import io.element.android.libraries.matrix.api.sync.SyncService
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.FlowPreview
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.debounce
+import kotlinx.coroutines.flow.drop
+import kotlinx.coroutines.flow.launchIn
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.merge
+import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import org.matrix.rustcomponents.sdk.Client
+import timber.log.Timber
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * Plotina: [ContactNameStore] on top of the account data API of the Rust SDK.
+ *
+ * Both events are read once at start and then re-read after every sync round trip, so a name set from
+ * another client of the same account shows up here as soon as that client's account data has been
+ * synced. Writing goes through `setAccountData` only: no room state is touched, which is what makes
+ * the name private to this account.
+ */
+class RustContactNameStore(
+    private val client: Client,
+    private val syncService: SyncService,
+    sessionCoroutineScope: CoroutineScope,
+    dispatchers: CoroutineDispatchers,
+) : ContactNameStore {
+    private val dispatcher = dispatchers.io.limitedParallelism(2)
+    private val storeScope = sessionCoroutineScope.childScope(dispatchers.main, "ContactNameStore")
+
+    // The reads and the read-modify-write of setName() must not interleave: a refresh landing in the
+    // middle of a save would otherwise publish the map from before the save.
+    private val mutex = Mutex()
+
+    private val _names = MutableStateFlow<Map<UserId, String>>(emptyMap())
+    override val names: StateFlow<Map<UserId, String>> = _names.asStateFlow()
+
+    private val _directRooms = MutableStateFlow<Map<RoomId, UserId>>(emptyMap())
+    override val directRooms: StateFlow<Map<RoomId, UserId>> = _directRooms.asStateFlow()
+
+    init {
+        storeScope.launch { observeSync() }
+    }
+
+    override fun nameFor(userId: UserId): String? = _names.value[userId]
+
+    override suspend fun refresh(): Result<Unit> = withContext(dispatcher) {
+        runCatchingExceptions {
+            // Read and publish under the same lock as setName(): a read that started before a write
+            // must not publish its stale map after it.
+            mutex.withLock {
+                _names.value = PlotinaContactNames.parse(client.accountData(PLOTINA_CONTACT_NAMES_EVENT_TYPE))
+                _directRooms.value = PlotinaDirectRooms.parse(client.accountData(M_DIRECT_EVENT_TYPE))
+            }
+        }.onFailure {
+            // A failure to read must not clear what is already displayed: keep the previous maps.
+            Timber.e(it, "Plotina: could not read the personal names of this account")
+        }
+    }
+
+    override suspend fun setName(userId: UserId, name: String?): Result<Unit> = withContext(dispatcher) {
+        mutex.withLock {
+            runCatchingExceptions {
+                // Build the new content from what the server has, not from the snapshot: another
+                // client of this account may have added a name we have not synced yet, and this
+                // write replaces the whole event.
+                val stored = PlotinaContactNames.parse(client.accountData(PLOTINA_CONTACT_NAMES_EVENT_TYPE))
+                val updated = stored.toMutableMap()
+                val trimmed = name?.trim()
+                if (trimmed.isNullOrEmpty()) {
+                    updated.remove(userId)
+                } else {
+                    updated[userId] = trimmed
+                }
+                client.setAccountData(PLOTINA_CONTACT_NAMES_EVENT_TYPE, PlotinaContactNames.serialize(updated))
+                _names.value = updated
+            }.onFailure {
+                Timber.e(it, "Plotina: could not write $PLOTINA_CONTACT_NAMES_EVENT_TYPE")
+            }
+        }
+    }
+
+    @OptIn(FlowPreview::class)
+    private fun observeSync() {
+        // The account data of a round trip is in the local store by the time the sync reports itself
+        // running again, so this is where names set from another client are picked up. The sync state
+        // is watched as well as the beat: a session that starts syncing before its first read leaves
+        // nothing else to notice the account data has arrived.
+        merge(syncService.syncState.drop(1), syncService.heartBeat)
+            .map { }
+            .debounce(1.seconds)
+            .onEach { refresh() }
+            .launchIn(storeScope)
+    }
+
+    private companion object {
+        /** The Matrix event that maps a contact to the rooms the account talks to them in. */
+        const val M_DIRECT_EVENT_TYPE = "m.direct"
+    }
+}
