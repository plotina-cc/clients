+package io.element.android.libraries.matrix.test.room.alias
+
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.room.alias.PlotinaRoomAliases
+import io.element.android.libraries.matrix.api.room.alias.RoomAliasStore
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+
+class FakeRoomAliasStore(
+    initialAliases: Map<RoomId, String> = emptyMap(),
+    var setAliasResult: Result<Unit> = Result.success(Unit),
+    var refreshResult: Result<Unit> = Result.success(Unit),
+) : RoomAliasStore {
+    private val state = MutableStateFlow(initialAliases)
+    override val aliases: StateFlow<Map<RoomId, String>> = state.asStateFlow()
+
+    /** The writes this fake received, as (roomId, name) pairs, name null for a reset. */
+    val setAliasCalls = mutableListOf<Pair<RoomId, String?>>()
+
+    override fun nameFor(roomId: RoomId): String? = state.value[roomId]
+
+    override suspend fun refresh(): Result<Unit> = refreshResult
+
+    override suspend fun setAlias(roomId: RoomId, name: String?): Result<Unit> {
+        setAliasCalls.add(roomId to name)
+        setAliasResult.onSuccess {
+            state.update { current ->
+                val trimmed = name?.trim()
+                if (trimmed.isNullOrEmpty()) current - roomId else current + (roomId to trimmed)
+            }
+        }
+        return setAliasResult
+    }
+
+    /** Replaces the published map, as if the account data had been changed elsewhere. */
+    fun givenAliases(aliases: Map<RoomId, String>) {
+        state.value = aliases
+    }
+
+    /** The account data content this fake would have written, for assertions on the payload shape. */
+    fun content(): String = PlotinaRoomAliases.serialize(state.value)
+}
