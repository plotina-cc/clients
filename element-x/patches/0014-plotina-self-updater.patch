+/**
+ * What the screen shows. The Activity owns the transitions; the screen itself is stateless so it
+ * can be previewed and tested with any stage. [Message.retry] picks which action repeats the work:
+ * a manifest re-check after a failed fetch, or a fresh download after a failed transfer.
+ */
+sealed interface UpdaterUiState {
+    data object Checking : UpdaterUiState
+    data object Verifying : UpdaterUiState
+    data object Installing : UpdaterUiState
+    data object NeedPermission : UpdaterUiState
+    data class UpToDate(val version: String) : UpdaterUiState
+    data class Available(val info: UpdateInfo) : UpdaterUiState
+    data class Downloading(val percent: Int) : UpdaterUiState
+    data class Message(val text: String, val retry: Retry = Retry.None) : UpdaterUiState
+
+    enum class Retry { None, Check, Download }
+}
+
+/** Byte count the way the card shows it: MB above a megabyte, kB above a kilobyte. */
+internal fun prettySize(bytes: Long): String = when {
+    bytes >= 1_000_000 -> "%.1f MB".format(bytes / 1_000_000.0)
+    bytes >= 1_000 -> "%.0f kB".format(bytes / 1_000.0)
+    else -> "$bytes B"
+}
+
+/**
+ * The whole updater page: AppBar + the current stage, centred in a 480 dp column over 24 dp of
+ * padding, exactly the layout of the Mobile route the users already see on their phones.
+ */
+@Composable
+internal fun PlotinaUpdaterScreen(
+    state: UpdaterUiState,
+    onBackClick: () -> Unit,
+    onDownloadClick: () -> Unit,
+    onLaterClick: () -> Unit,
+    onCancelDownloadClick: () -> Unit,
+    onOpenSettingsClick: () -> Unit,
+    onRetryClick: () -> Unit,
+    onCloseClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Scaffold(
+        modifier = modifier,
+        topBar = {
+            TopAppBar(
+                title = { Text(stringResource(R.string.plotina_update_screen_title)) },
+                navigationIcon = {
+                    IconButton(onClick = onBackClick) {
+                        Icon(
+                            imageVector = CompoundIcons.Close(),
+                            contentDescription = stringResource(R.string.plotina_update_back),
+                        )
+                    }
+                },
+                colors = TopAppBarDefaults.topAppBarColors(
+                    containerColor = MaterialTheme.colorScheme.surface,
+                    titleContentColor = MaterialTheme.colorScheme.onSurface,
+                    navigationIconContentColor = MaterialTheme.colorScheme.onSurface,
+                ),
+            )
+        },
+        containerColor = MaterialTheme.colorScheme.surface,
+    ) { contentPadding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(contentPadding)
+                .verticalScroll(rememberScrollState())
+                .padding(24.dp),
+            horizontalAlignment = Alignment.CenterHorizontally,
+        ) {
+            Column(
+                modifier = Modifier
+                    .widthIn(max = 480.dp)
+                    .fillMaxWidth(),
+                horizontalAlignment = Alignment.CenterHorizontally,
+                verticalArrangement = Arrangement.spacedBy(0.dp),
+            ) {
+                when (val s = state) {
+                    UpdaterUiState.Checking -> Stage(
+                        spinner = true,
+                        headline = stringResource(R.string.plotina_update_checking),
+                    )
+
+                    UpdaterUiState.Verifying -> Stage(
+                        spinner = true,
+                        headline = stringResource(R.string.plotina_update_verifying),
+                    )
+
+                    UpdaterUiState.Installing -> Stage(
+                        icon = CompoundIcons.Download(),
+                        headline = stringResource(R.string.plotina_update_installing),
+                        actions = {
+                            TextButton(onClick = onCloseClick, modifier = Modifier.fillMaxWidth()) {
+                                Text(stringResource(R.string.plotina_update_close))
+                            }
+                        },
+                    )
+
+                    is UpdaterUiState.UpToDate -> Stage(
+                        icon = CompoundIcons.CheckCircle(),
+                        headline = stringResource(R.string.plotina_update_no_updates),
+                        body = stringResource(R.string.plotina_update_is_latest, s.version),
+                    )
+
+                    is UpdaterUiState.Available -> Column(
+                        modifier = Modifier.fillMaxWidth(),
+                        horizontalAlignment = Alignment.CenterHorizontally,
+                    ) {
+                        UpdateCard(
+                            info = s.info,
+                            onDownloadClick = onDownloadClick,
+                            onLaterClick = onLaterClick,
+                        )
+                    }
+
+                    is UpdaterUiState.Downloading -> Stage(
+                        headline = stringResource(R.string.plotina_update_downloading),
+                        body = stringResource(R.string.plotina_update_progress_percent, s.percent),
+                        progress = s.percent,
+                        actions = {
+                            TextButton(onClick = onCancelDownloadClick, modifier = Modifier.fillMaxWidth()) {
+                                Text(stringResource(R.string.plotina_update_cancel))
+                            }
+                        },
+                    )
+
+                    UpdaterUiState.NeedPermission -> Stage(
+                        icon = CompoundIcons.Shield(),
+                        headline = stringResource(R.string.plotina_update_permission_title),
+                        body = stringResource(R.string.plotina_update_permission_text),
+                        actions = {
+                            PrimaryAction(
+                                onClick = onOpenSettingsClick,
+                                text = stringResource(R.string.plotina_update_open_settings),
+                            )
+                            TextButton(onClick = onLaterClick, modifier = Modifier.fillMaxWidth()) {
+                                Text(stringResource(R.string.plotina_update_later))
+                            }
+                        },
+                    )
+
+                    is UpdaterUiState.Message -> Stage(
+                        icon = CompoundIcons.ErrorSolid(),
+                        iconColor = MaterialTheme.colorScheme.error,
+                        headline = s.text,
+                        actions = {
+                            if (s.retry != UpdaterUiState.Retry.None) {
+                                PrimaryAction(
+                                    onClick = onRetryClick,
+                                    text = stringResource(R.string.plotina_update_retry),
+                                    icon = CompoundIcons.Restart(),
+                                )
+                            }
+                            TextButton(onClick = onCloseClick, modifier = Modifier.fillMaxWidth()) {
+                                Text(stringResource(R.string.plotina_update_close))
+                            }
+                        },
+                    )
+                }
+            }
+        }
+    }
+}
+
+/** One stage: icon or spinner, headline, optional body / progress / card, then the actions. */
+@Composable
+private fun Stage(
+    headline: String,
+    icon: ImageVector? = null,
+    iconColor: Color = MaterialTheme.colorScheme.primary,
+    spinner: Boolean = false,
+    body: String? = null,
+    progress: Int? = null,
+    actions: @Composable () -> Unit = {},
+) {
+    Column(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        when {
+            spinner -> Box(
+                modifier = Modifier.size(56.dp),
+                contentAlignment = Alignment.Center,
+            ) {
+                CircularProgressIndicator(modifier = Modifier.size(40.dp))
+            }
+
+            icon != null -> Icon(
+                imageVector = icon,
+                contentDescription = null,
+                modifier = Modifier.size(56.dp),
+                tint = iconColor,
+            )
+        }
+        Spacer(modifier = Modifier.height(16.dp))
+        Text(
+            text = headline,
+            modifier = Modifier.fillMaxWidth(),
+            textAlign = TextAlign.Center,
+            style = MaterialTheme.typography.titleMedium,
+            color = MaterialTheme.colorScheme.onSurface,
+        )
+        if (body != null) {
+            Spacer(modifier = Modifier.height(12.dp))
+            Text(
+                text = body,
+                modifier = Modifier.fillMaxWidth(),
+                textAlign = TextAlign.Center,
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        if (progress != null) {
+            Spacer(modifier = Modifier.height(16.dp))
+            LinearProgressIndicator(
+                progress = { progress / 100f },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .height(8.dp),
+            )
+        }
+        Spacer(modifier = Modifier.height(24.dp))
+        Column(
+            modifier = Modifier.fillMaxWidth(),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            actions()
+        }
+    }
+}
+
+/** Version, notes and size, in the bordered card the Mobile page shows. */
+@Composable
+private fun UpdateCard(
+    info: UpdateInfo,
+    onDownloadClick: () -> Unit,
