+
+/**
+ * What the screen shows. The Activity owns the transitions; the screen itself is stateless so it
+ * can be previewed and tested with any stage. [Message.retry] picks which action repeats the work:
+ * a manifest re-check after a failed fetch, or a fresh download after a failed transfer.
+ */
+sealed interface UpdaterUiState {
+    data object Checking : UpdaterUiState
+    data object Verifying : UpdaterUiState
+    data object Installing : UpdaterUiState
+    data object NeedPermission : UpdaterUiState
+    data class UpToDate(val version: String) : UpdaterUiState
+    /**
+     * The dev-build-on-stable-channel case: nothing to download yet, and the honest answer is
+     * "still a dev build, waiting for a stable that outranks it" (PlotinaUpdate.isPassiveStable).
+     */
+    data class PassiveStable(val version: String) : UpdaterUiState
+    data class Available(val info: UpdateInfo) : UpdaterUiState
+    data class Downloading(val percent: Int) : UpdaterUiState
+    data class Message(val text: String, val retry: Retry = Retry.None) : UpdaterUiState
+
+    enum class Retry { None, Check, Download }
+}
+
+/** Byte count the way the card shows it: MB above a megabyte, kB above a kilobyte. */
+internal fun prettySize(bytes: Long): String = when {
+    bytes >= 1_000_000 -> "%.1f MB".format(bytes / 1_000_000.0)
+    bytes >= 1_000 -> "%.0f kB".format(bytes / 1_000.0)
+    else -> "$bytes B"
+}
+
