diff --git a/app/src/main/kotlin/io/element/android/x/updater/PlotinaUpdate.kt b/app/src/main/kotlin/io/element/android/x/updater/PlotinaUpdate.kt
new file mode 100644
index 00000000..503e2983
--- /dev/null
+++ b/app/src/main/kotlin/io/element/android/x/updater/PlotinaUpdate.kt
@@ -0,0 +1,189 @@
+/*
+ * Plotina: the in-app updater's manifest side.
+ *
+ * Copyright (C) 2026 Plotina
+ *
+ * This program is free software: you can redistribute it and/or modify it under the terms of the
+ * GNU Affero General Public License as published by the Free Software Foundation, version 3.
+ */
+
+package io.element.android.x.updater
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import androidx.core.content.pm.PackageInfoCompat
+import java.net.HttpURLConnection
+import java.net.URL
+import org.json.JSONObject
+import timber.log.Timber
+
+private const val loggerTag = "PlotinaUpdate"
+
+/**
+ * What https://plotina.cc/dl/update-x.json says about the newest release. The contract is shared
+ * with the other Plotina clients:
+ *
+ * ```json
+ * {"client":"x","package":"cc.plotina.x","versionName":"26.10.1","versionCode":2026100252,
+ *  "apkUrl":"https://plotina.cc/dl/Plotina-X.apk","sha256":"<hex>","size":<bytes>,
+ *  "notes":"<short ru text>"}
+ * ```
+ *
+ * `versionCode` is what the arm64 APK reports - the base code with the ABI digit (2) still on it -
+ * because that is the file the manifest points at. [isUpdateAvailable] drops the digit before
+ * comparing, so an armv7 install sees the same answer as an arm64 one for the same build.
+ */
+data class UpdateInfo(
+    val packageName: String,
+    val versionName: String,
+    val versionCode: Long,
+    val apkUrl: String,
+    val sha256: String,
+    val size: Long,
+    val notes: String,
+) {
+    fun toJson(): String = JSONObject()
+        .put("client", "x")
+        // The package travels too: [fromJson] insists on it, and the daily check hands its parsed
+        // manifest to the Activity, where it is parsed exactly like a fresh one.
+        .put("package", packageName)
+        .put("versionName", versionName)
+        .put("versionCode", versionCode)
+        .put("apkUrl", apkUrl)
+        .put("sha256", sha256)
+        .put("size", size)
+        .put("notes", notes)
+        .toString()
+
+    companion object {
+        /** Null unless every field is present and sane; it never trusts the manifest blindly. */
+        fun fromJson(context: Context, raw: String): UpdateInfo? = runCatching {
+            val json = JSONObject(raw)
+            if (json.optString("client") != "x") return null
+            val apkUrl = json.getString("apkUrl")
+            // Only ever install over https, and only ever for this application id. The debug build
+            // carries the ".debug" suffix, so a manifest written for the release is accepted there
+            // too - it is the same updater code under test, and a prefix mismatch cannot be confused
+            // with another vendor's app.
+            if (!apkUrl.startsWith("https://")) return null
+            val manifestPackage = json.getString("package")
+            val packageName = context.packageName
+            if (packageName != manifestPackage && !packageName.startsWith("$manifestPackage.")) return null
+            val sha256 = json.getString("sha256").lowercase()
+            if (!Regex("^[0-9a-f]{64}$").matches(sha256)) return null
+            UpdateInfo(
+                packageName = manifestPackage,
+                versionName = json.getString("versionName"),
+                versionCode = json.getLong("versionCode"),
+                apkUrl = apkUrl,
+                sha256 = sha256,
+                size = json.getLong("size"),
+                notes = json.optString("notes"),
+            ).takeIf { it.versionCode > 0 && it.size > 0 }
+        }.onFailure { Timber.tag(loggerTag).w(it, "update manifest did not parse") }.getOrNull()
+    }
+}
+
+/**
+ * Reads the release manifest.
+ *
+ * The versionCode scheme (documented for CI, the updater and anyone re-releasing by hand):
+ * a release tag `vYY.MM.p-plotina-x.N` maps to the base code
+ * `(2000 + YY) * 100_000 + MM * 1_000 + N`, so `v26.10.1-plotina-x.25` is `202610025`. CI passes
+ * `N` as `-PplotinaBuildNumber` (see `app/build.gradle.kts` and build-element-x.yml). The packaged
+ * APK's own versionCode additionally carries upstream's ABI digit
+ * (`base * 10 + abiCode`, arm64-v8a = 2, armeabi-v7a = 1). update-x.json carries the arm64 APK's
+ * full number - the file it points at - and [isUpdateAvailable] drops the digit from both sides
+ * before comparing. Base codes are strictly greater than those of the pre-updater builds (whose
+ * base was upstream's `20261001`), so every installed Plotina X can be upgraded by this scheme.
+ */
+object PlotinaUpdate {
+    const val MANIFEST_URL = "https://plotina.cc/dl/update-x.json"
+
+    /** The updater screen, named from other modules too - they cannot see the app module. */
+    const val ACTIVITY_CLASS = "io.element.android.x.updater.PlotinaUpdateActivity"
+
+    /** A already-fetched manifest, passed as JSON by the daily check. */
+    const val EXTRA_MANIFEST = "plotina_update_manifest"
+
+    /** Test hook: `adb shell am start ... --es plotina_manifest_url http://10.0.2.2:8000/update-x.json`. */
+    const val EXTRA_MANIFEST_URL = "plotina_manifest_url"
+
+    private const val PREFS = "plotina-updater"
+    private const val KEY_LAST_CHECK = "last_check_ms"
+    private const val CHECK_INTERVAL_MS = 24 * 60 * 60 * 1000L
+
+    fun activityIntent(context: Context): Intent =
+        Intent().setClassName(context.packageName, ACTIVITY_CLASS)
+
+    /**
+     * Drops the ABI digit the packaging step appends (`base * 10 + abiCode`, arm64-v8a = 2,
+     * armeabi-v7a = 1). Every versionCode comparison goes through this, on both sides.
+     */
+    fun baseCodeOf(versionCode: Long): Long = versionCode / 10L
+
+    /** The installed version's base code, without the ABI digit the packaging step appends. */
+    fun installedBaseCode(context: Context): Long {
+        val packageInfo = context.packageManager.getPackageInfo(context.packageName, 0)
+        return baseCodeOf(PackageInfoCompat.getLongVersionCode(packageInfo))
+    }
+
+    fun installedVersionName(context: Context): String =
+        context.packageManager.getPackageInfo(context.packageName, 0).versionName.orEmpty()
+
+    /**
+     * Whether the manifest describes a newer build. CI writes the arm64 split's full versionCode,
+     * ABI digit included, into update-x.json, while a phone may run either split, so the digit is
+     * dropped from the manifest number too before comparing base codes. Comparing the raw manifest
+     * number against a base code made it always greater - the same build was offered forever
+     * after updating (the .28 report); integer division keeps an armv7 install quiet as well.
+     */
+    fun isUpdateAvailable(manifestVersionCode: Long, installedBase: Long): Boolean =
+        baseCodeOf(manifestVersionCode) > installedBase
+
+    fun isUpdateAvailable(context: Context, info: UpdateInfo): Boolean =
+        isUpdateAvailable(manifestVersionCode = info.versionCode, installedBase = installedBaseCode(context))
+
+    /**
+     * Silent once-a-day check started from MainActivity.onCreate. Only when the manifest really
+     * describes a newer build does anything open: the updater page, carrying the manifest we
+     * already fetched, so the user never waits on a second request.
+     */
+    fun onAppStart(activity: Activity) {
+        val prefs = activity.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val now = System.currentTimeMillis()
+        if (now - prefs.getLong(KEY_LAST_CHECK, 0L) < CHECK_INTERVAL_MS) return
+        prefs.edit().putLong(KEY_LAST_CHECK, now).apply()
+        val appContext = activity.applicationContext
+        Thread {
+            val info = fetch(appContext, MANIFEST_URL) ?: return@Thread
+            if (!isUpdateAvailable(appContext, info)) return@Thread
+            if (activity.isFinishing || activity.isDestroyed) return@Thread
+            val intent = activityIntent(appContext)
+                .putExtra(EXTRA_MANIFEST, info.toJson())
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            runCatching { appContext.startActivity(intent) }
+                .onFailure { Timber.tag(loggerTag).w(it, "the updater page could not be opened") }
+        }.apply { name = "plotina-update-check"; isDaemon = true; start() }
+    }
+
+    /** Plain HttpURLConnection: no new dependency, and this only ever reads a small https document. */
+    fun fetch(context: Context, url: String): UpdateInfo? = runCatching {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        try {
+            connection.requestMethod = "GET"
+            connection.connectTimeout = 10_000
+            connection.readTimeout = 15_000
+            connection.instanceFollowRedirects = true
+            if (connection.responseCode != HttpURLConnection.HTTP_OK) {
+                Timber.tag(loggerTag).d("manifest HTTP %s", connection.responseCode)
+                return null
+            }
+            val body = connection.inputStream.bufferedReader().use { it.readText() }
+            UpdateInfo.fromJson(context, body)
+        } finally {
+            connection.disconnect()
+        }
+    }.onFailure { Timber.tag(loggerTag).w(it, "manifest fetch failed") }.getOrNull()
+}
diff --git a/app/src/main/kotlin/io/element/android/x/updater/PlotinaUpdateActivity.kt b/app/src/main/kotlin/io/element/android/x/updater/PlotinaUpdateActivity.kt
