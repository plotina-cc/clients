+++ b/app/src/test/kotlin/io/element/android/x/updater/PlotinaUpdateTest.kt
@@ -0,0 +1,57 @@
+/*
+ * Plotina: the in-app updater's versionCode comparison.
+ *
+ * Copyright (C) 2026 Plotina
+ *
+ * This program is free software: you can redistribute it and/or modify it under the terms of the
+ * GNU Affero General Public License as published by the Free Software Foundation, version 3.
+ */
+
+package io.element.android.x.updater
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+
+/**
+ * update-x.json carries the arm64 split's packaged versionCode, `base * 10 + 2`, while a phone may
+ * have installed either split, so installed codes arrive as `base * 10 + 1` or `base * 10 + 2`.
+ * The comparison drops the ABI digit from both sides: with the manifest's raw number once compared
+ * against a base code, every check answered "newer" and build .28 offered itself forever.
+ */
+class PlotinaUpdateTest {
+    // Base code of v26.10.1-plotina-x.28 under the tag formula: (2000+26)*100000 + 10*1000 + 28.
+    private val base = 202610028L
+
+    /** What update-x.json publishes for that build (aapt's arm64 number). */
+    private val arm64Code = base * 10 + 2
+
+    /** What an armv7 install of the same build reports. */
+    private val armv7Code = base * 10 + 1
+
+    @Test
+    fun `test the same build is not offered again after installing the arm64 split`() {
+        assertThat(PlotinaUpdate.isUpdateAvailable(arm64Code, PlotinaUpdate.baseCodeOf(arm64Code))).isFalse()
+    }
+
+    @Test
+    fun `test the same build is not offered again after installing the armv7 split`() {
+        assertThat(PlotinaUpdate.isUpdateAvailable(arm64Code, PlotinaUpdate.baseCodeOf(armv7Code))).isFalse()
+    }
+
+    @Test
+    fun `test the next build is offered`() {
+        val nextCode = (base + 1) * 10 + 2
+        assertThat(PlotinaUpdate.isUpdateAvailable(nextCode, base)).isTrue()
+    }
+
+    @Test
+    fun `test the next build is offered to an armv7 install`() {
+        val nextCode = (base + 1) * 10 + 2
+        assertThat(PlotinaUpdate.isUpdateAvailable(nextCode, PlotinaUpdate.baseCodeOf(armv7Code))).isTrue()
+    }
+
+    @Test
+    fun `test an older manifest is not offered`() {
+        assertThat(PlotinaUpdate.isUpdateAvailable((base - 1) * 10 + 2, base)).isFalse()
+    }
+}
diff --git a/app/src/test/kotlin/io/element/android/x/updater/PlotinaUpdaterScreenTest.kt b/app/src/test/kotlin/io/element/android/x/updater/PlotinaUpdaterScreenTest.kt
new file mode 100644
index 00000000..33eec197
--- /dev/null
+++ b/app/src/test/kotlin/io/element/android/x/updater/PlotinaUpdaterScreenTest.kt
@@ -0,0 +1,181 @@
+/*
+ * Plotina: the updater page renders each stage like Plotina Mobile's route, and the buttons wire
+ * to the right engine callbacks. Stateless screen, so the test feeds states instead of driving
+ * downloads. Assertions use the English string values: Robolectric runs in the default locale and
+ * the screen renders app/src/main/res/values/plotina_updater.xml.
+ *
+ * Copyright (C) 2026 Plotina
+ *
+ * This program is free software: you can redistribute it and/or modify it under the terms of the
+ * GNU Affero General Public License as published by the Free Software Foundation, version 3.
+ */
+
+@file:OptIn(ExperimentalTestApi::class)
+
+package io.element.android.x.updater
+
+import android.app.Application
+import androidx.activity.ComponentActivity
+import androidx.compose.ui.test.AndroidComposeUiTest
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.assertIsNotDisplayed
+import androidx.compose.ui.test.onNodeWithText
+import androidx.compose.ui.test.performClick
+import androidx.compose.ui.test.v2.runAndroidComposeUiTest
+import com.google.common.truth.Truth.assertThat
+import io.element.android.tests.testutils.EnsureNeverCalled
+import io.element.android.tests.testutils.robolectric.RobolectricTest
+import org.junit.Test
+import org.robolectric.annotation.Config
+
+// application = plain Application: with the merged app manifest in scope Robolectric would
+// otherwise build the real ElementXApplication (full DI graph) for a test that only needs a
+// blank Compose host.
+@Config(application = Application::class)
+class PlotinaUpdaterScreenTest : RobolectricTest() {
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `checking shows the spinner headline and nothing actionable`() = runAndroidComposeUiTest {
+        setScreen(UpdaterUiState.Checking)
+        // The AppBar title is the screen identity on every stage.
+        onNodeWithText("Check for updates").assertIsDisplayed()
+        onNodeWithText("Checking for updates…").assertIsDisplayed()
+        onNodeWithText("Download and install").assertDoesNotExist()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `available shows the version in a card, the notes, the size and the download button`() = runAndroidComposeUiTest {
+        val info = anUpdateInfo()
+        var downloaded = false
+        setScreen(UpdaterUiState.Available(info), onDownloadClick = { downloaded = true })
+        onNodeWithText("Update 26.10.1 available").assertIsDisplayed()
+        onNodeWithText(info.notes).assertIsDisplayed()
+        onNodeWithText("137.6 MB").assertIsDisplayed()
+        onNodeWithText("Download and install").performClick()
+        assertThat(downloaded).isTrue()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `available offers Later and calls back with it`() = runAndroidComposeUiTest {
+        var later = false
+        setScreen(UpdaterUiState.Available(anUpdateInfo()), onLaterClick = { later = true })
+        onNodeWithText("Later").performClick()
+        assertThat(later).isTrue()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `up to date names the installed version and offers no download`() = runAndroidComposeUiTest {
+        setScreen(UpdaterUiState.UpToDate(version = "26.10.1"))
+        onNodeWithText("No updates").assertIsDisplayed()
+        onNodeWithText("The latest version is installed (26.10.1)").assertIsDisplayed()
+        onNodeWithText("Download and install").assertDoesNotExist()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `downloading shows the percentage and a cancel`() = runAndroidComposeUiTest {
+        var canceled = false
+        setScreen(UpdaterUiState.Downloading(42), onCancelDownloadClick = { canceled = true })
+        onNodeWithText("Downloading…").assertIsDisplayed()
+        onNodeWithText("42%").assertIsDisplayed()
+        onNodeWithText("Cancel").performClick()
+        assertThat(canceled).isTrue()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `a failed check offers Retry and repeats the check`() = runAndroidComposeUiTest {
+        var retried = false
+        setScreen(
+            UpdaterUiState.Message(
+                text = "Could not check for updates: plotina.cc was unreachable. Try again later.",
+                retry = UpdaterUiState.Retry.Check,
+            ),
+            onRetryClick = { retried = true },
+        )
+        onNodeWithText("Retry").performClick()
+        assertThat(retried).isTrue()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `a message without a retry shows only Close`() = runAndroidComposeUiTest {
+        setScreen(UpdaterUiState.Message("Update installed. Restart Plotina X to finish."))
+        onNodeWithText("Retry").assertDoesNotExist()
+        onNodeWithText("Close").assertIsDisplayed()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `the permission stage opens the system settings`() = runAndroidComposeUiTest {
+        var opened = false
+        setScreen(UpdaterUiState.NeedPermission, onOpenSettingsClick = { opened = true })
+        onNodeWithText("Allow installing apps").assertIsDisplayed()
+        onNodeWithText("Open settings").performClick()
+        assertThat(opened).isTrue()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `verifying shows its headline without any buttons`() = runAndroidComposeUiTest {
+        setScreen(UpdaterUiState.Verifying)
+        onNodeWithText("Verifying the download…").assertIsDisplayed()
+        onNodeWithText("Cancel").assertDoesNotExist()
+        onNodeWithText("Close").assertDoesNotExist()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `installing confirms and offers Close`() = runAndroidComposeUiTest {
+        var closed = false
+        setScreen(UpdaterUiState.Installing, onCloseClick = { closed = true })
+        onNodeWithText("Confirm the installation in the system dialog…").assertIsDisplayed()
+        onNodeWithText("Close").performClick()
+        assertThat(closed).isTrue()
+    }
+
+    @Test
+    fun `prettySize formats bytes for the card`() {
+        assertThat(prettySize(137_608_493L)).isEqualTo("137.6 MB")
+        assertThat(prettySize(64 * 1024)).isEqualTo("66 kB")
+        assertThat(prettySize(512)).isEqualTo("512 B")
+    }
+}
+
+private fun AndroidComposeUiTest<ComponentActivity>.setScreen(
+    state: UpdaterUiState,
+    onBackClick: () -> Unit = EnsureNeverCalled(),
+    onDownloadClick: () -> Unit = EnsureNeverCalled(),
+    onLaterClick: () -> Unit = EnsureNeverCalled(),
+    onCancelDownloadClick: () -> Unit = EnsureNeverCalled(),
+    onOpenSettingsClick: () -> Unit = EnsureNeverCalled(),
+    onRetryClick: () -> Unit = EnsureNeverCalled(),
+    onCloseClick: () -> Unit = EnsureNeverCalled(),
+) {
+    setContent {
+        PlotinaUpdaterScreen(
+            state = state,
+            onBackClick = onBackClick,
+            onDownloadClick = onDownloadClick,
+            onLaterClick = onLaterClick,
+            onCancelDownloadClick = onCancelDownloadClick,
+            onOpenSettingsClick = onOpenSettingsClick,
+            onRetryClick = onRetryClick,
+            onCloseClick = onCloseClick,
+        )
+    }
+}
+
+private fun anUpdateInfo() = UpdateInfo(
+    packageName = "cc.plotina.x",
+    versionName = "26.10.1",
+    versionCode = 2026100302L,
+    apkUrl = "https://plotina.cc/dl/Plotina-X.apk",
+    sha256 = "0".repeat(64),
+    size = 137_608_493L,
+    notes = "Fixes and improvements.",
+)
