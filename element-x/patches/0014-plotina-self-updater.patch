+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  ~ Plotina: строки встроенного обновителя (io.element.android.x.updater).
+  -->
+<resources>
+    <string name="plotina_update_screen_title">"Проверка обновлений"</string>
+    <string name="plotina_update_back">"Назад"</string>
+    <string name="plotina_update_checking">"Проверка обновлений…"</string>
