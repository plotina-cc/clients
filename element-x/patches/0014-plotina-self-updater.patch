+/*
+ * Plotina: the consolidated «Обновления» page — check action on top, channel selection beneath,
+ * like Plotina Mobile's Updates tab. Stateless screen, so the test feeds channel values and
+ * captures callbacks instead of driving the store. Assertions use the English string values:
+ * Robolectric runs in the default locale and the screen renders
+ * app/src/main/res/values/plotina_updater.xml.
+ *
+ * Copyright (C) 2026 Plotina
+ *
+ * This program is free software: you can redistribute it and/or modify it under the terms of the
+ * GNU Affero General Public License as published by the Free Software Foundation, version 3.
+ */
+
+@file:OptIn(ExperimentalTestApi::class)
+
+package io.element.android.x.updater
+
+import android.app.Application
+import androidx.activity.ComponentActivity
+import androidx.compose.ui.test.AndroidComposeUiTest
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.onNodeWithText
+import androidx.compose.ui.test.performClick
+import androidx.compose.ui.test.v2.runAndroidComposeUiTest
+import com.google.common.truth.Truth.assertThat
+import io.element.android.tests.testutils.EnsureNeverCalled
+import io.element.android.tests.testutils.EnsureNeverCalledWithParam
+import io.element.android.tests.testutils.robolectric.RobolectricTest
+import org.junit.Test
+import org.robolectric.annotation.Config
+
+// application = plain Application: as in PlotinaUpdaterScreenTest, the test only needs a blank
+// Compose host, not the ElementXApplication DI graph.
+@Config(application = Application::class)
+class PlotinaUpdatesScreenTest : RobolectricTest() {
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `the page shows the check action above the channel section`() = runAndroidComposeUiTest {
+        setScreen(channel = PlotinaUpdate.UpdateChannel.STABLE)
+        onNodeWithText("Updates").assertIsDisplayed() // AppBar title
+        onNodeWithText("Check for updates").assertIsDisplayed()
+        onNodeWithText("Installed version: 26.10.1").assertIsDisplayed()
+        onNodeWithText("Update channel").assertIsDisplayed()
+        onNodeWithText("Stable").assertIsDisplayed()
+        onNodeWithText("Dev").assertIsDisplayed()
+        // Stable by default: the dev warning belongs to the dev choice only.
+        onNodeWithText("Dev builds test the next version early", substring = true).assertDoesNotExist()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `the check action opens the updater flow`() = runAndroidComposeUiTest {
+        var checked = false
+        setScreen(channel = PlotinaUpdate.UpdateChannel.STABLE, onCheckClick = { checked = true })
+        onNodeWithText("Check for updates").performClick()
+        assertThat(checked).isTrue()
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `choosing Dev is called back with the dev channel`() = runAndroidComposeUiTest {
+        var selected: PlotinaUpdate.UpdateChannel? = null
+        setScreen(channel = PlotinaUpdate.UpdateChannel.STABLE, onChannelSelected = { selected = it })
+        onNodeWithText("Dev").performClick()
+        assertThat(selected).isEqualTo(PlotinaUpdate.UpdateChannel.DEV)
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `choosing Stable is called back with the stable channel`() = runAndroidComposeUiTest {
+        var selected: PlotinaUpdate.UpdateChannel? = null
+        setScreen(channel = PlotinaUpdate.UpdateChannel.DEV, onChannelSelected = { selected = it })
+        onNodeWithText("Stable").performClick()
+        assertThat(selected).isEqualTo(PlotinaUpdate.UpdateChannel.STABLE)
+    }
+
+    @Config(qualifiers = "h1280dp")
+    @Test
+    fun `the dev channel warns on the page itself`() = runAndroidComposeUiTest {
+        setScreen(channel = PlotinaUpdate.UpdateChannel.DEV)
+        // The warning renders exactly for the stored channel: this is what the Activity shows
+        // right after a tap, the radios and the card share the same `channel` argument.
+        onNodeWithText("Dev builds test the next version early", substring = true).assertIsDisplayed()
+        onNodeWithText("Early builds from GitHub (dev-latest release)").assertIsDisplayed()
+    }
+}
+
+private fun AndroidComposeUiTest<ComponentActivity>.setScreen(
+    channel: PlotinaUpdate.UpdateChannel,
+    onBackClick: () -> Unit = EnsureNeverCalled(),
+    onCheckClick: () -> Unit = EnsureNeverCalled(),
+    onChannelSelected: (PlotinaUpdate.UpdateChannel) -> Unit = EnsureNeverCalledWithParam(),
+) {
+    setContent {
+        PlotinaUpdatesScreen(
+            channel = channel,
+            installedVersion = "26.10.1",
+            onBackClick = onBackClick,
+            onCheckClick = onCheckClick,
+            onChannelSelected = onChannelSelected,
+        )
+    }
+}
