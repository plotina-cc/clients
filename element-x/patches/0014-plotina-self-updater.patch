@@ -0,0 +1,85 @@
+/*
+ * Plotina: the update manifest's JSON contract, including the dev feed's devBuild.
+ *
+ * org.json.JSONObject is Android platform code: on a plain JVM unit test it is a "Stub!" shell,
+ * so the parsing that guards every update - stable and dev alike - runs under Robolectric here.
+ *
+ * Copyright (C) 2026 Plotina
+ *
+ * This program is free software: you can redistribute it and/or modify it under the terms of the
+ * GNU Affero General Public License as published by the Free Software Foundation, version 3.
+ */
+
+package io.element.android.x.updater
+
+import android.app.Application
+import android.content.Context
+import com.google.common.truth.Truth.assertThat
+import io.element.android.tests.testutils.robolectric.RobolectricTest
+import io.mockk.every
+import io.mockk.mockk
+import org.junit.Test
+import org.robolectric.annotation.Config
+
+@Config(application = Application::class)
+class PlotinaUpdateManifestTest : RobolectricTest() {
+    // Base code of v26.10.1-plotina-x.30; the arm64 number is what the dev feed publishes.
+    private val base = 202610030L
+    private val arm64Code = base * 10 + 2
+
+    private val aReleaseContext = mockk<Context> { every { packageName } returns "cc.plotina.x" }
+
+    @Test
+    fun `fromJson reads devBuild from the dev manifest`() {
+        val info = UpdateInfo.fromJson(aReleaseContext, aDevManifestJson())
+        assertThat(info).isNotNull()
+        assertThat(info!!.devBuild).isEqualTo(1)
+        assertThat(info.versionCode).isEqualTo(arm64Code)
+        assertThat(info.versionName).isEqualTo("26.10.1-dev.1")
+        assertThat(info.apkUrl).startsWith("https://github.com/")
+    }
+
+    @Test
+    fun `fromJson defaults devBuild to 0 for the stable contract`() {
+        val raw = aDevManifestJson().replace("\"devBuild\":1,", "")
+        val info = UpdateInfo.fromJson(aReleaseContext, raw)
+        assertThat(info).isNotNull()
+        assertThat(info!!.devBuild).isEqualTo(0)
+    }
+
+    @Test
+    fun `fromJson rejects a devBuild that is not a small number`() {
+        assertThat(UpdateInfo.fromJson(aReleaseContext, aDevManifestJson(devBuild = -1))).isNull()
+        assertThat(UpdateInfo.fromJson(aReleaseContext, aDevManifestJson(devBuild = 1000))).isNull()
+    }
+
+    @Test
+    fun `toJson carries devBuild for a dev manifest and drops it for a stable one`() {
+        val dev = UpdateInfo.fromJson(aReleaseContext, aDevManifestJson())!!
+        // The daily check hands this exact string to the Activity, where it is re-parsed: the
+        // round trip must not lose the dev number.
+        assertThat(dev.toJson()).contains("\"devBuild\":1")
+        val round = UpdateInfo.fromJson(aReleaseContext, dev.toJson())
+        assertThat(round).isEqualTo(dev)
+
+        val stable = dev.copy(devBuild = 0)
+        assertThat(stable.toJson()).doesNotContain("devBuild")
+        assertThat(UpdateInfo.fromJson(aReleaseContext, stable.toJson())).isEqualTo(stable)
+    }
+
+    @Test
+    fun `a dev manifest is still held to the package and https rules`() {
+        // The dev feed lives on GitHub; fromJson only ever accepts https and our own package, no
+        // matter which channel fetched it.
+        val wrongPackage = aDevManifestJson().replace("\"package\":\"cc.plotina.x\"", "\"package\":\"com.evil.app\"")
+        assertThat(UpdateInfo.fromJson(aReleaseContext, wrongPackage)).isNull()
+        val plainHttp = aDevManifestJson().replace("https://", "http://")
+        assertThat(UpdateInfo.fromJson(aReleaseContext, plainHttp)).isNull()
+    }
+
+    private fun aDevManifestJson(devBuild: Int = 1) =
+        "{\"client\":\"x\",\"package\":\"cc.plotina.x\",\"versionName\":\"26.10.1-dev.1\"," +
+            "\"versionCode\":$arm64Code,\"devBuild\":$devBuild," +
+            "\"apkUrl\":\"https://github.com/plotina-cc/clients/releases/download/dev-latest/Plotina-X.apk\"," +
+            "\"sha256\":\"${"0".repeat(64)}\",\"size\":137608493,\"notes\":\"Dev.\"}"
+}
diff --git a/app/src/test/kotlin/io/element/android/x/updater/PlotinaUpdateTest.kt b/app/src/test/kotlin/io/element/android/x/updater/PlotinaUpdateTest.kt
new file mode 100644
index 00000000..93509097
--- /dev/null
+++ b/app/src/test/kotlin/io/element/android/x/updater/PlotinaUpdateTest.kt
@@ -0,0 +1,188 @@
+/*
+ * Plotina: the in-app updater's versionCode comparison and update-channel rules.
+ *
+ * Copyright (C) 2026 Plotina
+ *
+ * This program is free software: you can redistribute it and/or modify it under the terms of the
+ * GNU Affero General Public License as published by the Free Software Foundation, version 3.
+ */
+
+package io.element.android.x.updater
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+
+/**
+ * update-x.json carries the arm64 split's packaged versionCode, `base * 10 + 2`, while a phone may
+ * have installed either split, so installed codes arrive as `base * 10 + 1` or `base * 10 + 2`.
+ * The comparison drops the ABI digit from both sides: with the manifest's raw number once compared
+ * against a base code, every check answered "newer" and build .28 offered itself forever.
+ *
+ * The dev channel adds one rule on top: a dev release keeps the base code of the stable it is
+ * based on (`v26.10.1-plotina-x.30-dev.1` is still base 202610030) and carries its dev number in
+ * the manifest's `devBuild` and in the installed versionName's `-dev.M` suffix. An equal base code
+ * only moves forward through devBuild, and only a dev manifest ever has one.
+ */
+class PlotinaUpdateTest {
+    // Base code of v26.10.1-plotina-x.28 under the tag formula: (2000+26)*100000 + 10*1000 + 28.
+    private val base = 202610028L
+
+    /** What update-x.json publishes for that build (aapt's arm64 number). */
+    private val arm64Code = base * 10 + 2
+
+    /** What an armv7 install of the same build reports. */
+    private val armv7Code = base * 10 + 1
+
+    @Test
+    fun `test the same build is not offered again after installing the arm64 split`() {
+        assertThat(PlotinaUpdate.isUpdateAvailable(arm64Code, PlotinaUpdate.baseCodeOf(arm64Code))).isFalse()
+    }
+
+    @Test
+    fun `test the same build is not offered again after installing the armv7 split`() {
+        assertThat(PlotinaUpdate.isUpdateAvailable(arm64Code, PlotinaUpdate.baseCodeOf(armv7Code))).isFalse()
+    }
+
+    @Test
+    fun `test the next build is offered`() {
+        val nextCode = (base + 1) * 10 + 2
+        assertThat(PlotinaUpdate.isUpdateAvailable(nextCode, base)).isTrue()
+    }
+
+    @Test
+    fun `test the next build is offered to an armv7 install`() {
+        val nextCode = (base + 1) * 10 + 2
+        assertThat(PlotinaUpdate.isUpdateAvailable(nextCode, PlotinaUpdate.baseCodeOf(armv7Code))).isTrue()
+    }
+
+    @Test
+    fun `test an older manifest is not offered`() {
+        assertThat(PlotinaUpdate.isUpdateAvailable((base - 1) * 10 + 2, base)).isFalse()
+    }
+
+    // --- channel selection ---------------------------------------------------------------------
+
+    @Test
+    fun `the stable channel reads the plotina cc feed`() {
+        assertThat(PlotinaUpdate.manifestUrlFor(PlotinaUpdate.UpdateChannel.STABLE))
+            .isEqualTo("https://plotina.cc/dl/update-x.json")
+    }
+
+    @Test
+    fun `the dev channel reads the GitHub dev-latest feed`() {
+        // Static URL: tag dev-latest is a moving target whose assets are overwritten by hand, so
+        // the app never needs to know a version number to find the feed.
+        assertThat(PlotinaUpdate.manifestUrlFor(PlotinaUpdate.UpdateChannel.DEV))
+            .isEqualTo("https://github.com/plotina-cc/clients/releases/download/dev-latest/update-x-dev.json")
+    }
+
+    @Test
+    fun `the two channels are distinct URLs`() {
+        assertThat(PlotinaUpdate.manifestUrlFor(PlotinaUpdate.UpdateChannel.DEV))
+            .isNotEqualTo(PlotinaUpdate.MANIFEST_URL)
+    }
+
+    // --- dev build numbers riding in the versionName ---------------------------------------------
+
+    @Test
+    fun `a stable versionName carries devBuild 0`() {
+        assertThat(PlotinaUpdate.devBuildOf("26.10.1")).isEqualTo(0)
+        assertThat(PlotinaUpdate.isDevVersionName("26.10.1")).isFalse()
+    }
+
+    @Test
+    fun `a dev versionName carries its dev build number`() {
+        assertThat(PlotinaUpdate.devBuildOf("26.10.1-dev.1")).isEqualTo(1)
+        assertThat(PlotinaUpdate.devBuildOf("26.10.1-dev.12")).isEqualTo(12)
+        assertThat(PlotinaUpdate.isDevVersionName("26.10.1-dev.1")).isTrue()
+    }
+
+    @Test
+    fun `a versionName that only looks like a dev one is not dev`() {
+        assertThat(PlotinaUpdate.devBuildOf("26.10.1-dev")).isEqualTo(0)
+        assertThat(PlotinaUpdate.devBuildOf("26.10.1-dev.x")).isEqualTo(0)
+        assertThat(PlotinaUpdate.devBuildOf("dev.1")).isEqualTo(0)
+        assertThat(PlotinaUpdate.isDevVersionName("26.10.1-dev")).isFalse()
+    }
+
+    // --- dev-to-dev and dev-over-stable comparison ----------------------------------------------
+
+    @Test
+    fun `the dev feed offers a dev build over the stable it is based on`() {
+        // Same base code as the installed stable: AOSP's checkDowngrade only rejects *lower*
+        // versionCodes, so the equal code installs over it with the data intact.
+        assertThat(PlotinaUpdate.isUpdateAvailable(arm64Code, 1, base, 0)).isTrue()
+    }
+
+    @Test
+    fun `a newer dev build is offered over an older dev build`() {
+        assertThat(PlotinaUpdate.isUpdateAvailable(arm64Code, 2, base, 1)).isTrue()
+    }
+
+    @Test
+    fun `the very same dev build is not offered again`() {
+        assertThat(PlotinaUpdate.isUpdateAvailable(arm64Code, 1, base, 1)).isFalse()
+        assertThat(PlotinaUpdate.isUpdateAvailable(armv7Code, 1, base, 1)).isFalse()
+    }
+
+    @Test
+    fun `a dev manifest never rolls an install back to an older base`() {
+        // A dev build must be based on the *latest published* stable - CI enforces the tag shape,
+        // and the comparison protects users either way: an equal-base offer never wins over a
+        // greater base...
+        val greaterBase = (base + 1) * 10 + 2
+        assertThat(PlotinaUpdate.isUpdateAvailable(greaterBase, 9, base, 0)).isTrue()
+        // ...and a smaller base is never offered, however big its devBuild claims to be.
+        assertThat(PlotinaUpdate.isUpdateAvailable(arm64Code - 10, 9, base, 0)).isFalse()
+    }
+
+    @Test
+    fun `a stable manifest does not bump a same-base dev install`() {
+        // Stable .28 and a dev .28-dev.N share the base code: while the dev feed is the newest
+        // thing out there, the stable feed offers nothing to a dev install.
+        assertThat(PlotinaUpdate.isUpdateAvailable(arm64Code, 0, base, 1)).isFalse()
+    }
+
+    @Test
+    fun `a newer stable release is offered over a dev install`() {
+        // The way back to stable: the next stable has a greater base, so the normal path takes it
+        // and data is preserved - same package id, same signing key.
+        val nextStable = (base + 1) * 10 + 2
+        assertThat(PlotinaUpdate.isUpdateAvailable(nextStable, 0, base, 1)).isTrue()
+    }
+
+    // --- passive stable: what the page shows while no stable outranks the dev install ------------
+
+    @Test
+    fun `a dev install on the stable channel with nothing newer is the passive case`() {
+        assertThat(PlotinaUpdate.isPassiveStable(
+            channel = PlotinaUpdate.UpdateChannel.STABLE, installedIsDev = true, updateAvailable = false,
+        )).isTrue()
+    }
+
+    @Test
+    fun `a dev install on the dev channel is not passive`() {
+        // There the answer is a plain UpToDate: the dev feed is what the user asked to follow.
+        assertThat(PlotinaUpdate.isPassiveStable(
+            channel = PlotinaUpdate.UpdateChannel.DEV, installedIsDev = true, updateAvailable = false,
+        )).isFalse()
+    }
+
+    @Test
+    fun `a passive message never hides a real update`() {
+        assertThat(PlotinaUpdate.isPassiveStable(
+            channel = PlotinaUpdate.UpdateChannel.STABLE, installedIsDev = true, updateAvailable = true,
+        )).isFalse()
+    }
+
+    @Test
+    fun `a stable install is never told about waiting for stable`() {
+        assertThat(PlotinaUpdate.isPassiveStable(
+            channel = PlotinaUpdate.UpdateChannel.STABLE, installedIsDev = false, updateAvailable = false,
+        )).isFalse()
+    }
+
+    // --- manifest JSON contract ------------------------------------------------------------------
+    // The parsing lives in PlotinaUpdateManifestTest: org.json.JSONObject is Android code, so it
+    // needs the Robolectric runtime rather than a plain JVM unit test.
+}
diff --git a/app/src/test/kotlin/io/element/android/x/updater/PlotinaUpdaterScreenTest.kt b/app/src/test/kotlin/io/element/android/x/updater/PlotinaUpdaterScreenTest.kt
