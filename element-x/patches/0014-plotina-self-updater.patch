--- /dev/null
+++ b/app/src/main/kotlin/io/element/android/x/updater/PlotinaUpdateActivity.kt
@@ -0,0 +1,414 @@
+/*
+ * Plotina: the in-app updater's screen host.
+ *
+ * The engine is deliberately untouched from the first release of the updater: HttpURLConnection
+ * for the manifest, DownloadManager for the APK, PackageInstaller for the install, sha256 + size
+ * verification before the installer ever sees a byte, and the "install unknown apps" permission
+ * when Android asks for it. Only the presentation changed with .30: the AlertDialogs became the
+ * full-screen PlotinaUpdaterPage-like page (PlotinaUpdaterScreen.kt) so the updater looks like the
+ * one in Plotina Mobile instead of a stack of dialogs over the app.
+ *
+ * Copyright (C) 2026 Plotina
+ *
+ * This program is free software: you can redistribute it and/or modify it under the terms of the
+ * GNU Affero General Public License as published by the Free Software Foundation, version 3.
+ */
+
+package io.element.android.x.updater
+
+import android.app.DownloadManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageInstaller
+import android.net.Uri
+import android.os.Build
+import android.os.Bundle
+import android.provider.Settings
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.activity.enableEdgeToEdge
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.core.content.ContextCompat
+import androidx.lifecycle.lifecycleScope
+import io.element.android.compound.colors.SemanticColorsLightDark
+import io.element.android.libraries.architecture.bindings
+import io.element.android.libraries.designsystem.theme.ElementThemeApp
+import io.element.android.x.R
+import io.element.android.x.di.AppBindings
+import java.io.File
+import java.security.MessageDigest
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import timber.log.Timber
+
+/** One row of a DownloadManager query, read before the cursor closes. */
+private data class DownloadRow(val status: Int, val done: Long, val total: Long)
+
+/**
+ * Reached two ways: the «Проверить обновления» row at the root of Settings (always shows a result),
+ * and the silent once-a-day check in [PlotinaUpdate.onAppStart], which only starts this Activity
+ * when the manifest really is newer and hands over its own copy through
+ * [PlotinaUpdate.EXTRA_MANIFEST]. A debug build can point it at a local manifest with
+ * [PlotinaUpdate.EXTRA_MANIFEST_URL] (see PlotinaUpdate.kt).
+ *
+ * The page lives on its own: opening the updater navigates the user away from Settings, the same
+ * way Plotina Mobile pushes its updater route.
+ */
+class PlotinaUpdateActivity : ComponentActivity() {
+    private lateinit var appBindings: AppBindings
+    private var uiState by mutableStateOf<UpdaterUiState>(UpdaterUiState.Checking)
+    private var pendingInfo: UpdateInfo? = null
+    private var downloadId: Long = -1L
+    private var apkFile: File? = null
+    private var pollJob: Job? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        // The app module's MainActivity does the same: edge-to-edge, with the Scaffold's TopAppBar
+        // consuming the status-bar inset. Without it the opaque theme bars would fight the page.
+        enableEdgeToEdge()
+        // The app graph lives on the Application, so the updater can use the very same theme and
+        // preferences the rest of the app renders with. See MainActivity.MainContent.
+        appBindings = bindings()
+        handleIntent(intent)
+        setContent {
+            UpdaterTheme {
+                PlotinaUpdaterScreen(
+                    state = uiState,
+                    onBackClick = ::finish,
+                    onDownloadClick = { (uiState as? UpdaterUiState.Available)?.info?.let(::confirmAndDownload) },
+                    onLaterClick = ::finish,
+                    onCancelDownloadClick = ::cancelDownload,
+                    onOpenSettingsClick = ::openInstallPermissionSettings,
+                    onRetryClick = ::retry,
+                    onCloseClick = ::finish,
+                )
+            }
+        }
+    }
+
+    override fun onNewIntent(intent: Intent) {
+        super.onNewIntent(intent)
+        setIntent(intent)
+        handleIntent(intent)
+    }
+
+    override fun onResume() {
+        super.onResume()
+        // The user may have just allowed "install unknown apps" in the system settings we opened.
+        if (uiState == UpdaterUiState.NeedPermission && mayInstallPackages()) {
+            pendingInfo?.let { startDownload(it) }
+        }
+    }
+
+    private fun handleIntent(intent: Intent) {
+        if (intent.getBooleanExtra(EXTRA_INSTALL_RESULT, false)) {
+            onInstallResult(intent)
+            return
+        }
+        // While one flow is visibly running, a repeat start just brings it forward. Checking is
+        // deliberately absent: it is the state a fresh Activity opens in, and returning early on it
+        // here would leave the page "Checking" forever without ever looking at this intent.
+        if (uiState is UpdaterUiState.Downloading || uiState == UpdaterUiState.Verifying ||
+            uiState == UpdaterUiState.Installing || uiState == UpdaterUiState.NeedPermission
+        ) {
+            return
+        }
+        val passed = intent.getStringExtra(PlotinaUpdate.EXTRA_MANIFEST)
+        if (passed != null) {
+            val info = UpdateInfo.fromJson(this, passed)
+            if (info != null) showResult(info) else check()
+        } else {
+            check()
+        }
+    }
+
+    private fun check() {
+        uiState = UpdaterUiState.Checking
+        lifecycleScope.launch {
+            val url = intent.getStringExtra(PlotinaUpdate.EXTRA_MANIFEST_URL) ?: PlotinaUpdate.MANIFEST_URL
+            val info = withContext(Dispatchers.IO) { PlotinaUpdate.fetch(this@PlotinaUpdateActivity, url) }
+            if (info == null) {
+                uiState = UpdaterUiState.Message(
+                    text = getString(R.string.plotina_update_error_check),
+                    retry = UpdaterUiState.Retry.Check,
+                )
+            } else {
+                showResult(info)
+            }
+        }
+    }
+
+    private fun showResult(info: UpdateInfo) {
+        pendingInfo = info
+        uiState = if (PlotinaUpdate.isUpdateAvailable(this, info)) {
+            UpdaterUiState.Available(info)
+        } else {
+            UpdaterUiState.UpToDate(PlotinaUpdate.installedVersionName(this))
+        }
+    }
+
+    /** Which action the «Повторить» button repeats: re-read the manifest, or re-run the download. */
+    private fun retry() {
+        when (val state = uiState) {
+            is UpdaterUiState.Message -> when (state.retry) {
+                UpdaterUiState.Retry.Check -> check()
+                UpdaterUiState.Retry.Download -> pendingInfo?.let(::confirmAndDownload)
+                UpdaterUiState.Retry.None -> Unit
+            }
+            else -> Unit
+        }
+    }
+
+    private fun confirmAndDownload(info: UpdateInfo) {
+        if (!mayInstallPackages()) {
+            // Ask before the bytes move: the installer is the only dead end a user should hit.
+            uiState = UpdaterUiState.NeedPermission
+            return
+        }
+        startDownload(info)
+    }
+
+    private fun startDownload(info: UpdateInfo) {
+        val file = File(getExternalFilesDir(null), "plotina-x-${info.versionCode}.apk")
+        runCatching { file.delete() }
+        val request = DownloadManager.Request(Uri.parse(info.apkUrl))
+            .setTitle(getString(R.string.app_name))
+            .setDescription(info.notes.ifBlank { info.versionName })
+            .setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE)
+            .setDestinationUri(Uri.fromFile(file))
+            .setAllowedOverMetered(true)
+            .setAllowedOverRoaming(true)
+        val manager = ContextCompat.getSystemService(this, DownloadManager::class.java)
+        if (manager == null) {
+            uiState = UpdaterUiState.Message(
+                text = getString(R.string.plotina_update_error_download),
+                retry = UpdaterUiState.Retry.Download,
+            )
+            return
+        }
+        downloadId = manager.enqueue(request)
+        apkFile = file
+        uiState = UpdaterUiState.Downloading(0)
+        pollDownload(info)
+    }
+
+    /**
+     * DownloadManager's completion broadcast would need an exported receiver on recent Android, so
+     * the state is polled instead while this page is open. The download itself belongs to
+     * DownloadManager and keeps running, with its own notification, if the page goes away.
+     */
+    private fun pollDownload(info: UpdateInfo) {
+        pollJob?.cancel()
+        pollJob = lifecycleScope.launch {
+            val manager = ContextCompat.getSystemService(this@PlotinaUpdateActivity, DownloadManager::class.java)
+                ?: return@launch
+            while (isActive) {
+                // One query, one read: status and progress from the same row. A download that is
+                // gone again (cancelled, evicted) yields no row, and that is a failure to show -
+                // not a Cursor ISE to crash on.
+                val row = manager.query(DownloadManager.Query().setFilterById(downloadId)).use { cursor ->
+                    if (!cursor.moveToFirst()) {
+                        null
+                    } else {
+                        DownloadRow(
+                            status = cursor.getInt(cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_STATUS)),
+                            done = cursor.getLong(cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_BYTES_DOWNLOADED_SO_FAR)),
+                            total = cursor.getLong(cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_TOTAL_SIZE_BYTES)),
+                        )
+                    }
+                }
+                when (row?.status) {
+                    DownloadManager.STATUS_SUCCESSFUL -> {
+                        verifyAndInstall(info)
+                        return@launch
+                    }
+                    DownloadManager.STATUS_FAILED, null -> {
+                        uiState = UpdaterUiState.Message(
+                            text = getString(R.string.plotina_update_error_download),
+                            retry = UpdaterUiState.Retry.Download,
+                        )
+                        return@launch
+                    }
+                    else -> {
+                        val percent = if (row.total > 0) ((row.done * 100) / row.total).toInt().coerceIn(0, 100) else 0
+                        uiState = UpdaterUiState.Downloading(percent)
+                    }
+                }
+                delay(400)
+            }
+        }
+    }
+
+    private fun cancelDownload() {
+        // Stop polling first: the removed download would otherwise answer its last query with the
+        // "vanished" row and show an error over the state we are restoring.
+        pollJob?.cancel()
+        ContextCompat.getSystemService(this, DownloadManager::class.java)?.remove(downloadId)
+        pendingInfo?.let { uiState = UpdaterUiState.Available(it) }
+    }
+
+    private fun verifyAndInstall(info: UpdateInfo) {
+        val file = apkFile ?: return
+        lifecycleScope.launch {
+            uiState = UpdaterUiState.Verifying
+            val matches = withContext(Dispatchers.IO) {
+                runCatching { file.length() == info.size && sha256Of(file) == info.sha256 }.getOrDefault(false)
+            }
+            if (!matches) {
+                Timber.tag("PlotinaUpdate").w("checksum or size mismatch for %s", file.name)
+                file.delete()
+                uiState = UpdaterUiState.Message(
+                    text = getString(R.string.plotina_update_error_mismatch),
+                    retry = UpdaterUiState.Retry.Download,
+                )
+                return@launch
+            }
+            if (!mayInstallPackages()) {
+                uiState = UpdaterUiState.NeedPermission
+                return@launch
+            }
+            launchInstaller(info, file)
+        }
+    }
+
+    private fun launchInstaller(info: UpdateInfo, file: File) {
+        lifecycleScope.launch(Dispatchers.IO) {
+            val outcome = runCatching<Unit> {
+                val installer = packageManager.packageInstaller
+                val params = PackageInstaller.SessionParams(PackageInstaller.SessionParams.MODE_FULL_INSTALL).apply {
+                    setSize(info.size)
+                    setAppPackageName(packageName)
+                }
+                val sessionId = installer.createSession(params)
+                installer.openSession(sessionId).use { session ->
+                    session.openWrite("base.apk", 0, info.size).use { target ->
+                        file.inputStream().use { source -> source.copyTo(target, DEFAULT_BUFFER_SIZE * 8) }
+                        session.fsync(target)
+                    }
+                    val flags = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                        // The installer writes its result into this intent, so it must be mutable.
+                        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_MUTABLE
+                    } else {
+                        PendingIntent.FLAG_UPDATE_CURRENT
+                    }
+                    val callback = PendingIntent.getActivity(
+                        this@PlotinaUpdateActivity,
+                        sessionId,
+                        Intent(this@PlotinaUpdateActivity, PlotinaUpdateActivity::class.java)
+                            .putExtra(EXTRA_INSTALL_RESULT, true),
+                        flags,
+                    )
+                    session.commit(callback.intentSender)
+                }
+            }
+            withContext(Dispatchers.Main) {
+                if (outcome.isSuccess) {
+                    uiState = UpdaterUiState.Installing
+                } else {
+                    Timber.tag("PlotinaUpdate").e(outcome.exceptionOrNull(), "install session failed")
+                    uiState = UpdaterUiState.Message(
+                        text = getString(R.string.plotina_update_error_install, ""),
+                        retry = UpdaterUiState.Retry.Download,
+                    )
+                }
+            }
+        }
+    }
+
+    private fun onInstallResult(result: Intent) {
+        val status = result.getIntExtra(PackageInstaller.EXTRA_STATUS, PackageInstaller.STATUS_FAILURE)
+        if (status == PackageInstaller.STATUS_PENDING_USER_ACTION) {
+            // The installer wants a confirmation screen of its own, and posts the Intent that opens
+            // it into our callback Intent under EXTRA_INTENT: nobody else may start it, so without
+            // this hop the install would just hang. (PackageInstaller has no public constant here.)
+            @Suppress("DEPRECATION")
+            val confirm = result.getParcelableExtra<Intent>(Intent.EXTRA_INTENT)
+            if (confirm != null) {
+                runCatching { startActivity(confirm) }
+                    .onFailure { Timber.tag("PlotinaUpdate").w(it, "installer confirmation did not open") }
+                uiState = UpdaterUiState.Installing
+                return
+            }
+        }
+        apkFile?.delete()
+        uiState = when (status) {
+            PackageInstaller.STATUS_SUCCESS -> UpdaterUiState.Message(getString(R.string.plotina_update_installed))
+            else -> UpdaterUiState.Message(
+                text = getString(
+                    R.string.plotina_update_error_install,
+                    result.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE).orEmpty(),
+                ),
+                retry = UpdaterUiState.Retry.Download,
+            )
+        }
+    }
+
+    /**
+     * Whether this app may hand packages to the installer. Below API 26 the permission is the
+     * global "unknown sources" switch and there is no per-app screen to open: assume yes and let
+     * the installer itself prompt, the pre-Android-8 way.
+     */
+    private fun mayInstallPackages(): Boolean =
+        Build.VERSION.SDK_INT < Build.VERSION_CODES.O || packageManager.canRequestPackageInstalls()
+
+    private fun openInstallPermissionSettings() {
+        val intent = Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, Uri.fromParts("package", packageName, null))
+        runCatching { startActivity(intent) }.onFailure {
+            // Some OEM builds refuse the direct settings screen; the app's page always opens.
+            runCatching {
+                startActivity(
+                    Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.fromParts("package", packageName, null)),
+                )
+            }
+        }
+    }
+
+    /**
+     * The app's own theme wrapper, exactly as `MainActivity` uses it: Compound's colours and the
+     * user's light/dark preference from the preferences store. A bare `MaterialTheme` here was the
+     * bug - a light page with the default purple palette over a dark app.
+     */
+    @Composable
+    private fun UpdaterTheme(content: @Composable () -> Unit) {
+        val colors by remember {
+            appBindings.enterpriseService().semanticColorsFlow(sessionId = null)
+        }.collectAsState(SemanticColorsLightDark.default)
+        ElementThemeApp(
+            appPreferencesStore = appBindings.preferencesStore(),
+            featureFlagService = appBindings.featureFlagService(),
+            compoundLight = colors.light,
+            compoundDark = colors.dark,
+            buildMeta = appBindings.buildMeta(),
+            content = content,
+        )
+    }
+
+    companion object {
+        /** Marker for the PendingIntent the installer commits with. */
+        const val EXTRA_INSTALL_RESULT = "plotina_install_result"
+
+        private fun sha256Of(file: File): String {
+            val digest = MessageDigest.getInstance("SHA-256")
+            file.inputStream().use { input ->
+                val buffer = ByteArray(DEFAULT_BUFFER_SIZE * 8)
+                while (true) {
+                    val read = input.read(buffer)
+                    if (read < 0) break
+                    digest.update(buffer, 0, read)
+                }
+            }
+            return digest.digest().joinToString("") { "%02x".format(it) }
+        }
+    }
+}
