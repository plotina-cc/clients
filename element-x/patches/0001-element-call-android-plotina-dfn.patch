+package io.element.android.call.impl.rtc.media
+
+import androidx.annotation.Keep
+import timber.log.Timber
+
+/**
+ * Plotina: DeepFilterNet3 noise suppression for the microphone.
+ *
+ * Sits between `AudioRecord` and `FfiLocalTrack.captureAudio`, so it sees exactly what the RTC
+ * stack would otherwise encode: 48 kHz mono little-endian PCM16, 480 samples (10 ms) per frame.
+ * That is the frame size and hop the model was exported at (`hop_size = 480`, `fft_size = 960`,
+ * `sr = 48000` in the model's `config.ini`), so nothing is resampled or re-framed on the way in
+ * or out, and the DSP only ever looks at samples: it cannot reach the media encryption, which
+ * happens further down on the encoded frames.
+ *
+ * The native side is a small cdylib around the `deep_filter` crate (libDF) with the DFN3 ONNX
+ * model embedded; it keeps 5 frames of spectral history and 2 frames of lookahead, so it adds
+ * ~20 ms of algorithmic delay to the uplink on top of the time the model itself takes per frame.
+ *
+ * Everything here degrades to "no denoising" rather than to a broken call: if the library is
+ * missing for this ABI, or the model fails to load, [process] becomes a no-op and the microphone
+ * is published exactly as captured.
+ *
+ * `@Keep` because the JNI symbol is derived from this class name and R8 would otherwise rename it
+ * in a release build, turning every call into an `UnsatisfiedLinkError` (and therefore silent
+ * fallback to raw capture).
+ */
+@Keep
+internal class PlotinaDfn {
+    private var handle: Long = 0L
+    private var loadFailed = false
+
+    /**
+     * Loads the model. Called once per call, on the capture thread, before the first read, so the
+     * model load costs neither the caller's thread nor a captured frame. Idempotent.
+     */
+    fun prepare() {
+        if (handle != 0L || loadFailed) return
+        handle = try {
+            System.loadLibrary(LIBRARY_NAME)
+            nativeCreate(AudioFormat.SAMPLE_RATE, AudioFormat.CHANNEL_COUNT)
+        } catch (throwable: Throwable) {
+            // NoSuchElementException for an ABI we do not ship, UnsatisfiedLinkError for a bad
+            // symbol, and anything the model loader throws on the way up. All of them mean the
+            // same thing here: publish the microphone unprocessed.
+            loadFailed = true
+            Timber.w(throwable, "Plotina: DeepFilterNet3 unavailable, publishing raw microphone")
+            0L
+        }
+        if (handle == 0L) {
+            loadFailed = true
+        } else {
+            Timber.i("Plotina: DeepFilterNet3 ready at ${AudioFormat.SAMPLE_RATE} Hz")
+        }
+    }
+
+    /**
+     * Denoises one frame in place. A no-op until [prepare] has succeeded, and never throws: a
+     * failure mid-call disables denoising for the rest of the call rather than ending capture.
+     */
+    fun process(frame: ByteArray) {
+        if (handle == 0L) return
+        try {
+            nativeProcess(handle, frame)
+        } catch (throwable: Throwable) {
+            Timber.w(throwable, "Plotina: denoising failed, publishing raw microphone")
+            close()
+            loadFailed = true
+        }
+    }
+
+    /** Releases the native state; the next [prepare] loads the model again. */
+    fun close() {
+        val current = handle
+        handle = 0L
+        if (current != 0L) {
+            try {
+                nativeDestroy(current)
+            } catch (throwable: Throwable) {
+                Timber.w(throwable, "Plotina: could not release the denoiser")
+            }
+        }
+    }
+
+    private external fun nativeCreate(sampleRate: Int, channels: Int): Long
+
+    private external fun nativeProcess(handle: Long, frame: ByteArray)
+
+    private external fun nativeDestroy(handle: Long)
+
+    private companion object {
+        const val LIBRARY_NAME = "plotina_dfn"
+    }
+}
