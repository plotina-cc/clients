# Pins for element-x/. Sourced by .github/workflows/build-element-x.yml, and by hand when
# reproducing a build locally. Plain KEY=VALUE lines: no quotes, no comments on the value lines,
# the file is appended to $GITHUB_ENV verbatim.

# Element X Android, https://github.com/element-hq/element-x-android
# v26.10.1 = d1b523c4 (release/26.10.1 merge). CalVer tags: vYY.MM.patch.
ELEMENT_X_TAG=v26.10.1

# The native call library Element X consumes as a prebuilt AAR,
# https://github.com/element-hq/element-call-android
# v0.1.0-rc.8 = 025078d6. This is where the microphone is opened and where 0001 applies.
ELEMENT_CALL_TAG=v0.1.0-rc.8

# The version 0001's build is published to mavenLocal under, so that it cannot be confused with
# the upstream release of the same name. Element X picks it up with -PelementCallLocalVersion.
ELEMENT_CALL_LOCAL_VERSION=0.1.0-rc.8-plotina.1

# matrix-rust-rtc, the Rust core behind the call. Not patched: element-call's own
# ./tools/rtc/fetch-rust-rtc downloads the AAR that element-call's gradle.properties pins
# (v0.5.0-rc.5, sha256 d5b86ff66d0a400dcc7ecca17517f0174a667121011b2581459d325d01c428f8).

# DeepFilterNet, the denoiser: libDF crate + the DFN3 ONNX model embedded in it.
# https://github.com/Rikorose/DeepFilterNet, MIT OR Apache-2.0.
DEEP_FILTER_TAG=v0.5.6

# Android NDK used to cross-compile the shim. Pinned because the runner's "latest" moves.
ANDROID_NDK_VERSION=27.2.12479018
