diff --git a/android/app/src/main/kotlin/chat/fluffy/fluffychat/PlotinaUpdaterChannel.kt b/android/app/src/main/kotlin/chat/fluffy/fluffychat/PlotinaUpdaterChannel.kt
new file mode 100644
index 0000000..89cf013
--- /dev/null
+++ b/android/app/src/main/kotlin/chat/fluffy/fluffychat/PlotinaUpdaterChannel.kt
@@ -0,0 +1,105 @@
+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+package chat.fluffy.fluffychat
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.provider.Settings
+import androidx.core.content.FileProvider
+import io.flutter.plugin.common.BinaryMessenger
+import io.flutter.plugin.common.MethodChannel
+import java.io.File
+
+/**
+ * plotina.cc: native half of the in-app updater (Dart side:
+ * lib/utils/updater/plotina_updater.dart). The APK is downloaded and
+ * verified in Dart; this channel only answers questions about the installed
+ * package and hands a verified file to the system installer, because
+ * ACTION_VIEW + FileProvider and the "install unknown apps" state are not
+ * reachable from Flutter plugins we already ship.
+ */
+object PlotinaUpdaterChannel {
+    private const val CHANNEL = "cc.plotina.mobile/updater"
+
+    /** The visible activity, when there is one, so intents need no NEW_TASK. */
+    @Volatile
+    var activity: Activity? = null
+
+    fun register(messenger: BinaryMessenger, context: Context) {
+        val appContext = context.applicationContext
+        MethodChannel(messenger, CHANNEL).setMethodCallHandler { call, result ->
+            try {
+                when (call.method) {
+                    "getVersionCode" -> result.success(versionCode(appContext))
+                    "canRequestInstall" -> result.success(canRequestInstall(appContext))
+                    "canInstallArm64" -> result.success(canInstallArm64())
+                    "openUnknownSourcesSettings" -> {
+                        val intent = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                            // Android 8+: the permission is per-app.
+                            Intent(
+                                Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES,
+                                Uri.parse("package:${appContext.packageName}")
+                            )
+                        } else {
+                            Intent(Settings.ACTION_SECURITY_SETTINGS)
+                        }
+                        startActivityOrNewTask(intent, appContext)
+                        result.success(true)
+                    }
+                    "installApk" -> installApk(call.argument<String>("path"), appContext, result)
+                    else -> result.notImplemented()
+                }
+            } catch (e: Exception) {
+                result.error("updater", e.message, null)
+            }
+        }
+    }
+
+    private fun versionCode(context: Context): Long =
+        @Suppress("DEPRECATION")
+        context.packageManager.getPackageInfo(context.packageName, 0).longVersionCode
+
+    private fun canRequestInstall(context: Context): Boolean =
+        Build.VERSION.SDK_INT < Build.VERSION_CODES.O ||
+            context.packageManager.canRequestPackageInstalls()
+
+    /**
+     * The manifest publishes one APK, built for arm64-v8a (CI "Write the
+     * updater manifest"), so a 32-bit-only device would be refused by the
+     * installer with INSTALL_FAILED_NO_MATCHING_ABIS. The updater asks this
+     * before offering anything.
+     */
+    private fun canInstallArm64(): Boolean =
+        Build.SUPPORTED_ABIS.contains("arm64-v8a")
+
+    private fun installApk(path: String?, context: Context, result: MethodChannel.Result) {
+        val file = path?.let(::File)
+        if (file == null || !file.isFile || file.length() == 0L) {
+            result.error("no_file", "The APK to install does not exist", null)
+            return
+        }
+        val authority = "${context.packageName}.updater.fileprovider"
+        val uri = FileProvider.getUriForFile(context, authority, file)
+        val intent = Intent(Intent.ACTION_VIEW).apply {
+            setDataAndType(uri, "application/vnd.android.package-archive")
+            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+        }
+        startActivityOrNewTask(intent, context)
+        result.success(true)
+    }
+
+    private fun startActivityOrNewTask(intent: Intent, context: Context) {
+        val current = activity
+        if (current != null && !current.isFinishing && !current.isDestroyed) {
+            current.startActivity(intent)
+        } else {
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            context.startActivity(intent)
+        }
+    }
+}
