+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/// plotina.cc: in-app updater for the Android APK.
+///
+/// We do not ship through Google Play: the APK is published on
+/// https://plotina.cc/dl. The app periodically (at most once a day, from
+/// `UpdateNotifier.showUpdateAvailableBanner`) and on demand (Settings ->
+/// "Check for updates" opens a dedicated updater page) fetches
+///
+///   https://plotina.cc/dl/update-mobile.json
+///
+/// which the CI writes next to the APKs on every release:
+///
+///   {"client":"mobile","package":"cc.plotina.mobile","versionName":"2.11.3",
+///    "versionCode":2112323,"apkUrl":"https://plotina.cc/dl/Plotina-Mobile.apk",
+///    "sha256":"HEX","size":BYTES,"notes":"short text"}
+///
+/// Opt-in update channel (Settings -> "Канал обновлений", persisted in the
+/// shared preferences under `plotina.updater.channel`, default stable): a
+/// dev-channel install fetches instead
+///
+///   https://github.com/plotina-cc/clients/releases/download/dev-latest/update-mobile-dev.json
+///
+/// a static GitHub release whose assets CI overwrites on every
+/// `v<base>-plotina-mobile.<N>-dev.<M>` tag. A dev build carries the *same*
+/// versionCode as the stable `.N` it is based on (same package
+/// `cc.plotina.mobile`, same signing key; the dev manifest adds
+/// `"devBuild":M` and a `versionName` of `<base>-dev.<M>`), so dev-to-dev
+/// upgrades compare M and the next stable `.N+1` is a normal upgrade back.
+/// Equal versionCode is reinstallable by AOSP's `checkDowngrade`, which only
+/// rejects *lower* codes. Dev builds must be based on the latest *published*
+/// stable; the CI dev path validates that before building (see
+/// `fluffychat/scripts/version-code.py --check-dev-base`).
+///
+/// `versionCode` is the number of the arm64 APK the CI actually built: the
+/// build number of the tag plus the ABI digit Flutter's `--split-per-abi`
+/// writes into it (see `fluffychat/scripts/version-code.py`), which is the same
+/// space our own PackageManager reports, so the comparison is apples to apples.
+///
+/// If it is greater than our own (read from the PackageManager through the
+/// `cc.plotina.mobile/updater` method channel) the updater page offers the
+/// update; the silent daily check keeps a themed dialog that hands over to the
+/// same page. The APK is streamed into the app cache while sha256 and size are
+/// verified against the manifest, and a verified file is handed to the system
+/// installer through a FileProvider content:// URI. Android 8+ refuses the
+/// handoff unless the user granted this package "install unknown apps"; we
+/// detect that with `canRequestPackageInstalls()` and show an explanation with
+/// an "Open settings" button *before* downloading anything - the updater page
+/// then re-checks on app resume and continues the download by itself. The
+/// manifest offers only the arm64 APK, so a 32-bit-only device is told to
+/// fetch the armv7 APK by hand instead of being handed a file the installer
+/// would reject.
+///
+/// Download completion is defined by the *byte count*, not by the server
+/// closing the connection. The .25 build hung at 100 % because `await for`
+/// waited for a stream end that never came after the last byte; see
+/// [PlotinaUpdater.streamApk] and the regression test that streams a full
+/// body over a never-closed stream.
+///
+/// The manifest URLs can be pointed at a local server for testing with
+/// `--dart-define=PLOTINA_UPDATE_URL=http://10.0.2.2:8000/update-mobile.json`
+/// and `--dart-define=PLOTINA_DEV_UPDATE_URL=http://10.0.2.2:8000/update-mobile-dev.json`.
+library;
+
+import 'dart:async';
+import 'dart:io';
+
+import 'package:crypto/crypto.dart';
+import 'package:fluffychat/config/setting_keys.dart';
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/pages/updater/plotina_updater_page.dart';
+import 'package:fluffychat/utils/platform_infos.dart';
+import 'package:fluffychat/utils/updater/update_manifest.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:flutter/services.dart';
+import 'package:http/http.dart' as http;
+import 'package:matrix/matrix.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+import 'package:path_provider/path_provider.dart';
+
+abstract class PlotinaUpdater {
+  /// Public so tests can answer it with
+  /// `TestDefaultBinaryMessengerBinding.setMockMethodCallHandler`.
+  static const MethodChannel channel = MethodChannel(
+    'cc.plotina.mobile/updater',
+  );
+
+  /// Stable feed: mirrored by infra at plotina.cc/dl from the per-tag GitHub
+  /// releases. The dev feed is a fixed GitHub release (`dev-latest`) whose
+  /// assets CI overwrites on every `v<base>-plotina-mobile.<N>-dev.<M>` tag;
+  /// it never touches the edge mirror, so opting into dev is fully reversible.
+  static const String _defaultManifestUrl =
+      'https://plotina.cc/dl/update-mobile.json';
+  static const String _defaultDevManifestUrl =
+      'https://github.com/plotina-cc/clients/releases/download/dev-latest/update-mobile-dev.json';
+
+  static const String _urlOverride = String.fromEnvironment(
+    'PLOTINA_UPDATE_URL',
+  );
+  static const String _devUrlOverride = String.fromEnvironment(
+    'PLOTINA_DEV_UPDATE_URL',
+  );
+
+  /// The manifest URL for one channel, after `--dart-define` overrides.
+  /// Exposed for tests and for the settings UI's feed explanation.
+  static String manifestUrlFor(UpdateChannel ch) => switch (ch) {
+    UpdateChannel.stable =>
+      _urlOverride.isEmpty ? _defaultManifestUrl : _urlOverride,
+    UpdateChannel.dev =>
+      _devUrlOverride.isEmpty ? _defaultDevManifestUrl : _devUrlOverride,
+  };
+
+  /// Persisted update channel. `stable` is the default and the value of an
+  /// unreadable or uninitialized store, so a fresh or broken preference can
+  /// never silently start installing GitHub dev builds.
+  static const String _channelKey = 'plotina.updater.channel';
+
+  static UpdateChannel channelFromName(String? value) =>
+      value == 'dev' ? UpdateChannel.dev : UpdateChannel.stable;
+
+  /// Seam for tests: which channel this install uses. SharedPreferences is
+  /// loaded before `runApp`, so the real reader is synchronous.
+  static UpdateChannel Function() channelProvider = _readChannel;
+
+  static UpdateChannel _readChannel() {
+    try {
+      return channelFromName(AppSettings.store.getString(_channelKey));
+    } catch (e, s) {
+      // Before AppSettings.init() (tests, early startup) the store is
+      // unset. Default stable, never throw from an update check.
+      Logs().w('Updater: update channel unreadable, using stable', e, s);
+      return UpdateChannel.stable;
+    }
+  }
+
+  static Future<void> setChannel(UpdateChannel ch) async {
+    try {
+      await AppSettings.store.setString(
+        _channelKey,
+        ch == UpdateChannel.dev ? 'dev' : 'stable',
+      );
+    } catch (e, s) {
+      Logs().w('Updater: could not persist the update channel', e, s);
+    }
+    channelNotifier.value = ch;
+  }
+
+  /// The settings row rebuilds on this so the tile shows the saved value
+  /// without a navigation pop. The store stays the source of truth; this
+  /// only carries in-session switches.
+  static final ValueNotifier<UpdateChannel> channelNotifier =
+      ValueNotifier<UpdateChannel>(UpdateChannel.stable);
+
+  /// `2.11.3-dev.2` -> 2; every other string (a stable version name) -> null.
+  /// The dev build number comes from the APK's own versionName, which CI
+  /// writes as `--build-name <base>-dev.<M>` (see the build workflow); the
+  /// versionCode deliberately stays the stable one, so this is the only
+  /// in-app proof that an install is a dev build.
+  static final RegExp _devVersionName = RegExp(r'^\d+\.\d+\.\d+-dev\.(\d+)$');
+
+  static int? devBuildOf(String versionName) {
+    final match = _devVersionName.firstMatch(versionName.trim());
+    return match == null ? null : int.tryParse(match.group(1)!);
+  }
+
+  static bool isDevVersionName(String versionName) =>
+      devBuildOf(versionName) != null;
+
+  /// Last update the user declined on the silent dialog. A dev manifest and
+  /// its stable base share a versionCode, so the dismissed token carries the
+  /// devBuild too: `2112328` or `2112328:2`.
+  static const String _dismissedKey = 'plotina.updater.dismissed_version';
+
+  static const Duration _fetchTimeout = Duration(seconds: 20);
+
+  /// No byte on the wire for this long -> the download has stalled.
+  static const Duration _chunkIdleTimeout = Duration(seconds: 60);
+
+  /// Waiting for the first response header for this long is a failure too.
+  static const Duration _sendTimeout = Duration(seconds: 30);
+
+  /// Injectable so tests never touch the network: used by [fetchManifest]
+  /// (GET of the JSON) and [streamApk] (`send` of the APK request).
+  static http.Client Function() clientFactory = http.Client.new;
+
+  /// Package name and human version of *this* install. Injectable because
+  /// package_info_plus has no implementation under `flutter test`.
+  static Future<({String packageName, String version})> Function()
+  packageInfoProvider = _defaultPackageInfo;
+
+  static Future<({String packageName, String version})> _defaultPackageInfo()
+  async {
+    final info = await PackageInfo.fromPlatform();
+    return (packageName: info.packageName, version: info.version);
+  }
+
+  /// True on the platforms where the updater makes sense.
+  static bool get isSupported => PlatformInfos.isAndroid;
+
+  /// Reads our own versionCode from the PackageManager, so it always matches
+  /// what is installed (the build number comes from the release tag, see
+  /// `fluffychat/scripts/version-code.py`).
+  static Future<int> currentVersionCode() async {
+    try {
+      return await channel.invokeMethod<int>('getVersionCode') ?? -1;
+    } catch (e, s) {
+      Logs().w('Updater: getVersionCode failed', e, s);
+      return -1;
+    }
+  }
+
+  /// Whether this device can install the arm64 APK the manifest offers.
+  /// Defaults to true when the native side does not answer (an updater built
+  /// without the channel should not silently stop checking).
+  static Future<bool> canInstallArm64() async {
+    try {
+      return await channel.invokeMethod<bool>('canInstallArm64') ?? true;
+    } catch (e, s) {
+      Logs().w('Updater: canInstallArm64 failed', e, s);
+      return true;
+    }
+  }
+
+  /// Whether Android already lets this app launch an installer. False means
+  /// the user must grant "install unknown apps" first; we must not download
+  /// ~85 MB before asking.
+  static Future<bool> canRequestInstall() async {
+    try {
+      return await channel.invokeMethod<bool>('canRequestInstall') ?? false;
+    } catch (e, s) {
+      Logs().w('Updater: canRequestInstall failed', e, s);
+      return false;
+    }
+  }
+
+  /// Opens the per-app "install unknown apps" settings page. The updater page
+  /// re-checks [canRequestInstall] when the app resumes, so the user does not
+  /// have to tap anything after coming back.
+  static Future<void> openUnknownSourcesSettings() async {
+    try {
+      await channel.invokeMethod('openUnknownSourcesSettings');
+    } catch (e, s) {
+      Logs().w('Updater: cannot open the install permission page', e, s);
+    }
+  }
+
+  /// Fetches the manifest of one channel; default: the persisted one.
+  static Future<UpdateManifest?> fetchManifest({UpdateChannel? channel}) async {
+    final url = manifestUrlFor(channel ?? channelProvider());
+    try {
+      final client = clientFactory();
+      final http.Response response;
+      try {
+        response = await client.get(Uri.parse(url)).timeout(_fetchTimeout);
+      } finally {
+        client.close();
+      }
+      if (response.statusCode != 200) {
+        Logs().w('Updater: manifest HTTP ${response.statusCode} from $url');
+        return null;
+      }
+      final manifest = UpdateManifest.tryParse(response.body);
+      if (manifest == null) return null;
+      final info = await packageInfoProvider();
+      if (manifest.client != 'mobile' || manifest.package != info.packageName) {
+        Logs().w(
+          'Updater: manifest is not for this package '
+          '(${manifest.client}/${manifest.package}, '
+          'we are ${info.packageName})',
+        );
+        return null;
+      }
+      return manifest;
+    } catch (e, s) {
+      Logs().w('Updater: could not fetch the update manifest', e, s);
+      return null;
+    }
+  }
+
+  /// The comparison rules, pure so unit tests can enumerate them.
+  ///
+  /// Stable channel:
+  /// * a greater `versionCode` is the normal upgrade — including from a dev
+  ///   build back to stable: dev reuses its base's code, so the *next* stable
+  ///   release (`.N+1`) is greater than an installed `.N-dev.M`;
+  /// * the next stable has not appeared yet while a dev build runs
+  ///   (`versionCode <= localCode` and our versionName is `*-dev.M`):
+  ///   [UpdateDecision.waitingForStable] — honest "dev build, waiting", never
+  ///   a false "no updates available";
+  /// * otherwise up to date.
+  ///
+  /// Dev channel (dev feed publishes `versionCode` == its stable base plus
+  /// `devBuild: M`):
+  /// * a greater code wins regardless of M (a newer dev base, or a stable the
+  ///   dev feed fell back to);
+  /// * equal codes compare `devBuild`: dev -> dev upgrades only on a greater
+  ///   M, stable -> dev offers the dev build even though the code is equal —
+  ///   same package, same signing key, and AOSP's `checkDowngrade` rejects
+  ///   only *lower* codes, so the equal-code reinstall is permitted (verified
+  ///   by unit tests for the logic; an OEM installer test is the one thing
+  ///   this cannot prove);
+  /// * equal codes without a `devBuild` in the manifest are up to date.
+  static UpdateDecision compareUpdate({
+    required UpdateManifest manifest,
+    required int localCode,
+    required String localVersionName,
+    required UpdateChannel channel,
+  }) {
+    final localDev = devBuildOf(localVersionName);
+    final manifestDev = manifest.devBuild;
+    if (manifest.versionCode > localCode) {
+      return UpdateDecision.updateAvailable;
+    }
+    if (manifest.versionCode == localCode && channel == UpdateChannel.dev) {
+      if (manifestDev != null) {
+        if (localDev == null) return UpdateDecision.updateAvailable;
+        return manifestDev > localDev
+            ? UpdateDecision.updateAvailable
+            : UpdateDecision.upToDate;
+      }
+      return UpdateDecision.upToDate;
+    }
+    if (manifest.versionCode < localCode &&
+        channel == UpdateChannel.dev &&
+        manifestDev != null &&
+        localDev != null) {
+      // A dev feed that rolled back to an older base: never offer a downgrade.
+      return UpdateDecision.upToDate;
+    }
+    if (channel == UpdateChannel.stable && localDev != null) {
+      // Running a dev build; the stable feed has nothing newer yet.
+      return UpdateDecision.waitingForStable;
+    }
+    return UpdateDecision.upToDate;
+  }
+
+  /// The result of comparing the manifest with this install; the updater page
+  /// turns each value into a visible state. Kept free of BuildContext so it
+  /// is unit-testable.
+  static Future<UpdateDecision> decide(
+    UpdateManifest? manifest, {
+    UpdateChannel? channel,
+  }) async {
+    if (manifest == null) return UpdateDecision.checkFailed;
+    final localCode = await currentVersionCode();
+    // A versionCode we cannot read must not fall through to `<= -1`: the
+    // silent daily check would then offer the same update on every launch.
+    if (localCode <= 0) {
+      Logs().w('Updater: our own versionCode is unreadable, not offering');
+      return UpdateDecision.checkFailed;
+    }
+    final effectiveChannel = channel ?? channelProvider();
+    final info = await packageInfoProvider();
+    final decision = compareUpdate(
+      manifest: manifest,
+      localCode: localCode,
+      localVersionName: info.version,
+      channel: effectiveChannel,
+    );
+    // The manifests offer one arm64 APK. A 32-bit-only phone cannot install
+    // it, so the updater says what to get by hand instead of handing the
+    // installer a file it rejects.
+    if (decision == UpdateDecision.updateAvailable &&
+        !await canInstallArm64()) {
+      return UpdateDecision.armv7Only;
+    }
+    return decision;
+  }
+
+  /// The full handoff: permission -> (cached | streamed+verified) download ->
+  /// installer. UI-free and dependency-injected, so a test can feed a fake
+  /// byte stream through it and count the `installApk` calls. Returns
+  /// [InstallOutcome.needsPermission] without touching the network when
+  /// Android has not granted the install permission yet.
+  ///
+  /// `installApk` is invoked exactly once per successful call; the caller is
+  /// responsible for not running two flows concurrently. A verified file from
+  /// an earlier attempt is reused instead of downloaded again.
+  static Future<InstallOutcome> runInstallFlow({
+    required UpdateManifest manifest,
+    required File target,
+    void Function(double? fraction)? onProgress,
+    bool Function()? isCanceled,
+  }) async {
+    bool canceled() => isCanceled?.call() == true;
+    // Ask for the permission *before* burning the mobile data: without
+    // "install unknown apps" the handoff below is refused by the system.
+    if (!await canRequestInstall()) return InstallOutcome.needsPermission;
+    if (!await fileMatches(target, manifest)) {
+      final client = clientFactory();
+      final StreamResult result;
+      try {
+        result = await streamApk(
+          client: client,
+          file: target,
+          manifest: manifest,
+          onProgress: (fraction) => onProgress?.call(fraction),
+          isCanceled: canceled,
+        );
+      } finally {
+        client.close();
+      }
+      switch (result) {
+        case StreamResult.canceled:
+          await deleteQuietly(target);
+          return InstallOutcome.canceled;
+        case StreamResult.ok:
+          break;
+        case StreamResult.shaMismatch:
+          await deleteQuietly(target);
+          return InstallOutcome.verifyFailed;
+        case StreamResult.httpError:
+        case StreamResult.truncated:
+        case StreamResult.networkFailed:
+          await deleteQuietly(target);
+          return InstallOutcome.downloadFailed;
+      }
+    }
+    onProgress?.call(1.0);
+    // The caller shows its progress UI until this returns; a throw here must
+    // never end the flow silently, so it is converted into a visible outcome.
+    try {
+      await channel.invokeMethod('installApk', {'path': target.path});
+    } catch (e, s) {
+      Logs().w('Updater: the installer could not be started', e, s);
+      return InstallOutcome.installFailed;
+    }
+    return InstallOutcome.installerOpened;
+  }
+
+  /// Streams the APK into [file] while hashing it. Completes as soon as
+  /// `manifest.size` bytes have arrived - even if the server has not closed
+  /// the connection (the .25 hang) - then verifies sha256 and size. An idle
+  /// timeout covers streams that stall mid-download.
+  static Future<StreamResult> streamApk({
+    required http.Client client,
+    required File file,
+    required UpdateManifest manifest,
+    required void Function(double? fraction) onProgress,
+    required bool Function() isCanceled,
+  }) async {
+    final request = http.Request('GET', Uri.parse(manifest.apkUrl));
+    final http.StreamedResponse response;
+    try {
+      response = await client.send(request).timeout(_sendTimeout);
+    } catch (e, s) {
+      if (isCanceled()) return StreamResult.canceled;
+      Logs().w('Updater: APK download request failed', e, s);
+      return StreamResult.networkFailed;
+    }
+    if (response.statusCode != 200) {
+      Logs().w(
+        'Updater: APK download HTTP ${response.statusCode} '
+        'from ${manifest.apkUrl}',
+      );
+      await _drainQuietly(response.stream);
+      return StreamResult.httpError;
+    }
+
+    final expected = manifest.size;
+    final digestSink = _OneShotSink<Digest>();
+    final hasher = sha256.startChunkedConversion(digestSink);
+    final sink = file.openWrite();
+    final done = Completer<StreamResult>();
+    StreamSubscription<List<int>>? subscription;
+    var received = 0;
+
+    Future<StreamResult> finish(StreamResult result) async {
+      await subscription?.cancel();
+      subscription = null;
+      try {
+        await sink.flush();
+        await sink.close();
+      } catch (e, s) {
+        Logs().w('Updater: could not close the download file', e, s);
+      }
+      hasher.close();
+      if (result == StreamResult.ok &&
+          (digestSink.value == null ||
+              received != expected ||
+              digestSink.value.toString().toLowerCase() !=
+                  manifest.sha256.toLowerCase())) {
+        Logs().w(
+          'Updater: checksum/size mismatch: sha256 ${digestSink.value}, '
+          '$received bytes; manifest says ${manifest.sha256}, '
+          '$expected bytes',
+        );
+        result = StreamResult.shaMismatch;
+      }
+      return result;
+    }
+
+    void complete(StreamResult result) {
+      if (!done.isCompleted) done.complete(result);
+    }
+
+    subscription = response.stream
+        .timeout(
+          _chunkIdleTimeout,
+          onTimeout: (timeoutSink) => timeoutSink.addError(
+            TimeoutException('No APK bytes for $_chunkIdleTimeout'),
+          ),
+        )
+        .listen(
+          (chunk) {
+            // Chunks that still trickle in after completion (cancel is
+            // asynchronous) must not reach the file or the hash: the file
+            // and digest cover exactly the manifest's byte count.
+            if (done.isCompleted) return;
+            if (isCanceled()) {
+              complete(StreamResult.canceled);
+              return;
+            }
+            sink.add(chunk);
+            hasher.add(chunk);
+            received += chunk.length;
+            if (expected > 0) {
+              onProgress((received / expected).clamp(0.0, 1.0));
+            }
+            // Completion is defined by the *byte count*: a CDN that keeps
+            // the connection open after the last byte must not hang us.
+            if (expected > 0 && received >= expected) {
+              complete(StreamResult.ok);
+            }
+          },
+          onError: (Object e, StackTrace s) {
+            if (isCanceled()) {
+              complete(StreamResult.canceled);
+            } else {
+              Logs().w('Updater: APK download stream failed', e, s);
+              complete(StreamResult.networkFailed);
+            }
+          },
+          onDone: () {
+            // The server closed the stream. Fewer bytes than promised are a
+            // truncation; the byte-exact case is verified in finish().
+            if (done.isCompleted) return;
+            complete(
+              received >= expected
+                  ? StreamResult.ok
+                  : StreamResult.truncated,
+            );
+          },
+          cancelOnError: true,
+        );
+
+    return await finish(await done.future);
+  }
+
+  /// The file the verified APK lives in while the installer takes it. Mirrors
+  /// `<cache-path name="updates" path="updates"/>` from
+  /// res/xml/updater_file_paths.xml: getTemporaryDirectory()/updates on the
+  /// Flutter side is context.cacheDir/updates on the native side, the only
+  /// path the FileProvider will turn into a content:// URI.
+  static Future<File> cachedApkFile() async {
+    final temp = await getTemporaryDirectory();
+    final dir = Directory('${temp.path}/updates');
+    if (!dir.existsSync()) await dir.create(recursive: true);
+    return File('${dir.path}/Plotina-Mobile.apk');
+  }
+
+  static Future<bool> fileMatches(File file, UpdateManifest manifest) async {
+    try {
+      if (!file.existsSync()) return false;
+      if (manifest.size > 0 && file.lengthSync() != manifest.size) {
+        return false;
+      }
+      final digest = await _hashFile(file);
+      return digest.toString() == manifest.sha256.toLowerCase();
+    } catch (e, s) {
+      Logs().w('Updater: cannot reuse the cached APK', e, s);
+      return false;
+    }
+  }
+
+  static Future<void> deleteQuietly(File file) async {
+    try {
+      if (file.existsSync()) await file.delete();
+    } catch (_) {
+      // Leftover cache files are pruned by the OS; never fail the flow for it.
+    }
+  }
+
+  static Future<Digest?> _hashFile(File file) async {
+    final sink = _OneShotSink<Digest>();
+    final hasher = sha256.startChunkedConversion(sink);
+    await for (final chunk in file.openRead()) {
+      hasher.add(chunk);
+    }
+    hasher.close();
+    return sink.value;
+  }
+
+  static Future<void> _drainQuietly(Stream<List<int>> stream) async {
+    try {
+      final sub = stream.listen(null);
+      await sub.cancel();
+    } catch (_) {
+      // The socket is released either way; nothing actionable here.
+    }
+  }
+
+  /// Manual: open the dedicated updater page (a full-screen route inside the
+  /// app theme - never a bare dialog on an unthemed overlay). Silent: fetch,
+  /// and only when there really is a not-yet-declined update show the themed
+  /// dialog, which hands "Download and install" to the same page.
+  static Future<void> checkForUpdate(
+    BuildContext context, {
+    bool manual = false,
+  }) async {
+    if (!isSupported) return;
+    if (manual) {
+      await Navigator.of(context).push(
+        MaterialPageRoute(builder: (context) => const PlotinaUpdaterPage()),
+      );
+      return;
+    }
+
+    final manifest = await fetchManifest();
+    final decision = await decide(manifest);
+    if (decision != UpdateDecision.updateAvailable || manifest == null) return;
+
+    final store = AppSettings.store;
+    if (store.getString(_dismissedKey) == _dismissToken(manifest)) return;
+
+    if (!context.mounted) return;
+    final start = await showPlotinaUpdateDialog(context, manifest);
+    if (start != true) {
+      await store.setString(_dismissedKey, _dismissToken(manifest));
+      return;
+    }
+    if (!context.mounted) return;
+    await Navigator.of(context).push(
+      MaterialPageRoute(
+        builder: (context) =>
+            PlotinaUpdaterPage(manifest: manifest, autoStart: true),
+      ),
+    );
+  }
+
+  /// What the silent dialog remembers as "declined": the devBuild is part of
+  /// the identity, so skipping `2112328-dev.1` does not also skip
+  /// `2112328-dev.2`.
+  static String _dismissToken(UpdateManifest manifest) =>
+      manifest.devBuild == null
+      ? '${manifest.versionCode}'
+      : '${manifest.versionCode}:${manifest.devBuild}';
+
+  /// Right after the user switches back to stable while a dev build is
+  /// installed: if the stable feed has nothing newer yet, say so instead of
+  /// going quiet; if the next stable is already out, offer it through the
+  /// same dialog the daily check uses. Stable installs need nothing here.
+  static Future<void> explainChannelSwitch(
+    BuildContext context,
+    UpdateChannel channel,
+  ) async {
+    if (!isSupported || channel != UpdateChannel.stable) return;
+    final info = await packageInfoProvider();
+    if (!isDevVersionName(info.version)) return;
+    final manifest = await fetchManifest(channel: UpdateChannel.stable);
+    final decision = await decide(manifest, channel: UpdateChannel.stable);
+    switch (decision) {
+      case UpdateDecision.waitingForStable:
+        if (!context.mounted) return;
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(
+            content: Text(L10n.of(context).updateWaitingForStable),
+            duration: const Duration(seconds: 6),
+            behavior: SnackBarBehavior.floating,
+          ),
+        );
+      case UpdateDecision.updateAvailable:
+        if (!context.mounted || manifest == null) return;
+        final start = await showPlotinaUpdateDialog(context, manifest);
+        if (start == true && context.mounted) {
+          await Navigator.of(context).push(
+            MaterialPageRoute(
+              builder: (context) =>
+                  PlotinaUpdaterPage(manifest: manifest, autoStart: true),
+            ),
+          );
+        }
+      default:
+        // checkFailed / upToDate / armv7Only: the manual "Check for updates"
+        // page shows those with their retry paths; do not nag here.
+        break;
+    }
+  }
+
+  static String prettySize(int bytes) {
+    if (bytes <= 0) return '';
+    const units = ['B', 'KB', 'MB', 'GB'];
+    var size = bytes.toDouble();
+    var unit = 0;
+    while (size >= 1024 && unit < units.length - 1) {
+      size /= 1024;
+      unit++;
+    }
+    return '${size.toStringAsFixed(size >= 10 || unit == 0 ? 0 : 1)} ${units[unit]}';
+  }
+}
+
+enum UpdateDecision {
+  upToDate,
+  checkFailed,
+  armv7Only,
+  updateAvailable,
+
+  /// A dev build is installed, the stable feed has no newer code yet. Shows
+  /// "still dev, waiting for the next stable" instead of claiming there is
+  /// nothing to update: the switch back happens with the *next* stable tag.
+  waitingForStable,
+}
+
+/// Which update feed this install follows. Persisted in the shared settings
+/// store (`plotina.updater.channel`); dev is strictly opt-in.
+enum UpdateChannel { stable, dev }
+
+enum InstallOutcome {
+  installerOpened,
+  needsPermission,
+  canceled,
+  downloadFailed,
+  verifyFailed,
+  installFailed,
+}
+
+enum StreamResult {
+  ok,
+  httpError,
+  truncated,
+  networkFailed,
+  shaMismatch,
+  canceled,
+}
+
+/// The themed "update is available" dialog of the silent daily check. The
+/// caller's [Theme] is captured and forced onto the dialog overlay, and every
+/// colour inside comes from that theme's colorScheme - never a hard-coded
+/// white surface - so the dialog is dark when the app is dark.
+Future<bool?> showPlotinaUpdateDialog(
+  BuildContext context,
+  UpdateManifest manifest,
+) {
+  final appTheme = Theme.of(context);
+  return showDialog<bool>(
+    context: context,
+    builder: (dialogContext) =>
+        Theme(data: appTheme, child: PlotinaUpdateDialog(manifest: manifest)),
+  );
+}
+
+class PlotinaUpdateDialog extends StatelessWidget {
+  const PlotinaUpdateDialog({super.key, required this.manifest});
+
+  final UpdateManifest manifest;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    final l10n = L10n.of(context);
+    return AlertDialog(
+      backgroundColor: scheme.surfaceContainerHigh,
+      surfaceTintColor: Colors.transparent,
+      icon: Icon(Icons.system_update_alt, color: scheme.primary),
+      title: Text(
+        l10n.updateAvailable(manifest.versionName),
+        style: theme.textTheme.titleLarge?.copyWith(color: scheme.onSurface),
+      ),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          if (manifest.notes.isNotEmpty)
+            Text(
+              manifest.notes,
+              style: theme.textTheme.bodyMedium?.copyWith(
+                color: scheme.onSurfaceVariant,
+              ),
+            ),
+          Text(
+            PlotinaUpdater.prettySize(manifest.size),
+            style: theme.textTheme.bodySmall?.copyWith(
+              color: scheme.onSurfaceVariant,
+            ),
+          ),
+        ],
+      ),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(false),
+          child: Text(l10n.later),
+        ),
+        FilledButton.icon(
+          onPressed: () => Navigator.of(context).pop(true),
+          icon: const Icon(Icons.file_download_outlined),
+          label: Text(l10n.updateDownloadInstall),
+        ),
+      ],
+    );
+  }
+}
+
+/// Sink that keeps the single value a chunked converter closes with.
+class _OneShotSink<T> implements Sink<T> {
+  T? _value;
+  T? get value => _value;
+  @override
+  void add(T data) => _value = data;
+  @override
+  void close() {}
+}
diff --git a/lib/utils/updater/update_manifest.dart b/lib/utils/updater/update_manifest.dart
new file mode 100644
index 0000000..a3b0647
--- /dev/null
+++ b/lib/utils/updater/update_manifest.dart
@@ -0,0 +1,114 @@
+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/// The JSON published next to the APKs on every release (CI step
+/// "Write the updater manifest" in .github/workflows/build-fluffychat.yml):
+///
+/// ```json
+/// {"client":"mobile","package":"cc.plotina.mobile","versionName":"2.11.3",
+///  "versionCode":2112323,"apkUrl":"https://plotina.cc/dl/Plotina-Mobile.apk",
+///  "sha256":"<hex>","size":<bytes>,"notes":"<short ru text>"}
+/// ```
+///
+/// `versionCode` is read back out of the built arm64 APK, so it already
+/// includes the ABI digit `--split-per-abi` adds and lives in the same number
+/// space as the PackageManager value the updater compares it against.
+///
+/// The optional `devBuild` field carries the `M` of a
+/// `v<base>-plotina-mobile.<N>-dev.<M>` tag. A dev build deliberately shares
+/// the `versionCode` of the stable release `.N` it is based on (same package,
+/// same signing key, AOSP permits reinstall at an equal code), so the code
+/// alone cannot order dev against dev: when both sides are dev builds of the
+/// same code, `devBuild` breaks the tie (see `PlotinaUpdater.compareUpdate`).
+/// Stable manifests never carry it.
+library;
+
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+import 'package:matrix/matrix.dart';
+
+final RegExp _sha256Hex = RegExp(r'^[0-9a-fA-F]{64}$');
+
+class UpdateManifest {
+  const UpdateManifest({
+    required this.client,
+    required this.package,
+    required this.versionName,
+    required this.versionCode,
+    required this.apkUrl,
+    required this.sha256,
+    required this.size,
+    required this.notes,
+    this.devBuild,
+  });
+
+  final String client;
+  final String package;
+  final String versionName;
+  final int versionCode;
+  final String apkUrl;
+
+  /// Lowercase hex sha256 of the APK the updater must download.
+  final String sha256;
+  final int size;
+  final String notes;
+
+  /// The `M` of a `...-plotina-mobile.<N>-dev.<M>` build, or null on a stable
+  /// manifest. Only meaningful when [versionCode] equals a dev build's code.
+  final int? devBuild;
+
+  /// Parsed fields are validated but not trusted: the caller must still check
+  /// `package` and verify the download against `sha256`/`size`.
+  ///
+  /// Returns null (never throws) on malformed or inconsistent JSON so a
+  /// broken or hostile manifest cannot crash the daily check.
+  static UpdateManifest? tryParse(String body) {
+    try {
+      final Object? json = jsonDecode(body);
+      if (json is! Map<String, Object?>) return null;
+      final manifest = UpdateManifest(
+        client: json['client'] as String? ?? '',
+        package: json['package'] as String? ?? '',
+        versionName: json['versionName'] as String? ?? '',
+        versionCode: _toInt(json['versionCode']),
+        apkUrl: json['apkUrl'] as String? ?? '',
+        sha256: (json['sha256'] as String? ?? '').toLowerCase(),
+        size: _toInt(json['size']),
+        notes: json['notes'] as String? ?? '',
+        // Absent on stable manifests; a dev manifest must carry M >= 1 when
+        // it is present, so `devBuild: null` distinguishes "stable feed" from
+        // a dev feed that published a plain stable manifest.
+        devBuild: json.containsKey('devBuild')
+            ? _toInt(json['devBuild'])
+            : null,
+      );
+      if (!manifest.isPlausible) {
+        Logs().w('Updater: rejecting implausible manifest', body);
+        return null;
+      }
+      return manifest;
+    } catch (e, s) {
+      Logs().w('Updater: manifest is not valid JSON', e, s);
+      return null;
+    }
+  }
+
+  static int _toInt(Object? value) => switch (value) {
+    final int v => v,
+    final double v => v.round(),
+    final String v => int.tryParse(v) ?? -1,
+    _ => -1,
+  };
+
+  bool get isPlausible =>
+      versionCode > 0 &&
+      size > 0 &&
+      versionName.isNotEmpty &&
+      (devBuild == null || devBuild! >= 1) &&
+      _sha256Hex.hasMatch(sha256) &&
+      Uri.tryParse(apkUrl)?.hasAbsolutePath == true &&
+      // Never hand the installer a cleartext download in release builds.
+      (kDebugMode || apkUrl.startsWith('https://'));
+}
