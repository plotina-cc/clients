diff --git a/lib/pages/updater/plotina_updater_page.dart b/lib/pages/updater/plotina_updater_page.dart
new file mode 100644
index 0000000..509154a
--- /dev/null
+++ b/lib/pages/updater/plotina_updater_page.dart
@@ -0,0 +1,585 @@
+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/// plotina.cc: the full-screen "Check for updates" page.
+///
+/// A dedicated route instead of bare dialogs: the page is built inside the
+/// app's own Navigator and Theme, so it always follows the app theme (dark
+/// stays dark), the check finally has a visible "no updates" state instead of
+/// a silent no-op, and the download progress lives here rather than in a
+/// dialog whose pop could race the installer call (the .25 hang at 100 %).
+///
+/// Stages: checking -> (upToDate | checkFailed | armv7Only | available) ->
+/// needsPermission? -> downloading -> installerOpened, with retry paths from
+/// every failure state. When Android has not granted "install unknown apps",
+/// the page explains and offers "Open settings"; as a WidgetsBindingObserver
+/// it re-checks the permission on app resume and continues the download
+/// automatically - no second tap - and stays on the explanation if the grant
+/// is still missing.
+library;
+
+import 'dart:async';
+import 'dart:io';
+
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/utils/updater/plotina_updater.dart';
+import 'package:fluffychat/utils/updater/update_manifest.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:matrix/matrix.dart';
+
+class PlotinaUpdaterPage extends StatefulWidget {
+  const PlotinaUpdaterPage({
+    super.key,
+    this.manifest,
+    this.autoStart = false,
+    this.fileProvider,
+  });
+
+  /// Preloaded result of the silent daily dialog: skip the fetch.
+  final UpdateManifest? manifest;
+
+  /// Open straight into the download (the user already confirmed on the
+  /// daily dialog).
+  final bool autoStart;
+
+  /// Injectable target-file provider so tests do not need path_provider.
+  final Future<File> Function()? fileProvider;
+
+  @override
+  State<PlotinaUpdaterPage> createState() => _PlotinaUpdaterPageState();
+}
+
+enum _Stage {
+  checking,
+  upToDate,
+  checkFailed,
+  armv7Only,
+  available,
+  needsPermission,
+  downloading,
+  installerOpened,
+  downloadFailed,
+  verifyFailed,
+  installFailed,
+  waitingForStable,
+}
+
+class _PlotinaUpdaterPageState extends State<PlotinaUpdaterPage>
+    with WidgetsBindingObserver {
+  _Stage _stage = _Stage.checking;
+  UpdateManifest? _manifest;
+  double? _progress;
+  String _versionName = '';
+  bool _canceled = false;
+  bool _flowRunning = false;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    // The first frame already shows the "checking" state; the work itself
+    // starts after inflation so that its setState calls are legal.
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (mounted) unawaited(_run());
+    });
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    // Leaving the page cancels an in-flight download; the file sink is closed
+    // by the flow itself, so nothing keeps writing into the cache.
+    _canceled = true;
+    super.dispose();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    // Returning from the "install unknown apps" settings page: continue
+    // automatically when the permission arrived, stay on the explanation
+    // when it did not.
+    if (state != AppLifecycleState.resumed) return;
+    if (_stage != _Stage.needsPermission || _flowRunning) return;
+    unawaited(_resumeAfterPermission());
+  }
+
+  Future<void> _resumeAfterPermission() async {
+    if (!await PlotinaUpdater.canRequestInstall()) return;
+    if (!mounted) return;
+    _startFlow();
+  }
+
+  Future<void> _run() async {
+    final preload = widget.manifest;
+    if (preload != null && widget.autoStart) {
+      _manifest = preload;
+      _startFlow();
+      return;
+    }
+    if (mounted) {
+      setState(() {
+        _stage = _Stage.checking;
+        _progress = null;
+      });
+    }
+    final manifest = preload ?? await PlotinaUpdater.fetchManifest();
+    final decision = await PlotinaUpdater.decide(manifest);
+    if (!mounted) return;
+    switch (decision) {
+      case UpdateDecision.upToDate:
+        final info = await PlotinaUpdater.packageInfoProvider();
+        if (!mounted) return;
+        setState(() {
+          _versionName = info.version;
+          _stage = _Stage.upToDate;
+        });
+      case UpdateDecision.checkFailed:
+        setState(() => _stage = _Stage.checkFailed);
+      case UpdateDecision.armv7Only:
+        setState(() => _stage = _Stage.armv7Only);
+      case UpdateDecision.updateAvailable:
+        setState(() {
+          _manifest = manifest;
+          _stage = _Stage.available;
+        });
+      case UpdateDecision.waitingForStable:
+        final info = await PlotinaUpdater.packageInfoProvider();
+        if (!mounted) return;
+        setState(() {
+          _versionName = info.version;
+          _stage = _Stage.waitingForStable;
+        });
+    }
+  }
+
+  void _startFlow() {
+    final manifest = _manifest;
+    if (manifest == null || _flowRunning) return;
+    _flowRunning = true;
+    _canceled = false;
+    setState(() {
+      _stage = _Stage.downloading;
+      _progress = null;
+    });
+    unawaited(_flow(manifest));
+  }
+
+  Future<void> _flow(UpdateManifest manifest) async {
+    final InstallOutcome outcome;
+    try {
+      final target = await (widget.fileProvider ??
+          PlotinaUpdater.cachedApkFile)();
+      outcome = await PlotinaUpdater.runInstallFlow(
+        manifest: manifest,
+        target: target,
+        onProgress: (fraction) {
+          if (mounted) setState(() => _progress = fraction);
+        },
+        isCanceled: () => _canceled,
+      );
+    } catch (e, s) {
+      // runInstallFlow converts its own failures into outcomes; a throw here
+      // is a bug or a platform shock. Report it and leave the downloading
+      // state - never sit at "100 %" forever, which is exactly what the
+      // dialog-based .25 flow did.
+      Logs().w('Updater: the install flow threw', e, s);
+      _flowRunning = false;
+      if (mounted) {
+        setState(() {
+          _progress = null;
+          _stage = _Stage.downloadFailed;
+        });
+      }
+      return;
+    }
+    _flowRunning = false;
+    if (!mounted) return;
+    setState(() {
+      _progress = null;
+      _stage = switch (outcome) {
+        InstallOutcome.installerOpened => _Stage.installerOpened,
+        InstallOutcome.needsPermission => _Stage.needsPermission,
+        InstallOutcome.canceled => _Stage.available,
+        InstallOutcome.downloadFailed => _Stage.downloadFailed,
+        InstallOutcome.verifyFailed => _Stage.verifyFailed,
+        InstallOutcome.installFailed => _Stage.installFailed,
+      };
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final scheme = theme.colorScheme;
+    final l10n = L10n.of(context);
+
+    // Every colour comes from the app theme explicitly: scaffold, app bar,
+    // headings, body text, card and progress track. A light default leaking
+    // through is impossible.
+
+    Widget stage;
+    switch (_stage) {
+      case _Stage.checking:
+        stage = _Info(
+          icon: null,
+          indicator: const CircularProgressIndicator(),
+          headline: l10n.checkingUpdates,
+          body: null,
+          actions: const [],
+        );
+      case _Stage.upToDate:
+        stage = _Info(
+          icon: Icon(
+            Icons.check_circle_outline_rounded,
+            size: 56,
+            color: scheme.primary,
+          ),
+          headline: l10n.noUpdatesAvailable,
+          body: l10n.updateIsLatest(_versionName),
+          actions: const [],
+        );
+      case _Stage.checkFailed:
+        stage = _Info(
+          icon: Icon(Icons.wifi_off_rounded, size: 56, color: scheme.error),
+          headline: l10n.updateCheckFailed,
+          body: null,
+          actions: [
+            FilledButton.icon(
+              onPressed: () => unawaited(_run()),
+              icon: const Icon(Icons.refresh),
+              label: Text(l10n.updateRetry),
+            ),
+          ],
+        );
+      case _Stage.armv7Only:
+        stage = _Info(
+          icon: Icon(Icons.smartphone_rounded, size: 56, color: scheme.tertiary),
+          headline: l10n.updateArm64Only,
+          body: null,
+          actions: const [],
+        );
+      case _Stage.waitingForStable:
+        // Passive by design: nothing to install, but never the false
+        // "no updates" claim — the next stable release is what moves this
+        // device back to the normal upgrade path.
+        stage = _Info(
+          icon: Icon(
+            Icons.hourglass_top_rounded,
+            size: 56,
+            color: scheme.secondary,
+          ),
+          headline: l10n.updateWaitingForStable,
+          body: l10n.updateIsLatest(_versionName),
+          actions: const [],
+        );
+      default:
+        // One of the manifest-carrying stages. A missing manifest here is a
+        // broken state, not a crash: fall back to the failed-check view.
+        final manifest = _manifest;
+        if (manifest == null) {
+          stage = _Info(
+            icon: Icon(
+              Icons.error_outline_rounded,
+              size: 56,
+              color: scheme.error,
+            ),
+            headline: l10n.updateCheckFailed,
+            body: null,
+            actions: [
+              FilledButton.icon(
+                onPressed: () => unawaited(_run()),
+                icon: const Icon(Icons.refresh),
+                label: Text(l10n.updateRetry),
+              ),
+            ],
+          );
+        } else {
+          stage = switch (_stage) {
+            _Stage.available => _UpdateCard(
+              manifest: manifest,
+              onStart: _startFlow,
+            ),
+            _Stage.needsPermission => _Info(
+              icon: Icon(
+                Icons.verified_user_outlined,
+                size: 56,
+                color: scheme.primary,
+              ),
+              headline: l10n.updateUnknownSourcesTitle,
+              body: l10n.updateInstallPermissionHint,
+              actions: [
+                FilledButton.icon(
+                  onPressed: () =>
+                      unawaited(PlotinaUpdater.openUnknownSourcesSettings()),
+                  icon: const Icon(Icons.settings_outlined),
+                  label: Text(l10n.updateOpenSettings),
+                ),
+              ],
+            ),
+            _Stage.downloading => _Downloading(
+              progress: _progress,
+              onCancel: () => _canceled = true,
+            ),
+            _Stage.installerOpened => _Info(
+              icon: Icon(
+                Icons.download_done_rounded,
+                size: 56,
+                color: scheme.primary,
+              ),
+              headline: l10n.updateInstallerOpened,
+              body: null,
+              actions: [
+                TextButton(
+                  onPressed: () => Navigator.of(context).pop(),
+                  child: Text(l10n.close),
+                ),
+              ],
+            ),
+            _Stage.downloadFailed || _Stage.installFailed => _Info(
+              icon: Icon(
+                Icons.error_outline_rounded,
+                size: 56,
+                color: scheme.error,
+              ),
+              headline: l10n.updateFailed,
+              body: null,
+              actions: [
+                FilledButton.icon(
+                  onPressed: _startFlow,
+                  icon: const Icon(Icons.refresh),
+                  label: Text(l10n.updateRetry),
+                ),
+              ],
+            ),
+            _Stage.verifyFailed => _Info(
+              icon: Icon(
+                Icons.report_gmailerrorred_rounded,
+                size: 56,
+                color: scheme.error,
+              ),
+              headline: l10n.updateVerifyFailed,
+              body: null,
+              actions: [
+                FilledButton.icon(
+                  onPressed: _startFlow,
+                  icon: const Icon(Icons.refresh),
+                  label: Text(l10n.updateRetry),
+                ),
+              ],
+            ),
+            _ => _Info(
+              icon: Icon(
+                Icons.error_outline_rounded,
+                size: 56,
+                color: scheme.error,
+              ),
+              headline: l10n.updateCheckFailed,
+              body: null,
+              actions: [
+                FilledButton.icon(
+                  onPressed: () => unawaited(_run()),
+                  icon: const Icon(Icons.refresh),
+                  label: Text(l10n.updateRetry),
+                ),
+              ],
+            ),
+          };
+        }
+    }
+
+    return Scaffold(
+      backgroundColor: theme.scaffoldBackgroundColor,
+      appBar: AppBar(
+        backgroundColor: theme.appBarTheme.backgroundColor,
+        foregroundColor: theme.appBarTheme.foregroundColor,
+        title: Text(l10n.checkForUpdates),
+      ),
+      body: SafeArea(
+        child: SingleChildScrollView(
+          padding: const EdgeInsets.all(24),
+          child: Center(child: ConstrainedBox(constraints: const BoxConstraints(maxWidth: 480), child: stage)),
+        ),
+      ),
+    );
+  }
+}
+
+class _Info extends StatelessWidget {
+  const _Info({
+    required this.icon,
+    this.indicator,
+    required this.headline,
