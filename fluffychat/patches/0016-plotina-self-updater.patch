@@ -0,0 +1,486 @@
+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/// plotina.cc: in-app updater for the Android APK.
+///
+/// We do not ship through Google Play: the APK is published on
+/// https://plotina.cc/dl. The app periodically (at most once a day, from
+/// `UpdateNotifier.showUpdateAvailableBanner`) and on demand (Settings ->
+/// "Check for updates") fetches
+///
+///   https://plotina.cc/dl/update-mobile.json
+///
+/// which the CI writes next to the APKs on every release:
+///
+///   {"client":"mobile","package":"cc.plotina.mobile","versionName":"2.11.3",
+///    "versionCode":2112323,"apkUrl":"https://plotina.cc/dl/Plotina-Mobile.apk",
+///    "sha256":"HEX","size":BYTES,"notes":"short text"}
+///
+/// `versionCode` is the number of the arm64 APK the CI actually built: the
+/// build number of the tag plus the ABI digit Flutter's `--split-per-abi`
+/// writes into it (see `fluffychat/scripts/version-code.py`), which is the same
+/// space our own PackageManager reports, so the comparison is apples to apples.
+///
+/// If it is greater than our own (read from the PackageManager through the
+/// `cc.plotina.mobile/updater` method channel), the user gets a dialog, the APK
+/// is streamed into the app cache while sha256 and size are verified against
+/// the manifest, and a verified file is handed to the system installer through
+/// a FileProvider content:// URI. Android 8+ refuses the handoff unless the
+/// user granted this package "install unknown apps"; we detect that with
+/// `canRequestPackageInstalls()` and send the user to the matching settings
+/// page with an explanation before downloading anything. The manifest offers
+/// only the arm64 APK, so a 32-bit-only device is told to fetch the armv7 APK
+/// by hand instead of being handed a file the installer would reject.
+///
+/// The manifest URL can be pointed at a local server for testing with
+/// `--dart-define=PLOTINA_UPDATE_URL=http://10.0.2.2:8000/update-mobile.json`.
+library;
+
+import 'dart:async';
+import 'dart:io';
+
+import 'package:crypto/crypto.dart';
+import 'package:fluffychat/config/setting_keys.dart';
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/utils/platform_infos.dart';
+import 'package:fluffychat/utils/updater/update_manifest.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:http/http.dart' as http;
+import 'package:matrix/matrix.dart';
+import 'package:package_info_plus/package_info_plus.dart';
+import 'package:path_provider/path_provider.dart';
+
+abstract class PlotinaUpdater {
+  static const MethodChannel _channel = MethodChannel(
+    'cc.plotina.mobile/updater',
+  );
+
+  static const String _defaultManifestUrl =
+      'https://plotina.cc/dl/update-mobile.json';
+  static const String _manifestUrl = String.fromEnvironment(
+    'PLOTINA_UPDATE_URL',
+    defaultValue: _defaultManifestUrl,
+  );
+
+  /// Last versionCode the user declined on the update dialog. Silent daily
+  /// checks skip that version; "Check for updates" shows it again.
+  static const String _dismissedKey = 'plotina.updater.dismissed_version_code';
+
+  static const Duration _fetchTimeout = Duration(seconds: 20);
+
+  /// True on the platforms where the updater makes sense.
+  static bool get isSupported => PlatformInfos.isAndroid;
+
+  /// Reads our own versionCode from the PackageManager, so it always matches
+  /// what is installed (the build number comes from the release tag, see
+  /// `fluffychat/scripts/version-code.py`).
+  static Future<int> currentVersionCode() async {
+    try {
+      return await _channel.invokeMethod<int>('getVersionCode') ?? -1;
+    } catch (e, s) {
+      Logs().w('Updater: getVersionCode failed', e, s);
+      return -1;
+    }
+  }
+
+  /// Whether this device can install the arm64 APK the manifest offers.
+  /// Defaults to true when the native side does not answer (an updater built
+  /// without the channel should not silently stop checking).
+  static Future<bool> _canInstallArm64() async {
+    try {
+      return await _channel.invokeMethod<bool>('canInstallArm64') ?? true;
+    } catch (e, s) {
+      Logs().w('Updater: canInstallArm64 failed', e, s);
+      return true;
+    }
+  }
+
+  static Future<UpdateManifest?> fetchManifest() async {
+    try {
+      final response = await http
+          .get(Uri.parse(_manifestUrl))
+          .timeout(_fetchTimeout);
+      if (response.statusCode != 200) {
+        Logs().w(
+          'Updater: manifest HTTP ${response.statusCode} from $_manifestUrl',
+        );
+        return null;
+      }
+      final manifest = UpdateManifest.tryParse(response.body);
+      if (manifest == null) return null;
+      final packageName = (await PackageInfo.fromPlatform()).packageName;
+      if (manifest.client != 'mobile' || manifest.package != packageName) {
+        Logs().w(
+          'Updater: manifest is not for this package '
+          '(${manifest.client}/${manifest.package}, we are $packageName)',
+        );
+        return null;
+      }
+      return manifest;
+    } catch (e, s) {
+      Logs().w('Updater: could not fetch the update manifest', e, s);
+      return null;
+    }
+  }
+
+  /// Fetches the manifest and, if it names a newer version, walks the user
+  /// through dialog -> download -> verify -> system installer.
+  ///
+  /// `manual` is the Settings button: every failure gets a visible message.
+  /// The silent once-a-day check only speaks up when there really is an
+  /// update the user has not declined.
+  static Future<void> checkForUpdate(
+    BuildContext context, {
+    bool manual = false,
+  }) async {
+    if (!isSupported) return;
+    final l10n = L10n.of(context);
+
+    final manifest = await fetchManifest();
+    if (!context.mounted) return;
+    if (manifest == null) {
+      if (manual) _showMessage(context, l10n.updateCheckFailed);
+      return;
+    }
+
+    final localCode = await currentVersionCode();
+    // A versionCode we cannot read must not fall through to `<= -1`: the
+    // silent daily check would then offer the same update on every launch.
+    if (localCode <= 0) {
+      Logs().w(
+        'Updater: our own versionCode is unreadable, not offering an update',
+      );
+      if (manual) {
+        if (!context.mounted) return;
+        _showMessage(context, l10n.updateCheckFailed);
+      }
+      return;
+    }
+    if (manifest.versionCode <= localCode) {
+      if (manual) {
+        final localName = (await PackageInfo.fromPlatform()).version;
+        if (!context.mounted) return;
+        _showMessage(context, l10n.updateIsLatest(localName));
+      }
+      return;
+    }
+
+    // The manifest offers one arm64 APK. A 32-bit-only phone cannot install
+    // it, so the daily check stays quiet and the manual one says what to get
+    // by hand instead of handing the installer a file it rejects.
+    if (!await _canInstallArm64()) {
+      if (manual) {
+        if (!context.mounted) return;
+        _showMessage(context, l10n.updateArm64Only);
+      }
+      return;
+    }
+
+    final store = AppSettings.store;
+    if (!manual && store.getInt(_dismissedKey) == manifest.versionCode) return;
+
+    if (!context.mounted) return;
+    final start = await _showUpdateDialog(context, manifest);
+    if (!context.mounted) return;
+    if (start != true) {
+      await store.setInt(_dismissedKey, manifest.versionCode);
+      return;
+    }
+    await _downloadAndInstall(context, manifest);
+  }
+
+  static Future<bool?> _showUpdateDialog(
+    BuildContext context,
+    UpdateManifest manifest,
+  ) {
+    final l10n = L10n.of(context);
+    return showDialog<bool>(
+      context: context,
+      builder: (dialogContext) => AlertDialog(
+        title: Text(l10n.updateAvailable(manifest.versionName)),
+        content: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            if (manifest.notes.isNotEmpty) Text(manifest.notes),
+            Text(
+              _prettySize(manifest.size),
+              style: Theme.of(dialogContext).textTheme.bodySmall,
+            ),
+          ],
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(dialogContext).pop(false),
+            child: Text(l10n.later),
+          ),
+          FilledButton.icon(
+            onPressed: () => Navigator.of(dialogContext).pop(true),
+            icon: const Icon(Icons.file_download_outlined),
+            label: Text(l10n.updateDownloadInstall),
+          ),
+        ],
+      ),
+    );
+  }
+
+  static Future<void> _downloadAndInstall(
+    BuildContext context,
+    UpdateManifest manifest,
+  ) async {
+    final l10n = L10n.of(context);
+
+    // Ask for the permission *before* burning the mobile data: without
+    // "install unknown apps" the handoff below is refused by the system.
+    final canInstall =
+        await _channel.invokeMethod<bool>('canRequestInstall') ?? false;
+    if (!canInstall) {
+      if (!context.mounted) return;
+      await _explainUnknownSources(context);
+      return;
+    }
+
+    final file = await _cachedApkFile();
+    // A verified download from an earlier attempt (e.g. the user granted the
+    // permission and came back): do not download 100 MB again.
+    if (!await _fileMatches(file, manifest)) {
+      if (!context.mounted) return;
+      final ok = await _download(context, file, manifest);
+      if (!ok) return;
+      if (!await _fileMatches(file, manifest)) {
+        await file.delete().catchError((_) => file);
+        if (!context.mounted) return;
+        _showMessage(context, l10n.updateVerifyFailed);
+        return;
+      }
+    }
+    if (!context.mounted) return;
+    try {
+      await _channel.invokeMethod('installApk', {'path': file.path});
+      if (context.mounted) _showMessage(context, l10n.updateInstallerOpened);
+    } catch (e, s) {
+      Logs().w('Updater: the installer could not be started', e, s);
+      if (context.mounted) _showMessage(context, l10n.updateFailed);
+    }
+  }
+
+  /// Streams the APK into the app cache while hashing it, with a cancellable
+  /// progress dialog. Returns true when the download completed.
+  static Future<bool> _download(
+    BuildContext context,
+    File file,
+    UpdateManifest manifest,
+  ) async {
+    final l10n = L10n.of(context);
+    final progress = ValueNotifier<double?>(null);
+    var canceled = false;
+    var dialogOpen = true;
+    final client = http.Client();
+
+    unawaited(
+      showDialog<void>(
+        context: context,
+        barrierDismissible: false,
+        builder: (dialogContext) => ValueListenableBuilder<double?>(
+          valueListenable: progress,
+          builder: (innerContext, value, _) => AlertDialog(
+            title: Text(l10n.updateDownloading),
+            content: Column(
+              mainAxisSize: MainAxisSize.min,
+              children: [
+                LinearProgressIndicator(value: value),
+                const SizedBox(height: 12),
+                Text(
+                  value == null
+                      ? _prettySize(file.existsSync() ? file.lengthSync() : 0)
+                      : '${(value * 100).round()} %',
+                ),
+              ],
+            ),
+            actions: [
+              TextButton(
+                onPressed: () {
+                  canceled = true;
+                  Navigator.of(dialogContext).pop();
+                  client.close();
+                },
+                child: Text(l10n.cancel),
+              ),
+            ],
+          ),
+        ),
+      ).whenComplete(() => dialogOpen = false),
+    );
+
+    var verified = false;
+    try {
+      verified = await _streamApk(client, file, manifest, progress);
+    } catch (e, s) {
+      if (!canceled) Logs().w('Updater: download failed', e, s);
+    } finally {
+      progress.dispose();
+      if (dialogOpen && context.mounted) {
+        Navigator.of(context).pop();
+      }
+    }
+
+    if (canceled) {
+      await file.delete().catchError((_) => file);
+      return false;
+    }
+    if (!verified) {
+      await file.delete().catchError((_) => file);
+      if (context.mounted) _showMessage(context, l10n.updateFailed);
+      return false;
+    }
+    return true;
+  }
+
+  static Future<bool> _streamApk(
+    http.Client client,
+    File file,
+    UpdateManifest manifest,
+    ValueNotifier<double?> progress,
+  ) async {
+    final request = http.Request('GET', Uri.parse(manifest.apkUrl));
+    final response = await client.send(request);
+    if (response.statusCode != 200) {
+      Logs().w(
+        'Updater: APK download HTTP ${response.statusCode} from ${manifest.apkUrl}',
+      );
+      return false;
+    }
+    final total = response.contentLength ?? manifest.size;
+
+    final digestSink = _OneShotSink<Digest>();
+    final hasher = sha256.startChunkedConversion(digestSink);
+    final sink = file.openWrite();
+    var done = 0;
+    try {
+      await for (final chunk in response.stream) {
+        sink.add(chunk);
+        hasher.add(chunk);
+        done += chunk.length;
+        if (total > 0) progress.value = (done / total).clamp(0.0, 1.0);
+      }
+    } finally {
+      await sink.flush();
+      await sink.close();
+      hasher.close();
+      client.close();
+    }
+
+    final digest = digestSink.value;
+    final expected = manifest.size;
+    final expectedSha = manifest.sha256.toLowerCase();
+    if (digest == null ||
+        digest.toString() != expectedSha ||
+        (expected > 0 && done != expected)) {
+      Logs().w(
+        'Updater: checksum/size mismatch: sha256 $digest',
+        '$done bytes; manifest says ${manifest.sha256}, $expected bytes',
+      );
+      return false;
+    }
+    return true;
+  }
+
+  static Future<void> _explainUnknownSources(BuildContext context) async {
+    final l10n = L10n.of(context);
+    await showDialog<void>(
+      context: context,
+      builder: (dialogContext) => AlertDialog(
+        icon: const Icon(Icons.verified_user_outlined),
+        title: Text(l10n.updateUnknownSourcesTitle),
+        content: Text(l10n.updateUnknownSourcesText),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(dialogContext).pop(),
+            child: Text(l10n.close),
+          ),
+          FilledButton.icon(
+            onPressed: () {
+              Navigator.of(dialogContext).pop();
+              _channel.invokeMethod('openUnknownSourcesSettings').catchError((
+                e,
+                s,
+              ) {
+                Logs().w(
+                  'Updater: cannot open the install permission page',
+                  e,
+                  s,
+                );
+              });
+            },
+            icon: const Icon(Icons.settings_outlined),
+            label: Text(l10n.updateOpenSettings),
+          ),
+        ],
+      ),
+    );
+  }
+
+  static Future<File> _cachedApkFile() async {
+    final temp = await getTemporaryDirectory();
+    // Mirrors <cache-path name="updates" path="updates"/> from
+    // res/xml/updater_file_paths.xml; only files below it reach the
+    // FileProvider content:// URI.
+    final dir = Directory('${temp.path}/updates');
+    if (!dir.existsSync()) await dir.create(recursive: true);
+    return File('${dir.path}/Plotina-Mobile.apk');
+  }
+
+  static Future<bool> _fileMatches(File file, UpdateManifest manifest) async {
+    try {
+      if (!file.existsSync()) return false;
+      if (manifest.size > 0 && file.lengthSync() != manifest.size) {
+        return false;
+      }
+      final digest = await _hashFile(file);
+      return digest.toString() == manifest.sha256.toLowerCase();
+    } catch (e, s) {
+      Logs().w('Updater: cannot reuse the cached APK', e, s);
+      return false;
+    }
+  }
+
+  static Future<Digest?> _hashFile(File file) async {
+    final sink = _OneShotSink<Digest>();
+    final hasher = sha256.startChunkedConversion(sink);
+    await for (final chunk in file.openRead()) {
+      hasher.add(chunk);
+    }
+    hasher.close();
+    return sink.value;
+  }
+
+  static void _showMessage(BuildContext context, String message) {
+    ScaffoldMessenger.of(context)
+      ..hideCurrentSnackBar()
+      ..showSnackBar(SnackBar(content: Text(message)));
+  }
+
+  static String _prettySize(int bytes) {
+    if (bytes <= 0) return '';
+    const units = ['B', 'KB', 'MB', 'GB'];
+    var size = bytes.toDouble();
+    var unit = 0;
+    while (size >= 1024 && unit < units.length - 1) {
+      size /= 1024;
+      unit++;
+    }
+    return '${size.toStringAsFixed(size >= 10 || unit == 0 ? 0 : 1)} ${units[unit]}';
+  }
+}
+
+/// Sink that keeps the single value a chunked converter closes with.
+class _OneShotSink<T> implements Sink<T> {
+  T? _value;
+  T? get value => _value;
+  @override
+  void add(T data) => _value = data;
+  @override
+  void close() {}
+}
diff --git a/lib/utils/updater/update_manifest.dart b/lib/utils/updater/update_manifest.dart
new file mode 100644
index 0000000..5f150ad
--- /dev/null
+++ b/lib/utils/updater/update_manifest.dart
@@ -0,0 +1,94 @@
+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/// The JSON published next to the APKs on every release (CI step
+/// "Write the updater manifest" in .github/workflows/build-fluffychat.yml):
+///
+/// ```json
+/// {"client":"mobile","package":"cc.plotina.mobile","versionName":"2.11.3",
+///  "versionCode":2112323,"apkUrl":"https://plotina.cc/dl/Plotina-Mobile.apk",
+///  "sha256":"<hex>","size":<bytes>,"notes":"<short ru text>"}
+/// ```
+///
+/// `versionCode` is read back out of the built arm64 APK, so it already
+/// includes the ABI digit `--split-per-abi` adds and lives in the same number
+/// space as the PackageManager value the updater compares it against.
+library;
+
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart';
+import 'package:matrix/matrix.dart';
+
+final RegExp _sha256Hex = RegExp(r'^[0-9a-fA-F]{64}$');
+
+class UpdateManifest {
+  const UpdateManifest({
+    required this.client,
+    required this.package,
+    required this.versionName,
+    required this.versionCode,
+    required this.apkUrl,
+    required this.sha256,
+    required this.size,
+    required this.notes,
+  });
+
+  final String client;
+  final String package;
+  final String versionName;
+  final int versionCode;
+  final String apkUrl;
+
+  /// Lowercase hex sha256 of the APK the updater must download.
+  final String sha256;
+  final int size;
+  final String notes;
+
+  /// Parsed fields are validated but not trusted: the caller must still check
+  /// `package` and verify the download against `sha256`/`size`.
+  ///
+  /// Returns null (never throws) on malformed or inconsistent JSON so a
+  /// broken or hostile manifest cannot crash the daily check.
+  static UpdateManifest? tryParse(String body) {
+    try {
+      final Object? json = jsonDecode(body);
+      if (json is! Map<String, Object?>) return null;
+      final manifest = UpdateManifest(
+        client: json['client'] as String? ?? '',
+        package: json['package'] as String? ?? '',
+        versionName: json['versionName'] as String? ?? '',
+        versionCode: _toInt(json['versionCode']),
+        apkUrl: json['apkUrl'] as String? ?? '',
+        sha256: (json['sha256'] as String? ?? '').toLowerCase(),
+        size: _toInt(json['size']),
+        notes: json['notes'] as String? ?? '',
+      );
+      if (!manifest.isPlausible) {
+        Logs().w('Updater: rejecting implausible manifest', body);
+        return null;
+      }
+      return manifest;
+    } catch (e, s) {
+      Logs().w('Updater: manifest is not valid JSON', e, s);
+      return null;
+    }
+  }
+
+  static int _toInt(Object? value) => switch (value) {
+    final int v => v,
+    final double v => v.round(),
+    final String v => int.tryParse(v) ?? -1,
+    _ => -1,
+  };
+
+  bool get isPlausible =>
+      versionCode > 0 &&
+      size > 0 &&
+      versionName.isNotEmpty &&
+      _sha256Hex.hasMatch(sha256) &&
+      Uri.tryParse(apkUrl)?.hasAbsolutePath == true &&
+      // Never hand the installer a cleartext download in release builds.
+      (kDebugMode || apkUrl.startsWith('https://'));
+}
