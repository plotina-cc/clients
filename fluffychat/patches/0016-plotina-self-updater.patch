+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/// plotina.cc: the "Update channel" settings row (patch 0016, dev feed).
+///
+/// Stable is the default and the only feed that has ever been used; Dev is a
+/// strict opt-in that points this install at the `dev-latest` GitHub release
+/// (see `PlotinaUpdater.manifestUrlFor`). Switching channels persists to the
+/// shared settings store, so the choice survives updates and restarts, and
+/// switching back to stable while a dev build runs explains that the device
+/// waits for the *next* stable release (`explainChannelSwitch`) instead of
+/// pretending there is nothing to do.
+
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/utils/updater/plotina_updater.dart';
+import 'package:material_ui/material_ui.dart';
+
+class UpdateChannelTile extends StatelessWidget {
+  const UpdateChannelTile({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = L10n.of(context);
+    // The notifier only carries in-session switches; the store is the truth
+    // and is re-read here on every rebuild, which is exactly what the tile
+    // must show.
+    return ValueListenableBuilder<UpdateChannel>(
+      valueListenable: PlotinaUpdater.channelNotifier,
+      builder:
+          (context, _, child) => ListTile(
+            leading: const Icon(Icons.tune_rounded),
+            title: Text(l10n.updateChannelTitle),
+            subtitle: Text(_channelLabel(l10n, PlotinaUpdater.channelProvider())),
+            onTap: () => showUpdateChannelDialog(context),
+          ),
+    );
+  }
+}
+
+String _channelLabel(L10n l10n, UpdateChannel channel) =>
+    channel == UpdateChannel.dev
+    ? l10n.updateChannelDev
+    : l10n.updateChannelStable;
+
+Future<void> showUpdateChannelDialog(BuildContext context) async {
+  final l10n = L10n.of(context);
+  final before = PlotinaUpdater.channelProvider();
+  var selected = before;
+
+  await showDialog<void>(
+    context: context,
+    builder:
+        (dialogContext) => StatefulBuilder(
+          builder: (dialogContext, setState) {
+            final dialogL10n = L10n.of(dialogContext);
+            return AlertDialog(
+              title: Text(dialogL10n.updateChannelTitle),
+              content: Column(
+                mainAxisSize: MainAxisSize.min,
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  _ChannelOption(
+                    title: dialogL10n.updateChannelStable,
+                    description: dialogL10n.updateChannelStableDescription,
+                    selected: selected == UpdateChannel.stable,
+                    onTap: () => setState(() => selected = UpdateChannel.stable),
+                  ),
+                  _ChannelOption(
+                    title: dialogL10n.updateChannelDev,
+                    description: dialogL10n.updateChannelDevDescription,
+                    selected: selected == UpdateChannel.dev,
+                    onTap: () => setState(() => selected = UpdateChannel.dev),
+                  ),
+                  if (selected == UpdateChannel.dev) ...[
+                    const SizedBox(height: 8),
+                    Row(
+                      crossAxisAlignment: CrossAxisAlignment.start,
+                      children: [
+                        Icon(
+                          Icons.warning_amber_rounded,
+                          color: Theme.of(dialogContext).colorScheme.error,
+                          size: 18,
+                        ),
+                        const SizedBox(width: 8),
+                        Expanded(
+                          child: Text(
+                            dialogL10n.updateChannelDevWarning,
+                            style: Theme.of(dialogContext).textTheme.bodySmall
+                                ?.copyWith(
+                                  color:
+                                      Theme.of(
+                                        dialogContext,
+                                      ).colorScheme.onSurfaceVariant,
+                                ),
+                          ),
+                        ),
+                      ],
+                    ),
+                  ],
+                ],
+              ),
+              actions: [
+                TextButton(
+                  onPressed: () => Navigator.of(dialogContext).pop(),
+                  child: Text(dialogL10n.cancel),
+                ),
+                FilledButton(
+                  onPressed: () => Navigator.of(dialogContext).pop(true),
+                  child: Text(dialogL10n.ok),
+                ),
+              ],
+            );
+          },
+        ),
+  );
+
+  if (selected == before) return;
+  await PlotinaUpdater.setChannel(selected);
+  if (!context.mounted) return;
+  await PlotinaUpdater.explainChannelSwitch(context, selected);
+}
+
+class _ChannelOption extends StatelessWidget {
+  const _ChannelOption({
+    required this.title,
+    required this.description,
+    required this.selected,
+    required this.onTap,
+  });
+
+  final String title;
+  final String description;
+  final bool selected;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    return InkWell(
+      onTap: onTap,
+      borderRadius: BorderRadius.circular(12),
+      child: Padding(
+        padding: const EdgeInsets.symmetric(vertical: 8, horizontal: 4),
+        child: Row(
+          children: [
+            Icon(
+              selected
+                  ? Icons.radio_button_checked_rounded
+                  : Icons.radio_button_unchecked_rounded,
+              color:
+                  selected
+                      ? theme.colorScheme.primary
+                      : theme.colorScheme.onSurfaceVariant,
+            ),
+            const SizedBox(width: 12),
+            Expanded(
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Text(
+                    title,
+                    style: theme.textTheme.titleSmall?.copyWith(
+                      color: theme.colorScheme.onSurface,
+                    ),
+                  ),
+                  Text(
+                    description,
+                    style: theme.textTheme.bodySmall?.copyWith(
+                      color: theme.colorScheme.onSurfaceVariant,
+                    ),
+                  ),
+                ],
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
