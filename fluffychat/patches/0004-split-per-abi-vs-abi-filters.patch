# Plotina-Patch: split per abi vs abi filters.
# Plotina-Marker: plotina-patch-0004-abi-filters
# Plotina-Note: this patch is build-level and ships no runtime string of its own, so it
#   writes its marker into android/app/src/main/assets/plotina-patches/0004-abi-filters.txt, which the artifact carries verbatim; the gate
#   looks for it there.

diff --git a/android/app/build.gradle.kts b/android/app/build.gradle.kts
index aa03a32..5fe387f 100644
--- a/android/app/build.gradle.kts
+++ b/android/app/build.gradle.kts
@@ -71,8 +71,15 @@ android {
         targetSdk = flutter.targetSdkVersion
         versionCode = flutter.versionCode
         versionName = flutter.versionName
-        ndk { // Workaround for https://github.com/flutter/flutter/issues/162153#issuecomment-2612443642
-            abiFilters += listOf("armeabi-v7a", "arm64-v8a", "x86_64", "x86")
+        // Workaround for https://github.com/flutter/flutter/issues/162153#issuecomment-2612443642
+        // plotina.cc: AGP rejects ndk abiFilters when ABI splits are enabled
+        // ("Conflicting configuration ... cannot be present when splits abi filters
+        // are set") and our build passes --split-per-abi, so the workaround only
+        // applies to fat builds, which is the case the Flutter issue describes.
+        if (project.findProperty("split-per-abi")?.toString()?.toBoolean() != true) {
+            ndk {
+                abiFilters += listOf("armeabi-v7a", "arm64-v8a", "x86_64", "x86")
+            }
         }
     }
 

diff --git a/android/app/src/main/assets/plotina-patches/0004-abi-filters.txt b/android/app/src/main/assets/plotina-patches/0004-abi-filters.txt
new file mode 100644
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111
--- /dev/null
+++ b/android/app/src/main/assets/plotina-patches/0004-abi-filters.txt
@@ -0,0 +1 @@
+plotina-patch-0004-abi-filters
