+        // applies to fat builds, which is the case the Flutter issue describes.
+        if (project.findProperty("split-per-abi")?.toString()?.toBoolean() != true) {
+            ndk {
+                abiFilters += listOf("armeabi-v7a", "arm64-v8a", "x86_64", "x86")
