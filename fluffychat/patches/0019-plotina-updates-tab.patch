diff --git a/lib/pages/updater/plotina_updates_page.dart b/lib/pages/updater/plotina_updates_page.dart
new file mode 100644
index 0000000..6989efb
--- /dev/null
+++ b/lib/pages/updater/plotina_updates_page.dart
@@ -0,0 +1,51 @@
+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+/// plotina.cc: one settings entry for everything update-related.
+///
+/// The top-level settings list used to expose "Check for updates" and
+/// "Update channel" as two separate rows. This page keeps the primary action
+/// first and the channel choice below it, so the settings list grows by one
+/// row instead of two.
+
+library;
+
+import 'package:fluffychat/l10n/l10n.dart';
+import 'package:fluffychat/pages/updater/update_channel_selector.dart';
+import 'package:fluffychat/utils/updater/plotina_updater.dart';
+import 'package:material_ui/material_ui.dart';
+
+class PlotinaUpdatesPage extends StatelessWidget {
+  const PlotinaUpdatesPage({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = L10n.of(context);
+    final theme = Theme.of(context);
+
+    return Scaffold(
+      backgroundColor: theme.scaffoldBackgroundColor,
+      appBar: AppBar(
+        backgroundColor: theme.appBarTheme.backgroundColor,
+        foregroundColor: theme.appBarTheme.foregroundColor,
+        title: Text(l10n.updates),
+      ),
+      body: SafeArea(
+        child: ListView(
+          padding: const EdgeInsets.symmetric(vertical: 8),
+          children: [
+            ListTile(
+              leading: const Icon(Icons.system_update_alt),
+              title: Text(l10n.checkForUpdates),
+              onTap: () =>
+                  PlotinaUpdater.checkForUpdate(context, manual: true),
+            ),
+            Divider(color: theme.dividerColor),
+            const UpdateChannelTile(),
+          ],
+        ),
+      ),
+    );
+  }
+}

