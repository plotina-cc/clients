+
+  /// plotina-patch-0027: a room read on another device while this app was in
+  /// the background has no sync listener to dismiss its notification — the
+  /// sync is off while we are paused — so the return to the foreground does it,
+  /// once per client of the session, through the same walk the sync listener
+  /// uses. A `resumed` that follows another `resumed` is skipped by the handler.
+  Future<void> _cancelNotificationsOfReadRoomsAfterResume(
+    AppLifecycleState? previousState,
+  ) async {
+    final l10n = L10n.of(context);
+    final flutterLocalNotificationsPlugin = FlutterLocalNotificationsPlugin();
+    for (final client in widget.clients) {
+      try {
+        await cancelNotificationsOfReadRoomsOnResume(
+          state: AppLifecycleState.resumed,
+          previousState: previousState,
+          clientName: client.clientName,
+          rooms: client.rooms,
+          l10n: l10n,
+          flutterLocalNotificationsPlugin: flutterLocalNotificationsPlugin,
+        );
+      } catch (e, s) {
+        Logs().w(
+          'plotina-patch-0027-cancel-on-resume: cancelling the notifications '
+          'of read rooms on resume failed',
+          e,
+          s,
+        );
+      }
+    }
   }
 
