+/// The `resumed` handler: dismisses the notifications of rooms that are not
+/// unread any more when the app comes back to the foreground.
+///
+/// While the app is paused no sync runs — `MatrixState` sets
+/// `backgroundSync = false` off the foreground — so the sync listener never
+/// fires, and a room read in Element X or on the desktop keeps its notification
+/// in the shade until the app is opened. The return to the foreground is the
+/// moment that knows about it, and it dismisses through the very same walk the
+/// sync listener uses: there is one place that walks the shade, not two.
+///
+/// [previousState] is the state the app was in before this event. A `resumed`
+/// that follows another `resumed` means the app never left the foreground —
+/// nothing about the rooms can have changed, so the shade is not walked again
+/// and nothing is re-posted. A real round trip through the background still
+/// walks it, and the walk itself only cancels what is read and only rebuilds
+/// the summary when something was cancelled.
+///
+/// Anything but `resumed` is not a return to the app and does nothing.
+///
+/// Returns how many notifications were cancelled, 0 when the event is skipped.
+///
+/// See patches/0027-plotina-cancel-on-resume.patch.
+Future<int> cancelNotificationsOfReadRoomsOnResume({
+  required AppLifecycleState state,
+  required AppLifecycleState? previousState,
+  required String clientName,
+  required Iterable<Room> rooms,
+  required L10n l10n,
+  required FlutterLocalNotificationsPlugin flutterLocalNotificationsPlugin,
+  bool? updateSummary,
+}) async {
+  if (state != AppLifecycleState.resumed) return 0;
+  if (previousState == AppLifecycleState.resumed) return 0;
+  return cancelNotificationsOfReadRooms(
+    clientName: clientName,
+    rooms: rooms,
+    l10n: l10n,
+    flutterLocalNotificationsPlugin: flutterLocalNotificationsPlugin,
+    updateSummary: updateSummary,
+  );
+}
+
