+/// Posts the notification `pushHelper` falls back to when the event could not
+/// be fetched in time, and returns the id it was posted under.
+///
+/// This is the body of the `catch` in [pushHelper], lifted out so a test can
+/// post the very notification a device gets instead of a hand-built one. It
+/// matters because of one field: the `groupKey` is `notification.clientName`,
+/// which is `null` for the payload shape our gateway actually delivers
+/// (`event_id_only`, no `devices` — QA `t_5d226c8d` §2 read
+/// `groupKey` absent right off the shade). The notification therefore sits in
+/// the shade *outside* every group, and a cancel walk that filtered on the
+/// group key alone closed its eyes to it — that is the notification that never
+/// went away, not the ordinary one (`t_5d226c8d` §5: ordinary path dismissed
+/// 7/7, fallback hung 3/3).
+///
+/// The id is [plotinaNotificationIdForRoom]'s, through
+/// `PushNotification.notificationId`, so show and cancel still share one
+/// formula.
+Future<int> plotinaShowFallbackNotification({
+  required FlutterLocalNotificationsPlugin flutterLocalNotificationsPlugin,
+  required PushNotification notification,
+  required L10n l10n,
+}) async {
+  final roomId = notification.roomId;
+  if (roomId == null) {
+    throw ArgumentError.notNull('notification.roomId');
+  }
+  final id = notification.notificationId;
+  Logs().v(
+    'plotina-patch-0026-fallback-cancel: posting the push helper fallback '
+    'under $id, groupKey: ${notification.clientName}',
+  );
+  await flutterLocalNotificationsPlugin.show(
+    id: id,
+    title: l10n.newMessageInFluffyChat,
+    body: l10n.openAppToReadMessages,
+    notificationDetails: NotificationDetails(
+      iOS: DarwinNotificationDetails(
+        threadIdentifier: '${notification.clientName}_$roomId',
+      ),
+      android: AndroidNotificationDetails(
+        AppConfig.pushNotificationsChannelId,
+        l10n.incomingMessages,
+        number: notification.counts?.unread,
+        ticker: l10n.unreadChatsInApp(
+          AppSettings.applicationName.value,
+          (notification.counts?.unread ?? 0).toString(),
+        ),
+        importance: Importance.high,
+        priority: Priority.max,
+        shortcutId: roomId,
+        category: AndroidNotificationCategory.message,
+        groupKey: notification.clientName,
+      ),
+    ),
+  );
+  return id;
+}
+
 class FluffyChatPushPayload {
   final String? clientName, roomId, eventId;
 
