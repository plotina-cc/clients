diff --git a/lib/utils/plotina_room_names.dart b/lib/utils/plotina_room_names.dart
new file mode 100644
index 0000000..4becb81
--- /dev/null
+++ b/lib/utils/plotina_room_names.dart
@@ -0,0 +1,161 @@
+// SPDX-FileCopyrightText: 2026 Plotina
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:convert';
+
+import 'package:matrix/matrix.dart';
+
+/// Plotina: personal names for direct chats.
+///
+/// The name is stored in the account data event `cc.plotina.room_aliases` as
+/// `{"<room_id>": "<personal name>"}`. It is private to the account: it never
+/// writes `m.room.name`, so the other side keeps seeing the room as before.
+/// An empty value means "reset" — [PlotinaRoomNames.setAlias] drops the key.
+/// The same event is read by Plotina Element Web/Desktop, so a name set there
+/// shows up here and vice versa.
+///
+/// Everything in this file is defensive on purpose: a missing, empty or
+/// corrupt event must never stop the app from rendering room names.
+const String plotinaRoomAliasesType = 'cc.plotina.room_aliases';
+
+/// Room ids start with `!` in every room version, including the opaque ids of
+/// room v12 (`!<base64url>`, no localpart and no `:`). This is only used to
+/// keep junk out of the map — never to decide what a room is.
+bool _looksLikeRoomId(String roomId) => roomId.trim().startsWith('!');
+
+/// Parses the content of the `cc.plotina.room_aliases` account data event.
+///
+/// Accepts the normal Matrix shape (a JSON object, already decoded into a map
+/// by the SDK) and, for tolerance, a string holding that JSON. Anything else —
+/// `null`, a list, a number, malformed JSON, non-string or blank values — is
+/// skipped instead of throwing.
+Map<String, String> parsePlotinaRoomAliases(Object? content) {
+  var raw = content;
+  if (raw is String) {
+    try {
+      raw = jsonDecode(raw);
+    } catch (_) {
+      return const <String, String>{};
+    }
+  }
+  if (raw is! Map) return const <String, String>{};
+  final aliases = <String, String>{};
+  for (final entry in raw.entries) {
+    final roomId = entry.key;
+    final name = entry.value;
+    if (roomId is! String || !_looksLikeRoomId(roomId)) continue;
+    if (name is! String) continue;
+    final trimmed = name.trim();
+    if (trimmed.isEmpty) continue;
+    aliases[roomId] = trimmed;
+  }
+  return aliases;
+}
+
+/// The personal name to use for [roomId], or `null` when there is none.
+///
+/// Groups are never renamed: `m.room.name` is the room's own name and the
+/// personal-name contract only covers direct chats.
+String? plotinaAliasFor(
+  Map<String, String> aliases,
+  String roomId, {
+  required bool isDirectChat,
+}) {
+  if (!isDirectChat) return null;
+  return aliases[roomId];
+}
+
+/// Applies [aliases] to an already computed display name.
+///
+/// Split out from [PlotinaRoomDisplayname.plotinaDisplayname] so the decision
+/// is testable without a Matrix client.
+String plotinaDisplaynameFor({
+  required String fallback,
+  required Map<String, String> aliases,
+  required String roomId,
+  required bool isDirectChat,
+}) {
+  return plotinaAliasFor(aliases, roomId, isDirectChat: isDirectChat) ??
+      fallback;
+}
+
+/// Returns the account data content to write after setting [name] for [roomId].
+///
+/// `null` or a blank [name] removes the room's key (the reset semantics of the
+/// shared contract). Every other entry is kept, but entries that are not
+/// non-blank strings are dropped, so the event never ends up with unnamed
+/// rooms in it.
+Map<String, Object?> plotinaAliasesAfterSet(
+  Object? current,
+  String roomId,
+  String? name,
+) {
+  final next = <String, Object?>{};
+  if (current is Map) {
+    for (final entry in current.entries) {
+      final key = entry.key;
+      final value = entry.value;
+      if (key is! String || !_looksLikeRoomId(key) || key == roomId) continue;
+      if (value is! String) continue;
+      final trimmed = value.trim();
+      if (trimmed.isEmpty) continue;
+      next[key] = trimmed;
+    }
+  }
+  final trimmed = (name ?? '').trim();
+  if (trimmed.isNotEmpty) next[roomId] = trimmed;
+  return next;
+}
+
+/// Reads and writes the personal names of the signed-in account.
+class PlotinaRoomNames {
+  const PlotinaRoomNames._();
+
+  static const String type = plotinaRoomAliasesType;
+
+  /// All personal names of [client], keyed by room id.
+  static Map<String, String> aliasesOf(Client client) =>
+      parsePlotinaRoomAliases(client.accountData[type]?.content);
+
+  /// The personal name of [room], or `null` if it has none or is not a DM.
+  static String? aliasOf(Room room) => plotinaAliasFor(
+    aliasesOf(room.client),
+    room.id,
+    isDirectChat: room.isDirectChat,
+  );
+
+  /// Sets the personal name of [room]; empty or `null` resets it.
+  ///
+  /// Writes only [type] account data. `m.room.name` is never touched, and
+  /// groups are ignored — the personal name is a direct-chat feature.
+  static Future<void> setAlias(Room room, String? name) async {
+    if (!room.isDirectChat) return;
+    final client = room.client;
+    final userID = client.userID;
+    if (userID == null) return;
+    final content = plotinaAliasesAfterSet(
+      client.accountData[type]?.content,
+      room.id,
+      name,
+    );
+    await client.setAccountData(userID, type, content);
+    // The /sync echo carries the same event a moment later; applying it here
+    // as well means the list and the open chat update without waiting for it.
+    client.accountData[type] = BasicEvent(type: type, content: content);
+  }
+}
+
+/// The room name as this account sees it: the personal name of a direct chat
+/// when one is set, otherwise exactly [Room.getLocalizedDisplayname].
+///
+/// This is the single point where `cc.plotina.room_aliases` is applied. Use it
+/// instead of `getLocalizedDisplayname()` everywhere a room name is shown.
+extension PlotinaRoomDisplayname on Room {
+  String plotinaDisplayname([
+    MatrixLocalizations i18n = const MatrixDefaultLocalizations(),
+  ]) {
+    final alias = PlotinaRoomNames.aliasOf(this);
+    if (alias != null) return alias;
+    return getLocalizedDisplayname(i18n);
+  }
+}
