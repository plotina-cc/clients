diff --git a/lib/utils/plotina_contact_name_entry.dart b/lib/utils/plotina_contact_name_entry.dart
new file mode 100644
index 0000000..cf10597
--- /dev/null
+++ b/lib/utils/plotina_contact_name_entry.dart
@@ -0,0 +1,113 @@
+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'package:matrix/matrix.dart';
+
+import 'plotina_contact_names.dart';
+
+/// Plotina: the two places that name a *person* outside the SDK resolver.
+///
+/// Everything else in this tree gets the personal name for free: patch 0023
+/// installs one resolver on the client, and every name the SDK derives from
+/// member state — author line, participant list, mentions, DM title — goes
+/// through `User.displayName`. Two call sites do not:
+///
+///  * the chat list entry "Личное имя" writes a name, so it has to decide
+///    *whose* name it is writing (the contact, not the chat);
+///  * the invite banner builds the chat's label from `room.name` and the
+///    canonical alias by hand, in parallel to the title bar.
+///
+/// Both are resolved here, by mxid, so they can be tested without a widget.
+
+/// The mxid whose personal name the chat list entry edits, or `null` when the
+/// room is not a direct chat.
+///
+/// `Room.directChatMatrixID` is the `m.direct` partner, or the inviter of a
+/// room invited with `is_direct: true`; `Room.isDirectChat` is exactly
+/// "that is not null". A group has no contact to rename, so the entry is not
+/// offered for it.
+String? plotinaPersonalNameContactOf(Room room) => room.directChatMatrixID;
+
+/// The personal name currently set for [room]'s contact, or `null`.
+String? plotinaPersonalNameOf(Room room) {
+  final userId = plotinaPersonalNameContactOf(room);
+  if (userId == null) return null;
+  return PlotinaContactNames.nameOf(room.client, userId);
+}
+
+/// What the dialog hints at: the name the contact is known by to everyone
+/// else, never the personal one (a hint repeating the field would be useless).
+String plotinaPersonalNameHintOf(Room room) {
+  final userId = plotinaPersonalNameContactOf(room);
+  if (userId == null) return '';
+  final raw = room.unsafeGetUserFromMemoryOrFallback(userId).rawDisplayName;
+  if (raw != null && raw.trim().isNotEmpty) return raw;
+  return userId;
+}
+
+/// Stores [name] as the personal name of the contact this direct chat is with.
+///
+/// Writes only the `cc.plotina.contact_names` account data (through
+/// [PlotinaContactNames.setName]): `m.room.name` and `m.room.member` are never
+/// touched, so nobody else's room list or profile changes. A blank or `null`
+/// [name] resets it. A non-DM room is ignored — the personal name is a property
+/// of a person, not of a room.
+Future<void> setPlotinaPersonalNameOfChat(Room room, String? name) async {
+  final userId = plotinaPersonalNameContactOf(room);
+  if (userId == null) return;
+  await PlotinaContactNames.setName(room.client, userId, name);
+}
+
+/// The label the invite banner shows for [room], or `null` for "no label"
+/// (the banner then falls back to "you have been invited by" + the sender).
+///
+/// The banner is about a person, so for an invite to a direct chat the name
+/// you gave the contact wins — otherwise the banner would contradict the chat
+/// list, which resolves that same chat through the personal name. `roomName` is
+/// the room's own `m.room.name`, which the inviter may have set to their
+/// display name ("Bob Real"); the personal name is what this account wants to
+/// see instead.
+///
+/// A room that is not a direct chat keeps its own identity: its `m.room.name`,
+/// else its canonical alias. The inviter's personal name is *not* used as a
+/// room name there — that would rename a group, which the contract forbids; the
+/// inviter is already named by the sentence around this label, and that name
+/// goes through the SDK resolver anyway.
+///
+/// [inviterUserId] is the fallback person for an invite that carries
+/// `is_direct: true` in a room `m.direct` does not list yet: the sender of the
+/// invite is then the contact.
+String? plotinaInviteBannerName(
+  Room room, {
+  String? inviterUserId,
+}) => plotinaInviteBannerNameFor(
+  isDirectChat: room.isDirectChat,
+  directChatUserId: room.directChatMatrixID,
+  inviterUserId: inviterUserId,
+  roomName: room.name,
+  canonicalAlias: room.canonicalAlias,
+  contactNames: PlotinaContactNames.namesOf(room.client),
+);
+
+/// The decision behind [plotinaInviteBannerName], split out so it is testable
+/// without a `Client`.
+String? plotinaInviteBannerNameFor({
+  required bool isDirectChat,
+  String? directChatUserId,
+  String? inviterUserId,
+  required String roomName,
+  required String canonicalAlias,
+  required Map<String, String> contactNames,
+}) {
+  if (isDirectChat) {
+    final personal = plotinaContactNameFor(
+      contactNames,
+      directChatUserId ?? inviterUserId,
+    );
+    if (personal != null) return personal;
+  }
+  if (roomName.isNotEmpty) return roomName;
+  if (canonicalAlias.isNotEmpty) return canonicalAlias;
+  return null;
+}
diff --git a/lib/utils/plotina_contact_names.dart b/lib/utils/plotina_contact_names.dart
new file mode 100644
index 0000000..d236122
--- /dev/null
+++ b/lib/utils/plotina_contact_names.dart
@@ -0,0 +1,158 @@
+// SPDX-FileCopyrightText: 2026 Plotina
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:convert';
+
+import 'package:matrix/matrix.dart';
+
+/// Plotina: personal names for contacts.
+///
+/// The name is stored in the account data event `cc.plotina.contact_names` as
+/// `{"<mxid>": "<personal name>"}`. It is private to the account: nothing is
+/// ever written to `m.room.member`, so nobody else sees it and no room state
+/// changes.
+///
+/// The names are applied by the matrix SDK itself, not at the ~70 call sites
+/// that read `User.displayName` / `User.calcDisplayname()`: [install] hands the
+/// SDK one resolver ([Client.localNameResolver] from the `plotina/contact-names`
+/// patch on our fork of `matrix-dart-sdk`), and every name the SDK derives from
+/// member state goes through it — the author line under a message, the
+/// participant list, the member search filter, mentions and mention fragments,
+/// and the title of a direct chat (which the SDK builds from
+/// `hero.calcDisplayname()`).
+///
+/// Everything in this file is defensive on purpose: a missing, empty or corrupt
+/// event must never stop the app from rendering names, and a user the resolver
+/// does not know must come back as `null` so the SDK keeps its own behaviour.
+const String plotinaContactNamesType = 'cc.plotina.contact_names';
+
+/// Matrix ids look like `@localpart:server`. This only keeps junk out of the
+/// map — it is never used to decide what a user is.
+bool _looksLikeUserId(String userId) {
+  final trimmed = userId.trim();
+  if (trimmed.length < 4 || !trimmed.startsWith('@')) return false;
+  final colon = trimmed.indexOf(':');
+  return colon > 1 && colon < trimmed.length - 1;
+}
+
+/// Parses the content of the `cc.plotina.contact_names` account data event.
+///
+/// Accepts the normal Matrix shape (a JSON object, already decoded into a map
+/// by the SDK) and, for tolerance, a string holding that JSON. Anything else —
+/// `null`, a list, a number, malformed JSON, non-string or blank values — is
+/// skipped instead of throwing.
+Map<String, String> parsePlotinaContactNames(Object? content) {
+  var raw = content;
+  if (raw is String) {
+    if (raw.trim().isEmpty) return const <String, String>{};
+    try {
+      raw = jsonDecode(raw);
+    } catch (_) {
+      return const <String, String>{};
+    }
+  }
+  if (raw is! Map) return const <String, String>{};
+  final names = <String, String>{};
+  for (final entry in raw.entries) {
+    final userId = entry.key;
+    final name = entry.value;
+    if (userId is! String || !_looksLikeUserId(userId)) continue;
+    if (name is! String) continue;
+    final trimmed = name.trim();
+    if (trimmed.isEmpty) continue;
+    names[userId] = trimmed;
+  }
+  return names;
+}
+
+/// The personal name of [userId], or `null` if there is none.
+String? plotinaContactNameFor(Map<String, String> names, String? userId) {
+  if (userId == null || userId.isEmpty) return null;
+  return names[userId];
+}
+
+/// Returns the account data content to write after setting [name] for [userId].
+///
+/// `null` or a blank [name] removes the user's key, so a reset never leaves an
+/// empty value behind: when the last name goes, the event body is `{}`.
+/// Entries that are not non-blank strings under a valid mxid are dropped, so
+/// the event never ends up holding unnamed contacts.
+Map<String, Object?> plotinaContactNamesAfterSet(
+  Object? current,
+  String userId,
+  String? name,
+) {
+  final next = <String, Object?>{};
+  if (current is Map) {
+    for (final entry in current.entries) {
+      final key = entry.key;
+      final value = entry.value;
+      if (key is! String || !_looksLikeUserId(key) || key == userId) continue;
+      if (value is! String) continue;
+      final trimmed = value.trim();
+      if (trimmed.isEmpty) continue;
+      next[key] = trimmed;
+    }
+  }
+  final trimmed = (name ?? '').trim();
+  if (trimmed.isNotEmpty) next[userId] = trimmed;
+  return next;
+}
+
+/// Reads and writes the personal names of the signed-in account.
+class PlotinaContactNames {
+  const PlotinaContactNames._();
+
+  static const String type = plotinaContactNamesType;
+
+  /// All personal names of [client], keyed by mxid.
+  static Map<String, String> namesOf(Client client) =>
+      parsePlotinaContactNames(client.accountData[type]?.content);
+
+  /// The personal name of [userId] for [client], or `null` if it has none.
+  static String? nameOf(Client client, String? userId) =>
+      plotinaContactNameFor(namesOf(client), userId);
+
+  /// Sets the personal name of [userId]; blank or `null` resets it.
+  ///
+  /// Writes only the [type] account data event. `m.room.member` and the other
+  /// side's profile are never touched.
+  static Future<void> setName(
+    Client client,
+    String userId,
+    String? name,
+  ) async {
+    final ownUserId = client.userID;
+    if (ownUserId == null) return;
+    if (!_looksLikeUserId(userId)) return;
+    final content = plotinaContactNamesAfterSet(
+      client.accountData[type]?.content,
+      userId,
+      name,
+    );
+    await client.setAccountData(ownUserId, type, content);
+    // The /sync echo carries the same event a moment later; applying it here as
+    // well means the open chat and the member list update without waiting.
+    client.accountData[type] = BasicEvent(type: type, content: content);
+    // Account data does not fire a room update, so the widgets that read names
+    // (timeline, member list, chat title) would keep the old one until the next
+    // sync. Bump every room once — cheap, and it makes the rename immediate.
+    // `onUpdate` is deprecated in favour of filtering `client.onSync`, which
+    // cannot express a local edit that no sync will echo, and it is still the
+    // stream every room-scoped widget listens to.
+    for (final room in client.rooms) {
+      // ignore: deprecated_member_use
+      room.onUpdate.add(room.id);
+    }
+  }
+
+  /// Installs the resolver on [client] so the SDK reads these names.
+  ///
+  /// Call once per client, on creation. The SDK asks the resolver whenever it
+  /// derives a name from member state; it is a plain lookup in the locally held
+  /// account data, so no request is made and a missing event costs nothing.
+  static void install(Client client) {
+    client.localNameResolver = (userId) => nameOf(client, userId);
+  }
+}
