   defaultHomeserver<String>('chat.fluffy.default_homeserver', 'plotina.cc'),
   // colorSchemeSeed stored as ARGB int

diff --git a/android/app/src/main/assets/plotina-patches/0008-application-name.txt b/android/app/src/main/assets/plotina-patches/0008-application-name.txt
new file mode 100644
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111
