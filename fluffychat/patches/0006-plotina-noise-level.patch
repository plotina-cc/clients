+  int? _pendingNoiseLevel;
+
+  int get noiseLevel =>
+      _pendingNoiseLevel ?? AppSettings.noiseSuppressionLevel.value;
+
+  void previewNoiseLevel(double value) =>
+      setState(() => _pendingNoiseLevel = value.round());
