# Plotina-Patch: plotina update utf8.
# Plotina-Marker: plotina-patch-0021-update-utf8
# Plotina-Note: this patch is build-level and ships no runtime string of its own, so it
#   writes its marker into android/app/src/main/assets/plotina-patches/0021-update-utf8.txt, which the artifact carries verbatim; the gate
#   looks for it there.

diff --git a/lib/utils/updater/plotina_updater.dart b/lib/utils/updater/plotina_updater.dart
index 2e9e134..1c6af72 100644
--- a/lib/utils/updater/plotina_updater.dart
+++ b/lib/utils/updater/plotina_updater.dart
@@ -67,6 +67,8 @@ library;
 import 'dart:async';
 import 'dart:io';
 
+import 'dart:convert';
+
 import 'package:crypto/crypto.dart';
 import 'package:fluffychat/config/setting_keys.dart';
 import 'package:fluffychat/l10n/l10n.dart';
@@ -261,7 +263,12 @@ abstract class PlotinaUpdater {
         Logs().w('Updater: manifest HTTP ${response.statusCode} from $url');
         return null;
       }
-      final manifest = UpdateManifest.tryParse(response.body);
+      // GitHub serves release assets without a charset; package:http then
+      // falls back to Latin-1 and Russian notes come out as mojibake. Decode
+      // the bytes explicitly as UTF-8.
+      final manifest = UpdateManifest.tryParse(
+        utf8.decode(response.bodyBytes, allowMalformed: true),
+      );
       if (manifest == null) return null;
       final info = await packageInfoProvider();
       if (manifest.client != 'mobile' || manifest.package != info.packageName) {

diff --git a/android/app/src/main/assets/plotina-patches/0021-update-utf8.txt b/android/app/src/main/assets/plotina-patches/0021-update-utf8.txt
new file mode 100644
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111
--- /dev/null
+++ b/android/app/src/main/assets/plotina-patches/0021-update-utf8.txt
@@ -0,0 +1 @@
+plotina-patch-0021-update-utf8
