        "compound": {
          "--cpd-color-text-primary": "#ebeef2",
          "--cpd-color-text-secondary": "#808994",
          "--cpd-color-bg-canvas-default": "#1b1d22",
          "--cpd-color-bg-canvas-disabled": "#23262b",
          "--cpd-color-bg-subtle-primary": "#26282d",
          "--cpd-color-border-interactive-secondary": "#3c3f44",
          "--cpd-color-text-action-accent": "#7ee2b8",
