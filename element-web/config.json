{
  "default_server_config": {
    "m.homeserver": {
      "base_url": "https://plotina.cc",
      "server_name": "plotina.cc"
    }
  },
  "brand": "Plotina Web",
  "update_base_url": "https://github.com/plotina-cc/clients/releases",
  "disable_guests": true,
