        "is_dark": false,
        "colors": {
          "accent-color": "#17795a",
          "primary-color": "#17795a"
        },
        "compound": {
          "--cpd-color-text-primary": "#101418",
          "--cpd-color-text-secondary": "#656d77",
          "--cpd-color-bg-canvas-default": "#ffffff",
          "--cpd-color-bg-canvas-disabled": "#f7f9fa",
          "--cpd-color-bg-subtle-primary": "#e1e6ec",
          "--cpd-color-border-interactive-secondary": "#bdc4cc",
