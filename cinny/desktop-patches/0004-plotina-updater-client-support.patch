index 0000000..f796992
--- /dev/null
+++ b/src-tauri/tests/updater_signature.rs
@@ -0,0 +1,195 @@
+//! The updater is only as good as the pairing between three things that live in
+//! different places: the public key compiled into the client
+//! (`cinny/tauri.plotina.json`), the `.sig` file CI produces next to a bundle,
+//! and the bytes the edge then serves at the URL inside `latest.json`. A
+//! mismatch is invisible until somebody's client refuses an update — and it is
+//! unrecoverable for the release, because the manifest is already published.
+//!
+//! This test replays `tauri_plugin_updater::verify_signature` (the function the
+//! plugin runs before it installs anything) on the built artifact:
+//!
+//! ```text
+//! base64_to_string(config pubkey)  -> minisign_verify::PublicKey::decode
+//! base64_to_string(.sig content)   -> minisign_verify::Signature::decode
+//! public_key.verify(bytes, signature, true)      // allow_prehashed = true
+//! ```
+//!
+//! so "it verifies here" means "an installed client accepts it", with the same
+//! wrapped-base64 quirks (the `.sig` file is ONE base64 line that *contains* the
+//! minisign document, not the document itself).
+//!
+//! Two tests:
+//!
+//! * `shipped_pubkey_is_a_usable_minisign_key` always runs: the key in the
+//!   repository has to decode as a minisign public key. Copy-paste damage (a
+//!   dropped character, the private key by mistake, a wrapped line) is the
+//!   classic way to ship a client that can never verify anything.
+//! * `bundled_artifact_verifies_against_the_shipped_pubkey` runs when CI hands
+//!   it the built bundle through the environment:
+//!
+//!       PLOTINA_UPDATE_ARTIFACT=…/Plotina-Lite-Desktop.AppImage
+//!       PLOTINA_UPDATE_SIG=…/Plotina-Lite-Desktop.AppImage.sig
+//!       PLOTINA_UPDATER_CONFIG=…/cinny/tauri.plotina.json    (optional)
+//!
+//!   Absent variables mean "nothing was built here", which is not a failure for
+//!   a normal `cargo test`. A variable that points at a missing file, or a
+//!   signature that does not verify against the shipped key, is a failure — and
+//!   so is a signature that would still verify after flipping one byte.
+
+use base64::Engine as _;
+use minisign_verify::{PublicKey, Signature};
+use std::path::{Path, PathBuf};
+
+fn config_path() -> PathBuf {
+    if let Ok(path) = std::env::var("PLOTINA_UPDATER_CONFIG") {
+        return PathBuf::from(path);
+    }
+    // src-tauri -> upstream -> cinny (our overlay lives beside the README)
+    Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("..")
+        .join("..")
+        .join("tauri.plotina.json")
+}
+
+/// The plugin's `base64_to_string`: standard alphabet, the result must be UTF-8.
+fn base64_to_string(value: &str) -> Result<String, String> {
+    let raw = base64::engine::general_purpose::STANDARD
+        .decode(value.trim())
+        .map_err(|e| format!("base64 decode failed: {e}"))?;
+    String::from_utf8(raw)
+        .map_err(|e| format!("decoded bytes are not utf-8: {e}"))
+}
+
+/// `plugins.updater.pubkey` from the shipped overlay, as a minisign key.
+fn shipped_public_key() -> Result<(PublicKey, String), String> {
+    let path = config_path();
+    let text = std::fs::read_to_string(&path)
+        .map_err(|e| format!("cannot read {}: {e}", path.display()))?;
+    let json: serde_json::Value =
+        serde_json::from_str(&text).map_err(|e| format!("{} is not JSON: {e}", path.display()))?;
+    let encoded = json["plugins"]["updater"]["pubkey"]
+        .as_str()
+        .ok_or_else(|| format!("no plugins.updater.pubkey in {}", path.display()))?
+        .to_string();
+    let document = base64_to_string(&encoded)?;
+    if !document.starts_with("untrusted comment: minisign public key") {
+        return Err(format!(
+            "plugins.updater.pubkey does not wrap a minisign public key (starts with {:?})",
+            document.chars().take(40).collect::<String>()
+        ));
+    }
+    let public_key = PublicKey::decode(&document)
+        .map_err(|e| format!("the pubkey in {} is not a valid minisign public key: {e}",
+                             path.display()))?;
+    Ok((public_key, encoded))
+}
+
+#[test]
+fn shipped_pubkey_is_a_usable_minisign_key() {
+    let (public_key, encoded) = shipped_public_key().expect("a usable plugins.updater.pubkey");
+    // A minisign public key carries a 32-byte ed25519 key; anything shorter means
+    // the base64 document was truncated when it was pasted into the config.
+    let document = base64_to_string(&encoded).unwrap();
+    let payload = document
+        .lines()
+        .map(str::trim)
+        .find(|line| !line.is_empty() && !line.starts_with("untrusted comment:"))
+        .expect("a base64 key line after the comment");
+    let raw = base64::engine::general_purpose::STANDARD.decode(payload).unwrap();
+    assert_eq!(&raw[..2], b"Ed", "minisign public keys start with the Ed magic");
+    assert_eq!(raw.len(), 2 + 8 + 32, "public key frame must be magic+key id+32 bytes");
+    let _ = public_key;
+}
+
+#[test]
+fn bundled_artifact_verifies_against_the_shipped_pubkey() {
+    let (Ok(artifact), Ok(signature_file)) = (
+        std::env::var("PLOTINA_UPDATE_ARTIFACT"),
+        std::env::var("PLOTINA_UPDATE_SIG"),
+    ) else {
+        eprintln!(
+            "SKIP bundled_artifact_verifies_against_the_shipped_pubkey: \
+             PLOTINA_UPDATE_ARTIFACT/PLOTINA_UPDATE_SIG are not set (no bundle to check)"
+        );
+        return;
+    };
+
+    let artifact_path = PathBuf::from(&artifact);
+    let signature_path = PathBuf::from(&signature_file);
+    assert!(
+        artifact_path.is_file(),
+        "PLOTINA_UPDATE_ARTIFACT points at nothing: {}",
+        artifact_path.display()
+    );
+    assert!(
+        signature_path.is_file(),
+        "PLOTINA_UPDATE_SIG points at nothing: {}",
+        signature_path.display()
+    );
+    let artifact_name = artifact_path
+        .file_name()
+        .and_then(|n| n.to_str())
+        .unwrap_or_default()
+        .to_string();
+    assert_eq!(
+        signature_path.file_name().and_then(|n| n.to_str()),
+        Some(&format!("{artifact_name}.sig")[..]),
+        "the signature must be the one bundled with the artifact it is published for"
+    );
+
+    let (public_key, _) = shipped_public_key().expect("a usable plugins.updater.pubkey");
+    let data = std::fs::read(&artifact_path).expect("read the built artifact");
+    let wrapped = std::fs::read_to_string(&signature_path).expect("read the signature file");
+    let document = base64_to_string(wrapped.trim())
+        .unwrap_or_else(|e| panic!("{} is not the wrapped minisign document Tauri signs with: {e}",
+                                   signature_path.display()));
+    let signature = Signature::decode(&document)
+        .map_err(|e| format!("{} cannot be decoded as minisign: {e}", signature_path.display()))
+        .unwrap();
+
+    // Exactly what the plugin does before it installs anything.
+    public_key
+        .verify(&data, &signature, true)
+        .unwrap_or_else(|e| {
+            panic!(
+                "signature {} does not verify artifact {} with the shipped pubkey: {e}",
+                signature_path.display(),
+                artifact_path.display()
+            )
+        });
+
+    // And it must not verify a modified byte: proves the check is real rather
+    // than an API call that ignores its input.
+    let mut tampered = data.clone();
+    let middle = tampered.len() / 2;
+    tampered[middle] ^= 0x01;
+    assert!(
+        public_key.verify(&tampered, &signature, true).is_err(),
+        "the signature verified a modified artifact — the check is not checking"
+    );
+
+    println!(
+        "verified {} ({} bytes) against the pubkey in {}; signed file recorded as {:?}",
+        artifact_name,
+        data.len(),
+        config_path().display(),
+        document
+            .lines()
+            .find(|line| line.contains("file:"))
+            .unwrap_or("")
+            .trim()
+    );
+}
+
+#[test]
+fn path_helper_resolves_the_repository_overlay() {
+    // The default must be the file CI ships, not something that silently reads a
+    // stale copy: it is resolved from CARGO_MANIFEST_DIR, so it works from any
+    // working directory the runner happens to use.
+    let path = config_path();
+    assert!(path.ends_with("tauri.plotina.json"), "{}", path.display());
+    if std::env::var("PLOTINA_UPDATE_SIG").is_err() {
+        // A plain checkout (no build) still has the overlay next to the clone.
+        assert!(Path::new(&path).is_file(), "missing {}", path.display());
+    }
+}
