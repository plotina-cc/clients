 // mod menu;
 
+use std::sync::atomic::{AtomicUsize, Ordering};
 use tauri::{webview::{NewWindowResponse, WebviewWindowBuilder}, WebviewUrl, TitleBarStyle};
 use tauri_plugin_opener::OpenerExt;
 
+/// Label prefix of the in-app sign-in windows. Exactly one of them may be
+/// open at a time (see `find_sso_window`); the counter keeps the label of a
+/// freshly created window unique even right after an old one was closed.
+const SSO_LABEL_PREFIX: &str = "plotina-sso";
+static SSO_WINDOWS: AtomicUsize = AtomicUsize::new(0);
+
+/// Matrix sign-in URLs that have to stay inside the app.
+///
+/// Both paths hand a webview a URL and expect the answer to come back to the
+/// window that opened it:
+///
+/// - `/login/sso/redirect` -> identity provider -> `?loginToken=` back to us
+/// - `/auth/<stage>/fallback/web` -> identity provider -> `postMessage('authDone')`
+///   on `window.opener`
+///
+/// Sending either one to the system browser strands the answer there: the app
+/// never sees the loginToken and has no `window.opener` to receive `authDone`,
+/// so the dialog keeps sitting on "Continue with SSO".
+fn is_matrix_auth_url(url: &tauri::Url) -> bool {
+  if !matches!(url.scheme(), "http" | "https") {
+    return false;
+  }
+  let path = url.path();
+  path.contains("/_matrix/client/") && (path.contains("/login/sso") || path.contains("/auth/"))
+}
+
+/// The window number encoded in a sign-in label: `plotina-sso-7` -> `Some(7)`.
+/// Anything that is not a sign-in window label returns `None`.
+fn sso_window_index(label: &str) -> Option<usize> {
+  label
+    .strip_prefix(SSO_LABEL_PREFIX)?
+    .strip_prefix('-')?
+    .parse::<usize>()
+    .ok()
+}
+
+/// Whether a reused sign-in window must be taken to `requested`.
+///
+/// A single `window.open` in the renderer can produce two new-window
+/// requests, so the second request normally carries the very URL the first
+/// one already started to load: navigating again would only reload the
+/// ongoing round trip. `about:blank` likewise never replaces a page that is
+/// already loading. Only a genuinely different sign-in URL reuses the window
+/// for a new attempt.
+fn should_reuse_navigate(current: Option<&tauri::Url>, requested: &tauri::Url) -> bool {
+  requested.scheme() != "about" && current != Some(requested)
+}
+
+/// Whether `url` is our own sign-in callback: the app origin (served by
+/// tauri-plugin-localhost on http://localhost) carrying a non-empty
+/// `loginToken`, in the query or in the fragment.
+///
+/// Reaching it means the identity provider is done: the page's effect posts
+/// the token to the opener, after which the sign-in window has served its
+/// purpose (see the `on_page_load` handler in `open_sso_window`).
+fn is_login_callback_url(url: &tauri::Url) -> bool {
+  if !matches!(url.scheme(), "http" | "https")
+    || !matches!(url.host_str(), Some("localhost") | Some("127.0.0.1"))
+  {
+    return false;
+  }
+  let in_query = url
+    .query_pairs()
+    .any(|(k, v)| k.as_ref() == "loginToken" && !v.is_empty());
+  let in_fragment = url
+    .fragment()
+    .unwrap_or_default()
+    .split('&')
+    .any(|part| part.strip_prefix("loginToken=").is_some_and(|token| !token.is_empty()));
+  in_query || in_fragment
+}
+
+/// The one live sign-in window, if any.
+///
+/// WM-destroyed windows drop out of `webview_windows()` by themselves, so a
+/// window found here is still on screen and is the window to reuse: WebKit
+/// fires the new-window handler twice for a single popup and creating per
+/// request would open two identical sign-in windows.
+#[cfg(target_os = "linux")]
+fn find_sso_window(app: &tauri::AppHandle) -> Option<tauri::WebviewWindow> {
+  use tauri::Manager;
+  app
+    .webview_windows()
+    .into_iter()
+    .filter_map(|(label, window)| sso_window_index(&label).map(|index| (index, window)))
+    .min_by_key(|(index, _)| *index)
+    .map(|(_, window)| window)
+}
+
+/// Creates the sign-in round-trip window. Callers must check
+/// `find_sso_window` first: at most one sign-in window may exist.
+///
+/// `window_features` carries the caller webview and, on GTK, makes the new
+/// webview a *related view* of it: WebKit then keeps the real opener link, so
+/// `window.open` returns a live window object, `window.opener.postMessage`
+/// reaches the app, and the `loginToken` callback lands on our own origin.
+/// The child is deliberately left out of `capabilities/*.json` (only `main` is
+/// listed), so a remote sign-in page gets no IPC access.
+#[cfg(target_os = "linux")]
+fn open_sso_window(app: &tauri::AppHandle, url: &tauri::Url, features: tauri::webview::NewWindowFeatures) -> Option<tauri::WebviewWindow> {
+  let n = SSO_WINDOWS.fetch_add(1, Ordering::Relaxed) + 1;
+  let label = format!("{SSO_LABEL_PREFIX}-{n}");
+  let builder = WebviewWindowBuilder::new(app, label.clone(), WebviewUrl::External(url.clone()))
+    .title("Plotina Lite - sign in")
+    .inner_size(520.0, 720.0)
+    .min_inner_size(320.0, 480.0)
+    .resizable(true)
+    .on_page_load(|window, payload| {
+      // Self-close once the identity provider has returned the token to us:
+      // the callback page posts the loginToken to the opener on load, and
+      // JS `window.close()` cannot destroy a Tauri webview, so the shell
+      // closes this window itself shortly after the page's effect ran.
+      if matches!(payload.event(), tauri::webview::PageLoadEvent::Finished)
+        && is_login_callback_url(payload.url())
+      {
+        let closer = window.clone();
+        std::thread::spawn(move || {
+          std::thread::sleep(std::time::Duration::from_millis(1300));
+          // WebviewWindow::close is dispatched through the event-loop proxy,
+          // so calling it from this timer thread is safe; the user may also
+          // have closed the window first, which simply errors here.
+          if let Err(e) = closer.close() {
+            eprintln!("could not close the sign-in window after the token callback: {e}");
+          }
+        });
+      }
+    })
+    .window_features(features);
+  match builder.build() {
+    Ok(window) => Some(window),
+    Err(e) => {
+      eprintln!("could not open the sign-in window {label}: {e}; using the system browser");
+      None
+    }
+  }
+}
+
+#[cfg(test)]
+mod sso_tests {
+  use super::*;
+
+  fn url(s: &str) -> tauri::Url {
+    s.parse().unwrap()
+  }
+
+  #[test]
+  fn label_index_parses_only_sign_in_labels() {
+    assert_eq!(sso_window_index("plotina-sso-1"), Some(1));
+    assert_eq!(sso_window_index("plotina-sso-42"), Some(42));
+    assert_eq!(sso_window_index("plotina-sso"), None);
+    assert_eq!(sso_window_index("plotina-sso-x"), None);
+    assert_eq!(sso_window_index("plotina-sso-1x"), None);
+    assert_eq!(sso_window_index("main"), None);
+  }
+
+  #[test]
+  fn duplicate_request_does_not_reload_the_same_url() {
+    let auth = url("https://auth.plotina.cc/_matrix/client/v3/login/sso/redirect?redirectUrl=http%3A%2F%2Flocalhost%3A44548%2F");
+    assert!(!should_reuse_navigate(Some(&auth), &auth));
+  }
+
+  #[test]
+  fn about_blank_never_replaces_a_loading_page() {
+    let current = url("http://localhost:44548/");
+    assert!(!should_reuse_navigate(Some(&current), &url("about:blank")));
+    assert!(!should_reuse_navigate(None, &url("about:blank")));
+  }
+
+  #[test]
+  fn a_new_sign_in_attempt_navigates_the_existing_window() {
+    let old = url("https://idp.example.com/sso/one");
+    let fresh = url("https://auth.plotina.cc/_matrix/client/v3/login/sso/redirect");
+    assert!(should_reuse_navigate(Some(&old), &fresh));
+    // unknown current URL: still move to a real sign-in URL
+    assert!(should_reuse_navigate(None, &fresh));
+  }
+
+  #[test]
+  fn auth_url_matching_stays_scoped_to_matrix_paths() {
+    assert!(is_matrix_auth_url(&url("https://plotina.cc/_matrix/client/v3/login/sso/redirect")));
+    assert!(is_matrix_auth_url(&url("https://plotina.cc/_matrix/client/v3/auth/m.login.sso/fallback/web")));
+    assert!(!is_matrix_auth_url(&url("https://plotina.cc/_matrix/client/v3/rooms")));
+    assert!(!is_matrix_auth_url(&url("about:blank")));
+    assert!(!is_matrix_auth_url(&url("https://example.com/login/sso/")));
+  }
+
+  #[test]
+  fn login_callback_is_recognised_on_our_own_origin_only() {
+    assert!(is_login_callback_url(&url("http://localhost:44548/?loginToken=abc")));
+    assert!(is_login_callback_url(&url(
+      "http://localhost:44548/login/plotina.cc?action=login&loginToken=abc"
+    )));
+    assert!(is_login_callback_url(&url("http://127.0.0.1:44548/#loginToken=abc")));
+    // an identity provider page that happens to carry the parameter must not
+    // close the window: the round trip is not ours yet
+    assert!(!is_login_callback_url(&url("https://idp.example.com/?loginToken=abc")));
+    // the plain app page and an empty token must not close it either
+    assert!(!is_login_callback_url(&url("http://localhost:44548/")));
+    assert!(!is_login_callback_url(&url("http://localhost:44548/?loginToken=")));
+    assert!(!is_login_callback_url(&url("http://localhost:44548/#loginToken=")));
+    assert!(!is_login_callback_url(&url("about:blank")));
+  }
+}
+
