index 0000000..d6c1194
--- /dev/null
+++ b/src/app/state/plotinaAliases.ts
@@ -0,0 +1,205 @@
+/*
+Copyright 2026 Plotina <thebob3r@gmail.com>
+
+SPDX-License-Identifier: AGPL-3.0-only
+
+Plotina: personal names for direct chats -- the client side.
+
+The storage rules are in src/plotina/roomAliases.ts (pure, unit-tested). This
+file is the only place that talks to the Matrix client and to React:
+
+  * readPlotinaAliases()  -- current map, straight from account data;
+  * getPlotinaAlias()     -- one room's personal name, for code that is not a
+                             React component;
+  * isPlotinaDirectRoom() -- "is this a personal dialogue?", answered from room
+                             data (m.direct, the is_direct invite flag, two
+                             joined members), never from the id's shape;
+  * setPlotinaAlias()     -- the only writer: merges into the map and, for a
+                             blank name, drops the key;
+  * usePlotinaAlias()     -- the map as a React hook, re-read on the account
+                             data event;
+  * installPlotinaRoomNames() -- the single display point.
+
+Why the SDK hook and not a component: matrix-js-sdk computes a room's display
+name in Room.calculateRoomName() and lets the application override the answer
+through client.roomNameGenerator(roomId, state) -- Room.roomNameGenerator()
+calls it first and falls back to stock behaviour on null. Cinny never sets it
+(src/client/initMatrix.ts), so the whole client keeps reading the stock name.
+Installing one generator therefore covers every surface at once: the chat list
+(RoomNavItem), the open chat's header (RoomViewHeader), room settings and call
+tiles through useRoomName(), and the 27 direct room.name reads in
+notifications, search, the A-Z room order and the room card. Nothing is
+rewritten in the DOM and no React state has to be kept in sync -- Room.name and
+Room.normalizedName (what the room search matches on) simply come out with the
+personal name.
+
+Account data is not part of the room state, so the SDK does not recalculate a
+room when it changes: installPlotinaRoomNames() listens for the account data
+event and calls Room.recalculate(), which is what emits Room.name -- the signal
+every consumer already listens to -- so the list repaints without a reload.
+The same recompute runs once the room exists (ClientEvent.Room) and once the
+first sync is applied (SyncState.Prepared), because on a cold start the account
+data arrives before the rooms and a new room is named before it is in the
+client -- see the comment at the end of installPlotinaRoomNames().
+*/
+import { ClientEvent, MatrixClient, MatrixEvent, Room, SyncState } from 'matrix-js-sdk';
+import { useAccountData } from '../hooks/useAccountData';
+import { AccountDataEvent } from '../../types/matrix/accountData';
+import {
+  ALIASES_EVENT_TYPE,
+  RoomAliases,
+  aliasFor,
+  aliasesWith,
+  parseAliases,
+  resolveRoomName,
+} from '../../plotina/roomAliases';
+import { getAccountData, getMDirects, isDirectInvite } from '../utils/room';
+
+const EMPTY_ALIASES: RoomAliases = {};
+const EMPTY_ROOM_IDS = new Set<string>();
+
+// Parsing costs a pass over the map and this is read from calculateRoomName()
+// for every room on every sync, from the A-Z room comparator and from
+// notification handlers. Account data events are immutable, so keying the
+// cache on the event object gives one parse per change.
+const parsedByEvent = new WeakMap<MatrixEvent, RoomAliases>();
+const directsByEvent = new WeakMap<MatrixEvent, Set<string>>();
+
+export const readPlotinaAliases = (mx: MatrixClient): RoomAliases => {
+  const event = getAccountData(mx, ALIASES_EVENT_TYPE as unknown as AccountDataEvent);
+  if (!event) return EMPTY_ALIASES;
+
+  const cached = parsedByEvent.get(event);
+  if (cached) return cached;
+
+  const parsed = parseAliases(event.getContent());
+  parsedByEvent.set(event, parsed);
+  return parsed;
+};
+
+const readPlotinaDirectRooms = (mx: MatrixClient): Set<string> => {
+  const event = getAccountData(mx, AccountDataEvent.Direct);
+  if (!event) return EMPTY_ROOM_IDS;
+
+  const cached = directsByEvent.get(event);
+  if (cached) return cached;
+
+  const parsed = getMDirects(event);
+  directsByEvent.set(event, parsed);
+  return parsed;
+};
+
+export const getPlotinaAlias = (mx: MatrixClient, roomId: string): string | undefined =>
+  aliasFor(readPlotinaAliases(mx), roomId);
+
+/**
+ * Is this a personal dialogue for the signed-in account? The answer comes from
+ * room data, not from the id: room version 12 ids are opaque "!<base64url>"
+ * with no server part, so any shape rule would silently skip production DMs
+ * (the defect QA found in Element Web).
+ *
+ * Same three tests as the Element Web overlay, so both clients agree on what
+ * may carry a personal name: a room m.direct lists, a room joined through an
+ * is_direct invite, or a room with exactly two joined members (how a
+ * one-to-one chat looks when another client never wrote m.direct). Spaces are
+ * never direct, and a group room is never masked.
+ */
+export const isPlotinaDirectRoom = (mx: MatrixClient, room: Room): boolean => {
+  if (readPlotinaDirectRooms(mx).has(room.roomId)) return true;
+  if (isDirectInvite(room, mx.getUserId())) return true;
+  if (room.isSpaceRoom()) return false;
+  return room.getJoinedMemberCount() === 2;
+};
+
+/** The name this account renders for the room: personal name or real name. */
+export const plotinaRoomName = (mx: MatrixClient, room: Room): string =>
+  resolveRoomName(room.name, getPlotinaAlias(mx, room.roomId), isPlotinaDirectRoom(mx, room));
+
+/**
+ * Set ("Денчик") or reset (blank) one personal name. Only account data is
+ * written -- m.room.name and the room state stay untouched, which is the whole
+ * point: the other participants never learn about this name.
+ */
+export const setPlotinaAlias = async (
+  mx: MatrixClient,
+  roomId: string,
+  name: string
+): Promise<void> => {
+  const next = aliasesWith(readPlotinaAliases(mx), roomId, name);
+  // Upstream types know the spec's own account data only; a custom type needs
+  // the same cast Cinny itself uses for in.cinny.spaces (SpaceTabs.tsx).
+  await mx.setAccountData(ALIASES_EVENT_TYPE as any, next as any);
+};
+
+/** Current personal name of one room, as a hook (re-renders on the event). */
+export const usePlotinaAlias = (roomId: string): string | undefined => {
+  const event = useAccountData(ALIASES_EVENT_TYPE);
+  return aliasFor(parseAliases(event?.getContent()), roomId);
+};
+
+type PlotinaRoomNamesClient = MatrixClient & { plotinaRoomNames?: boolean };
+
+/** Recompute one room's cached name; Room.name listeners repaint the list. */
+const recalculateOneRoom = (room: Room) => {
+  try {
+    room.recalculate(); // emits Room.name when the displayed name changes
+  } catch {
+    /* one broken room must not stop the others */
+  }
+};
+
+/**
+ * Recompute every room the client knows. Cheap: Room.recalculate() only emits
+ * Room.name for a room whose displayed name actually changed.
+ */
+export const recalculatePlotinaRoomNames = (mx: MatrixClient) => {
+  mx.getRooms().forEach(recalculateOneRoom);
+};
+
+export const installPlotinaRoomNames = (mx: PlotinaRoomNamesClient) => {
+  if (mx.plotinaRoomNames) return;
+  // The whole point is to hand the SDK a generator on the client it computed
+  // names with; there is no other place the SDK reads it from.
+  // eslint-disable-next-line no-param-reassign
+  mx.plotinaRoomNames = true;
+
+  // Return null for everything we do not answer, so the SDK keeps its own
+  // behaviour (member lists, "Empty room", the generated name of a group).
+  // eslint-disable-next-line no-param-reassign
+  mx.roomNameGenerator = (roomId: string): string | null => {
+    const alias = getPlotinaAlias(mx, roomId);
+    if (!alias) return null;
+    const room = mx.getRoom(roomId);
+    if (!room || !isPlotinaDirectRoom(mx, room)) return null;
+    return alias;
+  };
+
+  // Account data is not room state: nothing recalculates by itself, and the
+  // room list, the header and the notification titles would keep the old name
+  // until the next reload.
+  const handleAccountData = (event: MatrixEvent) => {
+    if (event.getType() === ALIASES_EVENT_TYPE) recalculatePlotinaRoomNames(mx);
+  };
+  mx.on(ClientEvent.AccountData, handleAccountData);
+
+  // Cold start. Two SDK facts leave a room with the stock name and nothing
+  // recomputes it later, because account data is not room state:
+  //
+  //   * the first /sync carries global account data BEFORE the room sections
+  //     (matrix-js-sdk sync.js), so the handler above runs against an empty
+  //     room list -- the alias is stored by then, but no room sees it;
+  //   * for a brand-new room the SDK calls Room.recalculate() BEFORE
+  //     storeRoom() and ClientEvent.Room, so inside the generator
+  //     mx.getRoom(roomId) is still undefined for that room and the name it is
+  //     born with is the member-list one. The list then shows that name until
+  //     the room is opened or an event arrives in it.
+  //
+  // A room is in the client's map by ClientEvent.Room, and after
+  // SyncState.Prepared the whole first sync is applied, so every room that was
+  // born before its alias and every alias that arrived before its room is
+  // recomputed here -- on the first paint, not on the next room event.
+  mx.on(ClientEvent.Room, recalculateOneRoom);
+  mx.on(ClientEvent.Sync, (state: SyncState) => {
+    if (state === SyncState.Prepared) recalculatePlotinaRoomNames(mx);
+  });
+};
