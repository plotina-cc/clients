diff --git a/src/plotina/roomAliases.ts b/src/plotina/roomAliases.ts
new file mode 100644
index 0000000..36d0cdf
--- /dev/null
+++ b/src/plotina/roomAliases.ts
@@ -0,0 +1,108 @@
+/*
+Copyright 2026 Plotina <thebob3r@gmail.com>
+
+SPDX-License-Identifier: AGPL-3.0-only
+
+Plotina: personal names for direct chats -- the data contract.
+
+A person may want to call a dialogue "Денчик" while the other side keeps
+seeing their own name. Renaming the room would write m.room.name into the room
+state and rename it for everyone, so the name lives in this account's own
+account data instead:
+
+    cc.plotina.room_aliases = { "<room_id>": "<personal name>" }
+
+Only the owner of the account can read it (account data is per-user), it
+follows the account to every device, and nothing is sent to the other
+participants. An empty value means "reset": the key is dropped from the map on
+write. Element Web/Desktop reads and writes the same event
+(element-web/plotina-dm-aliases.js), so a name set in one client shows up in
+the other.
+
+This file is deliberately dependency-free: every function is pure, so the
+storage rules can be pinned with plain node and no browser or Matrix client
+(cinny/tests/dm_aliases.test.mjs, run by cinny/scripts/test-dm-aliases.sh).
+The React/Matrix glue is in src/app/state/plotinaAliases.ts.
+*/
+
+export const ALIASES_EVENT_TYPE = 'cc.plotina.room_aliases';
+
+export type RoomAliases = Record<string, string>;
+
+const EMPTY_ALIASES: RoomAliases = {};
+
+/**
+ * Account data content -> alias map. Anything that is not a flat object of
+ * string values is read as "no aliases": a broken or half-written event must
+ * leave the client working exactly as it did before the feature existed.
+ *
+ * Room ids are not validated here on purpose. "!localpart:server" (room
+ * versions up to 11) and the opaque "!<base64url>" of room version 12 have
+ * nothing in common but the leading "!", and a format rule stricter than that
+ * silently drops every v12 room -- the defect QA found in Element Web. The id
+ * is only ever used as a map key, so it needs no shape check at all.
+ */
+export const parseAliases = (raw: unknown): RoomAliases => {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return EMPTY_ALIASES;
+
+  // Object.keys, not Object.entries: cinny's tsconfig pins lib ES2016.
+  const source = raw as Record<string, unknown>;
+  const out: RoomAliases = {};
+  Object.keys(source).forEach((roomId) => {
+    if (!roomId) return;
+    const value = source[roomId];
+    if (typeof value !== 'string') return;
+    const name = value.trim();
+    if (name) out[roomId] = name;
+  });
+  return out;
+};
+
+/** The alias for one room, or undefined when the room has no personal name. */
+export const aliasFor = (aliases: RoomAliases, roomId: string): string | undefined => {
+  const name = aliases[roomId];
+  if (typeof name !== 'string') return undefined;
+  const trimmed = name.trim();
+  return trimmed || undefined;
+};
+
+/**
+ * The map after setting (or, for a blank name, clearing) one alias. Returns a
+ * new object and never stores an empty value, so a reset leaves no key behind
+ * -- the account data event stays as {} because Matrix has no way to delete
+ * account data (matrix-js-sdk implements deleteAccountData as a write of {}).
+ */
+export const aliasesWith = (
+  aliases: RoomAliases,
+  roomId: string,
+  name: string | null | undefined
+): RoomAliases => {
+  const next: RoomAliases = { ...aliases };
+  if (!roomId) return next;
+
+  const wanted = typeof name === 'string' ? name.trim() : '';
+  if (wanted) {
+    next[roomId] = wanted;
+  } else {
+    delete next[roomId];
+  }
+  return next;
+};
+
+/**
+ * The name to render. The personal name wins only for a direct chat: a room
+ * that a group shares keeps its own name even if a stale alias is around, so
+ * the mask can never hide a group room from its members.
+ */
+export const resolveRoomName = (
+  name: string | undefined,
+  alias: string | undefined,
+  isDirect: boolean
+): string => {
+  const personal = isDirect ? alias : undefined;
+  if (personal) return personal;
+  return name ?? '';
+};
+
+/** True when the map holds no aliases (used to skip work on the common case). */
+export const hasAliases = (aliases: RoomAliases): boolean => Object.keys(aliases).length > 0;
