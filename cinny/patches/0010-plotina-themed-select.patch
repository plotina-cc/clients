diff --git a/src/app/features/settings/PlotinaSelect.tsx b/src/app/features/settings/PlotinaSelect.tsx
new file mode 100644
index 0000000..2a97803
--- /dev/null
+++ b/src/app/features/settings/PlotinaSelect.tsx
@@ -0,0 +1,112 @@
+// Plotina: a select that looks like Cinny's own theme/layout menus.
+//
+// Native <select> controls are drawn by Chromium/GTK and cannot pick up the
+// Cinny palette; on a dark theme they show a white box with a blue system
+// highlight. This uses the same Button + Menu + MenuItem + PopOut recipe as
+// SelectTheme in General.tsx, so the closed control and the opened menu use
+// the theme's surfaces, radii and Primary highlight.
+import React, { MouseEventHandler, useState } from 'react';
+import FocusTrap from 'focus-trap-react';
+import {
+  Box,
+  Button,
+  config,
+  Icon,
+  Icons,
+  Menu,
+  MenuItem,
+  PopOut,
+  RectCords,
+  Text,
+} from 'folds';
+import { stopPropagation } from '../../utils/keyboard';
+
+export type PlotinaSelectOption = {
+  value: string;
+  label: string;
+};
+
+type PlotinaSelectProps = {
+  value: string;
+  options: PlotinaSelectOption[];
+  onChange: (value: string) => void;
+  ariaLabel?: string;
+  disabled?: boolean;
+  minWidth?: number;
+};
+
+export function PlotinaSelect({
+  value,
+  options,
+  onChange,
+  ariaLabel,
+  disabled = false,
+  minWidth = 160,
+}: PlotinaSelectProps) {
+  const [menuCords, setMenuCords] = useState<RectCords>();
+  const selected = options.find((option) => option.value === value) ?? options[0];
+
+  const handleOpen: MouseEventHandler<HTMLButtonElement> = (evt) => {
+    if (disabled) return;
+    setMenuCords(evt.currentTarget.getBoundingClientRect());
+  };
+
+  return (
+    <>
+      <Button
+        size="300"
+        variant="Primary"
+        outlined
+        fill="Soft"
+        radii="300"
+        after={<Icon size="300" src={Icons.ChevronBottom} />}
+        onClick={handleOpen}
+        aria-label={ariaLabel}
+        aria-disabled={disabled}
+        disabled={disabled}
+        style={{ minWidth, justifyContent: 'space-between' }}
+      >
+        <Text size="T300">{selected?.label ?? value}</Text>
+      </Button>
+      <PopOut
+        anchor={menuCords}
+        offset={5}
+        position="Bottom"
+        align="End"
+        content={
+          <FocusTrap
+            focusTrapOptions={{
+              initialFocus: false,
+              onDeactivate: () => setMenuCords(undefined),
+              clickOutsideDeactivates: true,
+              isKeyForward: (evt: KeyboardEvent) =>
+                evt.key === 'ArrowDown' || evt.key === 'ArrowRight',
+              isKeyBackward: (evt: KeyboardEvent) =>
+                evt.key === 'ArrowUp' || evt.key === 'ArrowLeft',
+              escapeDeactivates: stopPropagation,
+            }}
+          >
+            <Menu>
+              <Box direction="Column" gap="100" style={{ padding: config.space.S100 }}>
+                {options.map((option) => (
+                  <MenuItem
+                    key={option.value}
+                    size="300"
+                    variant={option.value === value ? 'Primary' : 'Surface'}
+                    radii="300"
+                    onClick={() => {
+                      onChange(option.value);
+                      setMenuCords(undefined);
+                    }}
+                  >
+                    <Text size="T300">{option.label}</Text>
+                  </MenuItem>
+                ))}
+              </Box>
+            </Menu>
+          </FocusTrap>
+        }
+      />
+    </>
+  );
+}
