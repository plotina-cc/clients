@@ -0,0 +1,117 @@
+/*
+Copyright 2026 Plotina <thebob3r@gmail.com>
+
+SPDX-License-Identifier: AGPL-3.0-only
+
+Plotina: personal names for the PEOPLE in a room, not just for a dialogue.
+
+A contact name is stored per mxid (src/plotina/contactNames.ts), so the same
+person has to read the same in every direct chat AND in every group they share
+with this account: "в группе иначе, чем в ЛС" would mean the name is a property
+of the room again. This module is the one place that answers "what do I call
+this user in this room?":
+
+    personal name from cc.plotina.contact_names
+      -> member's own displayname (m.room.member)
+      -> nothing (the caller falls back to the mxid localpart)
+
+That is the same order the owner's model and the Mobile reference use
+(User.displayName = resolveLocalName(id) ?? "name from member state"); the
+rawDisplayName stays untouched, which is what every upstream surface already
+reads today.
+
+Why a module and not a hook: the display point (getMemberDisplayName in
+src/app/utils/room.ts) is called from render code, from sort comparators and
+from the editor's mention insertion, none of which are React components. It
+only needs the account data map, which the SDK has already stored, so the
+answer is synchronous and needs no state of its own. React gets told about a
+change separately (see the hook below and the repaint in features/room/Room).
+
+Nothing here writes anything: no m.room.member, no m.room.name. A name given to
+a person is this account's own view of that person.
+*/
+import { MatrixClient } from 'matrix-js-sdk';
+import {
+  CONTACT_NAMES_EVENT_TYPE,
+  ContactNames,
+  contactNameFor,
+  parseContactNames,
+} from './contactNames';
+
+const EMPTY_NAMES: ContactNames = {};
+
+/** Account data events are immutable, so one parse per event is enough. */
+const parsedByEvent = new WeakMap<object, ContactNames>();
+
+/**
+ * The name map of the signed-in account, straight from account data.
+ *
+ * Missing event (never set on this account), half-written or hostile content
+ * all read as "no names": the client must work exactly as it did before the
+ * feature existed.
+ */
+export const readContactNames = (mx: MatrixClient): ContactNames => {
+  if (!mx || typeof mx.getAccountData !== 'function') return EMPTY_NAMES;
+  const event = mx.getAccountData(CONTACT_NAMES_EVENT_TYPE as any);
+  if (!event || typeof event.getContent !== 'function') return EMPTY_NAMES;
+
+  const cached = parsedByEvent.get(event);
+  if (cached) return cached;
+
+  let parsed = EMPTY_NAMES;
+  try {
+    parsed = parseContactNames(event.getContent());
+  } catch {
+    /* a resolver that throws must leave upstream behaviour alone */
+  }
+  parsedByEvent.set(event, parsed);
+  return parsed;
+};
+
+/** The personal name this account gave [userId], or undefined. */
+export const personalNameOf = (
+  mx: MatrixClient,
+  userId: string | undefined
+): string | undefined => contactNameFor(readContactNames(mx), userId);
+
+/** What this module needs from a Room; typed structurally so it stays pure. */
+type RoomLike = {
+  client?: MatrixClient | null;
+  getMember?: (userId: string) => { rawDisplayName?: string } | null | undefined;
+};
+
+/**
+ * The personal name of a room's member, or undefined when this account never
+ * named them.
+ *
+ * Independent of the room's kind: a group is not renamed, but the PEOPLE in it
+ * are called what this account calls them everywhere else. Only the account's
+ * own map is consulted -- the room supplies nothing but the client that holds
+ * the account data.
+ */
+export const personalNameForMember = (
+  room: RoomLike | null | undefined,
+  userId: string | undefined
+): string | undefined => {
+  if (!room || typeof userId !== 'string') return undefined;
+  return personalNameOf(room.client as MatrixClient, userId);
+};
+
+/**
+ * The member's own displayname, as upstream computes it, or undefined when the
+ * room does not know the member.
+ *
+ * Two upstream fallbacks are preserved: no member -> undefined, and
+ * rawDisplayName equal to the mxid (the SDK's "this person has no name" marker)
+ * -> undefined, so callers keep falling back to the localpart exactly as
+ * before.
+ */
+export const memberOwnName = (
+  room: RoomLike | null | undefined,
+  userId: string | undefined
+): string | undefined => {
+  if (!room || typeof userId !== 'string' || typeof room.getMember !== 'function') return undefined;
+  const name = room.getMember(userId)?.rawDisplayName;
+  if (name === userId) return undefined;
+  return name;
+};
