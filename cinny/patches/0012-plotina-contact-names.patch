@@ -0,0 +1,183 @@
+/*
+Copyright 2026 Plotina <thebob3r@gmail.com>
+
+SPDX-License-Identifier: AGPL-3.0-only
+
+Plotina: the "personal name" dialog for a contact.
+
+One field and two actions, in the shape of the other prompts in this folder
+(LeaveRoomPrompt, InviteUserPrompt). The value is written to this account's own
+account data under the CONTACT's mxid, never to the room: see
+src/plotina/contactNames.ts for the contract and
+src/app/state/plotinaContactNames.ts for the writer. Saving an empty field is
+the reset, so a dialog whose name was set elsewhere still offers "Reset"
+without the user having to clear the field first.
+
+The room is only the entry point: it says WHO the contact is. Naming someone
+here renames them in every direct chat with them, which is what the hint says.
+*/
+import React, { FormEventHandler, useState } from 'react';
+import { Room } from 'matrix-js-sdk';
+import FocusTrap from 'focus-trap-react';
+import {
+  Button,
+  Box,
+  Dialog,
+  Header,
+  Icon,
+  IconButton,
+  Icons,
+  Input,
+  Overlay,
+  OverlayBackdrop,
+  OverlayCenter,
+  Spinner,
+  Text,
+  color,
+  config,
+} from 'folds';
+import { useMatrixClient } from '../../hooks/useMatrixClient';
+import { setPlotinaContactName, usePlotinaContactName } from '../../state/plotinaContactNames';
+import { stopPropagation } from '../../utils/keyboard';
+
+const STRINGS = {
+  ru: {
+    menu: 'Личное имя',
+    title: 'Личное имя',
+    hint: 'Видно только вам. Имя собеседника у него самого не меняется, а в других диалогах с ним станет таким же.',
+    save: 'Сохранить',
+    reset: 'Сбросить',
+    failed: 'Не удалось сохранить имя',
+  },
+  en: {
+    menu: 'Personal name',
+    title: 'Personal name',
+    hint: 'Only you see this. The contact\u2019s own name is unchanged, and your other chats with them will show this name too.',
+    save: 'Save',
+    reset: 'Reset',
+    failed: 'Could not save the name',
+  },
+};
+
+// Same fallback as the rest of the Plotina overlays: no language is Russian,
+// a "ru" prefix is Russian, anything else English.
+export const plotinaContactNameStrings = () => {
+  const value = (document.documentElement.lang || navigator.language || '').toLowerCase();
+  if (!value) return STRINGS.ru;
+  return value.indexOf('ru') === 0 ? STRINGS.ru : STRINGS.en;
+};
+
+type PlotinaContactNamePromptProps = {
+  room: Room;
+  onDone: () => void;
+  onCancel: () => void;
+};
+
+export function PlotinaContactNamePrompt({
+  room,
+  onDone,
+  onCancel,
+}: PlotinaContactNamePromptProps) {
+  const mx = useMatrixClient();
+  const [strings] = useState(plotinaContactNameStrings);
+  const current = usePlotinaContactName(room);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string>();
+
+  const save = (name: string) => {
+    if (busy) return;
+    setBusy(true);
+    setError(undefined);
+    setPlotinaContactName(mx, room, name).then(onDone, (err: unknown) => {
+      setBusy(false);
+      setError(err instanceof Error ? err.message : String(err));
+    });
+  };
+
+  const handleSubmit: FormEventHandler<HTMLFormElement> = (evt) => {
+    evt.preventDefault();
+    const form = evt.target as HTMLFormElement | undefined;
+    const input = form?.nameInput as HTMLInputElement | undefined;
+    save(input?.value ?? '');
+  };
+
+  return (
+    <Overlay open backdrop={<OverlayBackdrop />}>
+      <OverlayCenter>
+        <FocusTrap
+          focusTrapOptions={{
+            initialFocus: false,
+            onDeactivate: onCancel,
+            clickOutsideDeactivates: true,
+            escapeDeactivates: stopPropagation,
+          }}
+        >
+          <Dialog variant="Surface">
+            <Header
+              style={{
+                padding: `0 ${config.space.S200} 0 ${config.space.S400}`,
+                borderBottomWidth: config.borderWidth.B300,
+              }}
+              variant="Surface"
+              size="500"
+            >
+              <Box grow="Yes">
+                <Text size="H4">{strings.title}</Text>
+              </Box>
+              <IconButton size="300" onClick={onCancel} radii="300">
+                <Icon src={Icons.Cross} />
+              </IconButton>
+            </Header>
+            <Box
+              as="form"
+              onSubmit={handleSubmit}
+              style={{ padding: config.space.S400 }}
+              direction="Column"
+              gap="400"
+            >
+              <Box direction="Column" gap="200">
+                <Text priority="400" size="T300">
+                  {strings.hint}
+                </Text>
+                <Input
+                  size="500"
+                  autoFocus
+                  name="nameInput"
+                  variant="Background"
+                  defaultValue={current}
+                  aria-label={strings.title}
+                />
+                {error && (
+                  <Text size="T200" style={{ color: color.Critical.Main }}>
+                    {strings.failed}: {error}
+                  </Text>
+                )}
+              </Box>
+              <Box gap="200" justifyContent="End">
+                {current && (
+                  <Button
+                    type="button"
+                    variant="Critical"
+                    fill="None"
+                    onClick={() => save('')}
+                    aria-disabled={busy}
+                  >
+                    <Text size="B400">{strings.reset}</Text>
+                  </Button>
+                )}
+                <Button
+                  type="submit"
+                  variant="Primary"
+                  before={busy ? <Spinner fill="Solid" variant="Primary" size="200" /> : undefined}
+                  aria-disabled={busy}
+                >
+                  <Text size="B400">{strings.save}</Text>
+                </Button>
+              </Box>
+            </Box>
+          </Dialog>
+        </FocusTrap>
+      </OverlayCenter>
+    </Overlay>
+  );
+}
