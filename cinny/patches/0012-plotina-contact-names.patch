diff --git a/src/app/state/plotinaContactNames.ts b/src/app/state/plotinaContactNames.ts
new file mode 100644
index 0000000..5149a83
--- /dev/null
+++ b/src/app/state/plotinaContactNames.ts
@@ -0,0 +1,347 @@
+/*
+Copyright 2026 Plotina <thebob3r@gmail.com>
+
+SPDX-License-Identifier: AGPL-3.0-only
+
+Plotina: personal names for CONTACTS -- the client side.
+
+The storage rules are in src/plotina/contactNames.ts (pure, unit-tested). This
+file is the only place that talks to the Matrix client and to React:
+
+  * readPlotinaContactNames()  -- current map, straight from account data;
+  * getPlotinaContactName()    -- one contact's personal name, for code that is
+                                  not a React component;
+  * isPlotinaDirectRoom()      -- "is this a personal dialogue?", answered from
+                                  room data (m.direct, the is_direct invite
+                                  flag, two joined members), never from the id's
+                                  shape;
+  * contactPartnerOf()         -- WHO this room is a dialogue with, which is
+                                  what the name is keyed by;
+  * setPlotinaContactName()    -- the only writer: merges into the map under the
+                                  partner's mxid and, for a blank name, drops
+                                  the key;
+  * usePlotinaContactName()    -- the map as a React hook, re-read on the
+                                  account data event;
+  * installPlotinaContactNames() -- the single display point.
+
+Why the SDK hook and not a component: matrix-js-sdk computes a room's display
+name in Room.calculateRoomName() and lets the application override the answer
+through client.roomNameGenerator(roomId, state) -- Room.roomNameGenerator()
+calls it first and falls back to stock behaviour on null. Cinny never sets it
+(src/client/initMatrix.ts), so the whole client keeps reading the stock name.
+Installing one generator therefore covers every surface at once: the chat list
+(RoomNavItem), the open chat's header (RoomViewHeader), room settings and call
+tiles through useRoomName(), and the 27 direct room.name reads in
+notifications, search, the A-Z room order and the room card. Nothing is
+rewritten in the DOM and no React state has to be kept in sync -- Room.name and
+Room.normalizedName (what the room search matches on) simply come out with the
+personal name.
+
+The generator resolves the room's PARTNER on every call rather than looking the
+room id up in the map, which is what makes the name follow the person: naming
+someone in one direct chat renames them in every other direct chat with them,
+and a room that is not a one-to-one chat never gets a name at all.
+
+Account data is not part of the room state, so the SDK does not recalculate a
+room when it changes: installPlotinaContactNames() listens for the account data
+event and calls Room.recalculate(), which is what emits Room.name -- the signal
+every consumer already listens to -- so the list repaints without a reload.
+The same recompute runs once the room exists (ClientEvent.Room) and once the
+first sync is applied (SyncState.Prepared), because on a cold start the account
+data arrives before the rooms and a new room is named before it is in the
+client -- see the comment at the end of installPlotinaContactNames().
+*/
+import { ClientEvent, MatrixClient, MatrixEvent, Room, SyncState } from 'matrix-js-sdk';
+import { useEffect, useState } from 'react';
+import { useAccountData } from '../hooks/useAccountData';
+import { AccountDataEvent } from '../../types/matrix/accountData';
+import {
+  CONTACT_NAMES_EVENT_TYPE,
+  ContactNames,
+  DirectPartners,
+  contactNameFor,
+  contactNameForRoom,
+  contactNamesWith,
+  directPartners,
+  dmPartnerId,
+  parseContactNames,
+  resolveRoomName,
+} from '../../plotina/contactNames';
+import { getAccountData, getMDirects, isDirectInvite } from '../utils/room';
+
+const EMPTY_NAMES: ContactNames = {};
+const EMPTY_PARTNERS: DirectPartners = {};
+
+// Parsing costs a pass over the map and this is read from calculateRoomName()
+// for every room on every sync, from the A-Z room comparator and from
+// notification handlers. Account data events are immutable, so keying the
+// cache on the event object gives one parse per change.
+const parsedByEvent = new WeakMap<MatrixEvent, ContactNames>();
+const partnersByEvent = new WeakMap<MatrixEvent, DirectPartners>();
+
+export const readPlotinaContactNames = (mx: MatrixClient): ContactNames => {
+  const event = getAccountData(mx, CONTACT_NAMES_EVENT_TYPE as unknown as AccountDataEvent);
+  if (!event) return EMPTY_NAMES;
+
+  const cached = parsedByEvent.get(event);
+  if (cached) return cached;
+
+  const parsed = parseContactNames(event.getContent());
+  parsedByEvent.set(event, parsed);
+  return parsed;
+};
+
+/** room id -> mxid, from this account's m.direct. */
+const readPlotinaDirectPartners = (mx: MatrixClient): DirectPartners => {
+  const event = getAccountData(mx, AccountDataEvent.Direct);
+  if (!event) return EMPTY_PARTNERS;
+
+  const cached = partnersByEvent.get(event);
+  if (cached) return cached;
+
+  const parsed = directPartners(event.getContent());
+  partnersByEvent.set(event, parsed);
+  return parsed;
+};
+
+/** The personal name this account gave [userId], or undefined. */
+export const getPlotinaContactName = (
+  mx: MatrixClient,
+  userId: string | undefined
+): string | undefined => contactNameFor(readPlotinaContactNames(mx), userId);
+
+/**
+ * Is this a personal dialogue for the signed-in account? The answer comes from
+ * room data, not from the id: room version 12 ids are opaque "!<base64url>"
+ * with no server part, so any shape rule would silently skip production DMs.
+ *
+ * Same three tests as the Element Web overlay, so both clients agree on what
+ * may carry a personal name: a room m.direct lists, a room joined through an
+ * is_direct invite, or a room with exactly two joined members (how a
+ * one-to-one chat looks when another client never wrote m.direct). Spaces are
+ * never direct, and a group room is never masked.
+ */
+export const isPlotinaDirectRoom = (mx: MatrixClient, room: Room): boolean => {
+  if (readPlotinaDirectPartners(mx)[room.roomId]) return true;
+  if (isDirectInvite(room, mx.getUserId())) return true;
+  if (room.isSpaceRoom()) return false;
+  return room.getJoinedMemberCount() === 2;
+};
+
+/** The mxids of the joined members of a room, or undefined when unknown. */
+const joinedMemberIds = (room: Room): string[] | undefined => {
+  const members = room.getJoinedMembers?.();
+  if (!Array.isArray(members)) return undefined;
+  return members.map((member) => member.userId);
+};
+
+/**
+ * The inviter, but only for a room the SDK says is a direct invite. A pending
+ * invite has no joined members yet, so m.direct and the member list both have
+ * nothing to say -- the inviter is the only person it can be a dialogue with.
+ */
+const directInviter = (mx: MatrixClient, room: Room): string | undefined => {
+  if (!isDirectInvite(room, mx.getUserId())) return undefined;
+  return room.getDMInviter?.() ?? undefined;
+};
+
+/**
+ * The personal name of the contact this room is a dialogue with, or undefined.
+ * One helper for every caller (generator, hook, writer, the exported name
+ * function), so all four surfaces agree on who the contact is: the space flag,
+ * the member list, m.direct and the invite inviter are consulted in ONE place.
+ */
+const contactNameOfRoom = (
+  mx: MatrixClient,
+  room: Room,
+  names: ContactNames = readPlotinaContactNames(mx)
+): string | undefined =>
+  contactNameForRoom(
+    names,
+    room.roomId,
+    mx.getUserId() ?? undefined,
+    readPlotinaDirectPartners(mx),
+    joinedMemberIds(room),
+    directInviter(mx, room),
+    room.isSpaceRoom?.()
+  );
+
+/**
+ * WHO is this room a dialogue with, or undefined when it is not one-to-one.
+ * This is the key the personal name is stored under, so every direct chat with
+ * the same person resolves to the same name.
+ */
+export const contactPartnerOf = (mx: MatrixClient, room: Room): string | undefined =>
+  dmPartnerId(
+    room.roomId,
+    mx.getUserId() ?? undefined,
+    readPlotinaDirectPartners(mx),
+    joinedMemberIds(room),
+    directInviter(mx, room),
+    room.isSpaceRoom?.()
+  );
+
+/** The name this account renders for the room: personal name or real name. */
+export const plotinaRoomName = (mx: MatrixClient, room: Room): string =>
+  resolveRoomName(room.name, contactNameOfRoom(mx, room));
+
+/**
+ * Set ("Денчик") or reset (blank) the personal name of the CONTACT this room
+ * is a dialogue with. Only account data is written -- m.room.name and the room
+ * state stay untouched, which is the whole point: the other participants never
+ * learn about this name, and a group room cannot be renamed at all.
+ *
+ * The room only identifies the person; a room that is not a one-to-one chat
+ * has nobody to name and is ignored rather than writing a key nobody can be
+ * shown under.
+ */
+export const setPlotinaContactName = async (
+  mx: MatrixClient,
+  room: Room,
+  name: string | null | undefined
+): Promise<void> => {
+  const partner = contactPartnerOf(mx, room);
+  if (!partner) return;
+
+  const next = contactNamesWith(readPlotinaContactNames(mx), partner, name);
+  // Upstream types know the spec's own account data only; a custom type needs
+  // the same cast Cinny itself uses for in.cinny.spaces (SpaceTabs.tsx).
+  await mx.setAccountData(CONTACT_NAMES_EVENT_TYPE as any, next as any);
+};
+
+/**
+ * Current personal name of a room's contact, as a hook (re-renders on the
+ * event). Takes the room, not the id: the name belongs to the person the room
+ * is a dialogue with.
+ */
+export const usePlotinaContactName = (room: Room): string | undefined => {
+  const event = useAccountData(CONTACT_NAMES_EVENT_TYPE);
+  const mx = room.client;
+  return contactNameOfRoom(mx, room, parseContactNames(event?.getContent()));
+};
+
+/**
+ * Tell [listener] whenever the personal-name map changes.
+ *
+ * This exists for surfaces that are already on screen and do not recompute
+ * through Room.name: an open room's message list, its member drawer, the
+ * reaction/reply attributions. Account data is not room state, so the SDK
+ * emits nothing those components subscribe to -- without this, renaming a
+ * contact leaves the open chat showing the old name until the room is
+ * reopened or a new event arrives in it.
+ *
+ * The listener fires on changes only, never at subscribe time: every name is
+ * resolved synchronously when it is rendered, so a first render already shows
+ * the current map and an extra callback would only cause a second one.
+ */
+export const subscribeContactNames = (
+  mx: MatrixClient,
+  listener: () => void
+): (() => void) => {
+  const handler = (event: MatrixEvent) => {
+    try {
+      if (event.getType() === CONTACT_NAMES_EVENT_TYPE) listener();
+    } catch {
+      /* a listener that throws must not break the client's event loop */
+    }
+  };
+  mx.on(ClientEvent.AccountData, handler);
+  return () => mx.removeListener(ClientEvent.AccountData, handler);
+};
+
+/**
+ * Force a re-render of the calling component whenever the name map changes.
+ *
+ * Every member name in the client is read synchronously by
+ * getMemberDisplayName(), so no component holds the name in its own state: a
+ * rename from this device or another one changes what the function returns but
+ * nothing React would notice. An open room's message list, its member drawer
+ * and its reaction/reply attributions are already mounted at that moment, so
+ * they need this one subscription -- one call at the top of the open room
+ * re-renders the subtree that names people.
+ *
+ * A hook that only forces a repaint is the right shape here: the value itself
+ * is never stale, only the render that read it.
+ */
+export const usePlotinaContactNamesRepaint = (mx: MatrixClient) => {
+  const [, setVersion] = useState<number>(0);
+  useEffect(
+    () =>
+      subscribeContactNames(mx, () => {
+        setVersion((version: number) => version + 1);
+      }),
+    [mx]
+  );
+};
+
+type PlotinaContactNamesClient = MatrixClient & { plotinaContactNames?: boolean };
+
+/** Recompute one room's cached name; Room.name listeners repaint the list. */
+const recalculateOneRoom = (room: Room) => {
+  try {
+    room.recalculate(); // emits Room.name when the displayed name changes
+  } catch {
+    /* one broken room must not stop the others */
+  }
+};
+
+/**
+ * Recompute every room the client knows. Cheap: Room.recalculate() only emits
+ * Room.name for a room whose displayed name actually changed.
+ */
+export const recalculatePlotinaRoomNames = (mx: MatrixClient) => {
+  mx.getRooms().forEach(recalculateOneRoom);
+};
+
+export const installPlotinaContactNames = (mx: PlotinaContactNamesClient) => {
+  if (mx.plotinaContactNames) return;
+  // The whole point is to hand the SDK a generator on the client it computed
+  // names with; there is no other place the SDK reads it from.
+  // eslint-disable-next-line no-param-reassign
+  mx.plotinaContactNames = true;
+
+  // Return null for everything we do not answer, so the SDK keeps its own
+  // behaviour (member lists, "Empty room", the generated name of a group).
+  // eslint-disable-next-line no-param-reassign
+  mx.roomNameGenerator = (roomId: string): string | null => {
+    const room = mx.getRoom(roomId);
+    // No room in this client yet: the generator has no members to look at, so
+    // the answer waits for ClientEvent.Room / the first sync below.
+    if (!room) return null;
+    return contactNameOfRoom(mx, room) ?? null;
+  };
+
+  // Account data is not room state: nothing recalculates by itself, and the
+  // room list, the header and the notification titles would keep the old name
+  // until the next reload.
+  const handleAccountData = (event: MatrixEvent) => {
+    const type = event.getType();
+    // m.direct decides WHO a room belongs to, so a change there can make a
+    // name apply or stop applying -- both events repaint the same way.
+    if (type === CONTACT_NAMES_EVENT_TYPE || type === AccountDataEvent.Direct) {
+      recalculatePlotinaRoomNames(mx);
+    }
+  };
+  mx.on(ClientEvent.AccountData, handleAccountData);
+
+  // Cold start. Two SDK facts leave a room with the stock name and nothing
+  // recomputes it later, because account data is not room state:
+  //
+  //   * the first /sync carries global account data BEFORE the room sections
+  //     (matrix-js-sdk sync.js), so the handler above runs against an empty
+  //     room list -- the name is stored by then, but no room sees it;
+  //   * for a brand-new room the SDK calls Room.recalculate() BEFORE
+  //     storeRoom() and ClientEvent.Room, so inside the generator
+  //     mx.getRoom(roomId) is still undefined for that room and the name it is
+  //     born with is the member-list one. The list then shows that name until
+  //     the room is opened or an event arrives in it.
+  //
+  // A room is in the client's map by ClientEvent.Room, and after
+  // SyncState.Prepared the whole first sync is applied, so every room that was
+  // born before its name and every name that arrived before its room is
+  // recomputed here -- on the first paint, not on the next room event.
+  mx.on(ClientEvent.Room, recalculateOneRoom);
+  mx.on(ClientEvent.Sync, (state: SyncState) => {
+    if (state === SyncState.Prepared) recalculatePlotinaRoomNames(mx);
+  });
+};
