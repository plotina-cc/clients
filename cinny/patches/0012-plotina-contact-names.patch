@@ -0,0 +1,212 @@
+/*
+Copyright 2026 Plotina <thebob3r@gmail.com>
+
+SPDX-License-Identifier: AGPL-3.0-only
+
+Plotina: personal names for CONTACTS -- the data contract.
+
+A person may want to call someone "Денчик" while that person's own profile, and
+what everyone else sees, keeps their real name. Renaming the room would write
+m.room.name into the room state and rename it for every participant, so the
+name lives in this account's own account data instead, bound to the PERSON:
+
+    cc.plotina.contact_names = { "@bob:plotina.cc": "Денчик" }
+
+One person with two direct chats therefore carries one name in both of them,
+immediately. A group room never takes a contact's name: the name belongs to a
+person, and what a group shows is the room's own name. Only the owner of the
+account can read the event (account data is per-user), it follows the account
+to every device, and nothing is sent to the other participants.
+
+An empty value means "reset": the key is dropped from the map on write, so
+resetting the last name leaves {}. The old room-keyed model
+(cc.plotina.room_aliases) is not read, written or migrated -- it is gone, as
+the owner asked.
+
+Element Web/Desktop, X and Mobile read and write the same event, so a name set
+in one client shows up in the others.
+
+This file is deliberately dependency-free: every function is pure, so the
+storage rules and the contact addressing can be pinned with plain node and no
+browser or Matrix client (cinny/tests/contact_names.test.mjs, run by
+cinny/scripts/test-dm-aliases.sh). The React/Matrix glue is in
+src/app/state/plotinaContactNames.ts.
+*/
+
+export const CONTACT_NAMES_EVENT_TYPE = 'cc.plotina.contact_names';
+
+export type ContactNames = Record<string, string>;
+
+/** room id -> the mxid that room is a direct chat with (from m.direct). */
+export type DirectPartners = Record<string, string>;
+
+const EMPTY_NAMES: ContactNames = {};
+
+/**
+ * Matrix user ids: "@localpart:server". The localpart is not empty (the colon
+ * is at index > 1) and neither is the server part; whitespace and "/" never
+ * appear. Only used to keep junk out of the map -- never to decide who a
+ * person is.
+ */
+export const isUserId = (raw: unknown): raw is string => {
+  if (typeof raw !== 'string' || raw.charAt(0) !== '@') return false;
+  if (/[\s/]/.test(raw)) return false;
+  const colon = raw.indexOf(':');
+  return colon > 1 && colon < raw.length - 1;
+};
+
+/**
+ * Account data content -> name map. Anything that is not a flat object of
+ * string values is read as "no names": a broken or half-written event must
+ * leave the client working exactly as it did before the feature existed.
+ *
+ * Keys are validated in the same pass, because a name under a key that is not
+ * an mxid can never be shown to anyone: dropping it here keeps the stored map
+ * and the rendered map the same map.
+ */
+export const parseContactNames = (raw: unknown): ContactNames => {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return EMPTY_NAMES;
+
+  const source = raw as Record<string, unknown>;
+  const out: ContactNames = {};
+  // Object.keys, not Object.entries: cinny's tsconfig pins lib ES2016.
+  Object.keys(source).forEach((userId) => {
+    if (!isUserId(userId)) return;
+    const value = source[userId];
+    if (typeof value !== 'string') return;
+    const name = value.trim();
+    if (name) out[userId] = name;
+  });
+  return out;
+};
+
+/**
+ * m.direct content ({"@bob:server": ["!dm:server", ...]}) -> room id -> mxid.
+ *
+ * Inverted once per event and cached by the caller, because it is consulted
+ * for every room on every recalculate. Junk keys and values are dropped, so a
+ * broken m.direct cannot make a room look like a dialogue with nobody.
+ */
+export const directPartners = (content: unknown): DirectPartners => {
+  const out: DirectPartners = {};
+  if (!content || typeof content !== 'object' || Array.isArray(content)) return out;
+  const source = content as Record<string, unknown>;
+  Object.keys(source).forEach((userId) => {
+    if (!isUserId(userId)) return;
+    const rooms = source[userId];
+    if (!Array.isArray(rooms)) return;
+    rooms.forEach((roomId) => {
+      if (typeof roomId === 'string' && roomId.charAt(0) === '!') out[roomId] = userId;
+    });
+  });
+  return out;
+};
+
+/** The name this account gave a contact, or undefined when nobody set one. */
+export const contactNameFor = (
+  names: ContactNames,
+  userId: string | undefined
+): string | undefined => {
+  if (!isUserId(userId)) return undefined;
+  const name = names[userId];
+  if (typeof name !== 'string') return undefined;
+  const trimmed = name.trim();
+  return trimmed || undefined;
+};
+
+/**
+ * Who is this room a dialogue with, or undefined when it is not a one-to-one
+ * chat? The room id is only a map key here: "!localpart:server" (room versions
+ * up to 11) and the opaque "!<base64url>" of room version 12 have nothing in
+ * common but the leading "!", so no id shape may be consulted.
+ *
+ * m.direct first -- the account's own statement of which rooms are direct
+ * chats -- then exactly two joined members (how a one-to-one chat looks when
+ * another client never wrote m.direct), then [inviterId] for a pending invite
+ * whose members are not joined yet. The caller only passes an inviter for a
+ * room it knows is a direct invite. Never myself: an m.direct entry pointing at
+ * this account, or a room whose other member is me, is not a contact.
+ */
+export const dmPartnerId = (
+  roomId: string,
+  meId: string | undefined,
+  direct: DirectPartners | undefined,
+  joinedUserIds: readonly string[] | undefined,
+  inviterId?: string | undefined,
+  isSpace?: boolean
+): string | undefined => {
+  // A space is a container of rooms, never a dialogue with a person; and a
+  // room with more than two joined members is a group, whatever m.direct says.
+  // A stale or hand-edited m.direct entry must never put a contact's name on a
+  // room other people are in. Only a room whose membership is unknown falls
+  // through to m.direct alone.
+  if (isSpace) return undefined;
+  if (joinedUserIds && joinedUserIds.length > 2) return undefined;
+
+  const listed = direct && typeof roomId === 'string' ? direct[roomId] : undefined;
+  if (isUserId(listed) && listed !== meId) return listed;
+
+  if (joinedUserIds && joinedUserIds.length === 2 && isUserId(meId)) {
+    const other = joinedUserIds[0] === meId ? joinedUserIds[1] : joinedUserIds[0];
+    if (isUserId(other) && other !== meId) return other;
+  }
+
+  if (isUserId(inviterId) && inviterId !== meId) return inviterId;
+  return undefined;
+};
+
+/**
+ * The name to render for a room: the personal name of the contact it is a
+ * dialogue with, or undefined to keep the room's own name.
+ *
+ * Split out from the React hook so the decision is testable without a client,
+ * and so a group can never be masked: without a single partner there is no
+ * contact, and without a contact there is nothing to look up.
+ */
+export const contactNameForRoom = (
+  names: ContactNames,
+  roomId: string,
+  meId: string | undefined,
+  direct: DirectPartners | undefined,
+  joinedUserIds: readonly string[] | undefined,
+  inviterId?: string | undefined,
+  isSpace?: boolean
+): string | undefined => {
+  const partner = dmPartnerId(roomId, meId, direct, joinedUserIds, inviterId, isSpace);
+  if (!partner) return undefined;
+  return contactNameFor(names, partner);
+};
+
+/**
+ * Returns the map after setting (or, for a blank name, clearing) one contact.
+ *
+ * Returns a new object and never stores an empty value, so a reset leaves no
+ * key behind -- the event stays as {} because Matrix gives clients no way to
+ * delete account data (matrix-js-sdk implements deleteAccountData as a write
+ * of {}).
+ */
+export const contactNamesWith = (
+  names: ContactNames,
+  userId: string,
+  name: string | null | undefined
+): ContactNames => {
+  const next: ContactNames = { ...names };
+  if (!isUserId(userId)) return next;
+
+  const wanted = typeof name === 'string' ? name.trim() : '';
+  if (wanted) {
+    next[userId] = wanted;
+  } else {
+    delete next[userId];
+  }
+  return next;
+};
+
+/** The name to render: the personal name when there is one, else the stock. */
+export const resolveRoomName = (
+  roomName: string | undefined,
+  personalName: string | undefined
+): string => personalName || roomName || '';
+
+/** True when the map holds no names (used to skip work on the common case). */
+export const hasContactNames = (names: ContactNames): boolean => Object.keys(names).length > 0;
