diff --git a/src/app/plugins/call/plotinaAccountData.ts b/src/app/plugins/call/plotinaAccountData.ts
new file mode 100644
index 0000000..00e36ef
--- /dev/null
+++ b/src/app/plugins/call/plotinaAccountData.ts
@@ -0,0 +1,61 @@
+/*
+Copyright 2026 Plotina <thebob3r@gmail.com>
+
+SPDX-License-Identifier: AGPL-3.0-only
+*/
+import type { IContent, MatrixClient } from 'matrix-js-sdk';
+
+/**
+ * Account-data write coming from the call widget.
+ *
+ * Element Call's per-participant volume (its patch 0004) writes
+ * cc.plotina.voice_volumes with client.setAccountData(). Inside a widget that
+ * client is matrix-js-sdk's RoomWidgetClient, created without an access token,
+ * and matrix-widget-api 1.20 has no write-account-data action at all -- only
+ * com.beeper.read_room_account_data (a read) and WidgetDriver.readRoomAccountData().
+ * A custom action is the protocol's normal extension point (Element Call sends
+ * io.element.join / im.vector.hangup the same way), so the frame sends
+ * cc.plotina.set_account_data and this side, which holds the real client,
+ * performs the write.
+ */
+export const PLOTINA_SET_ACCOUNT_DATA = 'cc.plotina.set_account_data';
+
+/** The one account-data type a call widget may write. */
+export const VOICE_VOLUMES_TYPE = 'cc.plotina.voice_volumes';
+
+/** Matrix caps account data at 64 KiB; refuse before the request, not after. */
+const MAX_BYTES = 64 * 1024;
+
+export interface PlotinaAccountDataWrite {
+  type?: unknown;
+  content?: unknown;
+}
+
+/**
+ * Room state is not account data: a call widget must never be able to rename a
+ * room or touch membership, so only the volume map is writable and everything
+ * else is refused before a client call happens.
+ */
+export function isWritableAccountDataType(type: unknown): type is string {
+  return type === VOICE_VOLUMES_TYPE;
+}
+
+export async function applyAccountDataWrite(
+  mx: Pick<MatrixClient, 'setAccountData'>,
+  payload: PlotinaAccountDataWrite | undefined
+): Promise<void> {
+  if (!payload || typeof payload !== 'object') {
+    throw new Error('cc.plotina.set_account_data: payload is not an object');
+  }
+  const { type, content } = payload;
+  if (!isWritableAccountDataType(type)) {
+    throw new Error(`cc.plotina.set_account_data: refusing type ${String(type)}`);
+  }
+  if (typeof content !== 'object' || content === null || Array.isArray(content)) {
+    throw new Error('cc.plotina.set_account_data: content must be an object');
+  }
+  if (JSON.stringify(content).length > MAX_BYTES) {
+    throw new Error('cc.plotina.set_account_data: content exceeds 64 KiB');
+  }
+  await mx.setAccountData(type, content as IContent);
+}
