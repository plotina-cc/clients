diff --git a/src/app/features/settings/updates/Updates.tsx b/src/app/features/settings/updates/Updates.tsx
new file mode 100644
index 0000000..fddeabf
--- /dev/null
+++ b/src/app/features/settings/updates/Updates.tsx
@@ -0,0 +1,445 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import {
+  Badge,
+  Box,
+  Button,
+  Icon,
+  IconButton,
+  Icons,
+  IconSrc,
+  ProgressBar,
+  Scroll,
+  Spinner,
+  Text,
+} from 'folds';
+import { Page, PageContent, PageHeader } from '../../../components/page';
+import { SequenceCard } from '../../../components/sequence-card';
+import { SettingTile } from '../../../components/setting-tile';
+import { SequenceCardStyle } from '../styles.css';
+import {
+  UpdaterHandle,
+  InstallKind,
+  checkForUpdate,
+  describePlotinaVersion,
+  downloadPercent,
+  fetchAppVersion,
+  fetchInstallKind,
+  humanBytes,
+  isUpdatableKind,
+  manualDownloadUrl,
+  probeArtifactSize,
+  relaunchApp,
+} from '../../../../plotina/updater';
+
+type UpdatesProps = {
+  requestClose: () => void;
+};
+
+type UpdaterState =
+  | { kind: 'idle' }
+  | { kind: 'checking' }
+  | { kind: 'upToDate'; checkedVersion: string }
+  | {
+      kind: 'available';
+      version: string;
+      notes?: string;
+      date?: string;
+      size?: number;
+      sizeUnknown: boolean;
+    }
+  | { kind: 'downloading'; received: number; total?: number }
+  | { kind: 'installing' }
+  | { kind: 'installed'; version: string }
+  | { kind: 'manual'; reason: ManualReason }
+  | { kind: 'error'; message: string };
+
+type ManualReason = 'msi' | 'package' | 'other' | 'unknown';
+
+/** Any install the updater cannot move collapses to one of the four manual
+ * states; a kind we did not recognise is treated as the safest option. */
+function asManualReason(kind: InstallKind): ManualReason {
+  if (kind === 'msi' || kind === 'package' || kind === 'other') return kind;
+  return 'unknown';
+}
+
+const MANUAL_MESSAGES: Record<ManualReason, { title: string; body: string }> = {
+  msi: {
+    title: 'Нужна ручная установка',
+    body: 'Автообновление недоступно для MSI-установки. Скачайте новый MSI и установите вручную.',
+  },
+  package: {
+    title: 'Нужна ручная установка',
+    body: 'Автообновление недоступно при установке из deb/rpm: обновите пакет менеджером пакетов либо используйте AppImage.',
+  },
+  other: {
+    title: 'Нужна ручная установка',
+    body: 'Это приложение запущено не из AppImage и не из NSIS-установщика, поэтому обновить себя оно не может. Скачайте свежий установщик.',
+  },
+  unknown: {
+    title: 'Не удалось определить тип установки',
+    body: 'Оболочка приложения не сообщила, как установлена Plotina Lite Desktop, поэтому автообновление не запускается. Скачайте установщик вручную.',
+  },
+};
+
+/** Turn the plugin's English error into something a user can act on. */
+export function describeUpdaterError(error: unknown): string {
+  const raw = error instanceof Error ? error.message : String(error);
+  const message = raw.trim();
+  if (!message) return 'Неизвестная ошибка.';
+  if (/no endpoints|not configured/i.test(message)) {
+    return 'В этой сборке не настроен источник обновлений.';
+  }
+  if (/404|not found/i.test(message)) {
+    return 'Файл обновлений не найден на сервере (plotina.cc/dl/lite/latest.json).';
+  }
+  if (/timeout|timed out/i.test(message)) {
+    return 'Сервер обновлений не ответил за отведённое время. Проверьте подключение и повторите.';
+  }
+  if (/signature|verify|minisign/i.test(message)) {
+    return `Подпись обновления не прошла проверку — обновление не установлено: ${message}`;
+  }
+  return message;
+}
+
+export function Updates({ requestClose }: UpdatesProps) {
+  const [state, setState] = useState<UpdaterState>({ kind: 'idle' });
+  const [installKind, setInstallKind] = useState<InstallKind>('unknown');
+  const [version, setVersion] = useState('');
+  const updateRef = useRef<UpdaterHandle | undefined>(undefined);
+
+  useEffect(() => {
+    let mounted = true;
+    fetchInstallKind().then((kind) => {
+      if (!mounted) return;
+      setInstallKind(kind);
+      // A deb/rpm/MSI install can never update itself: say so at once instead
+      // of letting the user press a button that only fails.
+      if (!isUpdatableKind(kind) && kind !== 'web') {
+        setState({ kind: 'manual', reason: asManualReason(kind) });
+      }
+    });
+    fetchAppVersion().then((value) => mounted && setVersion(value));
+    return () => {
+      mounted = false;
+    };
+  }, []);
+
+  const handleClose = useCallback(() => {
+    updateRef.current?.close().catch(() => undefined);
+    updateRef.current = undefined;
+    requestClose();
+  }, [requestClose]);
+
+  const handleCheck = useCallback(async () => {
+    setState({ kind: 'checking' });
+    try {
+      if (!isUpdatableKind(installKind)) {
+        setState({ kind: 'manual', reason: asManualReason(installKind) });
+        return;
+      }
+      const update = await checkForUpdate(installKind);
+      if (!update) {
+        setState({ kind: 'upToDate', checkedVersion: version });
+        return;
+      }
+      updateRef.current = update;
+      const size = await probeArtifactSize(update.info.artifactUrl);
+      setState({
+        kind: 'available',
+        version: update.info.version,
+        notes: update.info.notes,
+        date: update.info.date,
+        size,
+        sizeUnknown: size === undefined,
+      });
+    } catch (error) {
+      setState({ kind: 'error', message: describeUpdaterError(error) });
+    }
+  }, [installKind, version]);
+
+  const handleInstall = useCallback(async () => {
+    const update = updateRef.current;
+    if (!update) return;
+    try {
+      setState({ kind: 'downloading', received: 0 });
+      await update.download((received, total) => setState({ kind: 'downloading', received, total }));
+      setState({ kind: 'installing' });
+      await update.install();
+      setState({ kind: 'installed', version: update.info.version });
+    } catch (error) {
+      setState({ kind: 'error', message: describeUpdaterError(error) });
+    }
+  }, []);
+
+  const handleRelaunch = useCallback(async () => {
+    try {
+      await relaunchApp();
+    } catch (error) {
+      setState({ kind: 'error', message: describeUpdaterError(error) });
+    }
+  }, []);
+
+  const busy = state.kind === 'checking' || state.kind === 'downloading' || state.kind === 'installing';
+  const manual = state.kind === 'manual' ? MANUAL_MESSAGES[state.reason] : undefined;
+
+  return (
+    <Page>
+      <PageHeader outlined={false}>
+        <Box grow="Yes" gap="200">
+          <Box grow="Yes" alignItems="Center" gap="200">
+            <Text size="H3" truncate>
+              Обновления
+            </Text>
+          </Box>
+          <Box shrink="No">
+            <IconButton onClick={handleClose} variant="Surface">
+              <Icon src={Icons.Cross} />
+            </IconButton>
+          </Box>
+        </Box>
+      </PageHeader>
+      <Box grow="Yes">
+        <Scroll hideTrack visibility="Hover">
+          <PageContent>
+            <Box direction="Column" gap="700">
+              <SequenceCard className={SequenceCardStyle} variant="SurfaceVariant" direction="Column" gap="400">
+                <SettingTile
+                  title="Установленная версия"
+                  description={
+                    version
+                      ? `${describePlotinaVersion(version)} (${version})`
+                      : 'Определяем версию приложения…'
+                  }
+                  after={
+                    <Badge variant={isUpdatableKind(installKind) ? 'Secondary' : 'Warning'} fill="Soft" radii="Pill">
+                      <Text size="L400">{installKindLabel(installKind)}</Text>
+                    </Badge>
+                  }
+                />
+                <Box gap="200" alignItems="Center">
+                  <Button
+                    size="300"
+                    variant="Primary"
+                    fill="Soft"
+                    radii="Pill"
+                    before={
+                      state.kind === 'checking' ? (
+                        <Spinner size="50" variant="Primary" fill="Soft" />
+                      ) : (
+                        <Icon src={Icons.Download} size="100" />
+                      )
+                    }
+                    disabled={busy}
+                    onClick={handleCheck}
+                  >
+                    <Text size="B400">
+                      {state.kind === 'idle' ? 'Проверить обновления' : 'Проверить ещё раз'}
+                    </Text>
+                  </Button>
+                  {!isUpdatableKind(installKind) && (
+                    <Button
+                      size="300"
+                      variant="Secondary"
+                      fill="Soft"
+                      radii="Pill"
+                      before={<Icon src={Icons.External} size="100" />}
+                      as="a"
+                      href={manualDownloadUrl(installKind)}
+                      target="_blank"
+                      rel="noreferrer noopener"
+                    >
+                      <Text size="B400">Скачать установщик</Text>
+                    </Button>
+                  )}
+                </Box>
+              </SequenceCard>
+
+              {state.kind === 'checking' && (
+                <StatusCard variant="Secondary" text="Проверяем обновления…" busy />
+              )}
+
+              {state.kind === 'upToDate' && (
+                <StatusCard
+                  variant="Success"
+                  icon={Icons.CheckTwice}
+                  title="Обновлений нет"
+                  text={`Установлена последняя версия (${describePlotinaVersion(state.checkedVersion) || '—'}).`}
+                />
+              )}
+
+              {state.kind === 'available' && (
+                <SequenceCard className={SequenceCardStyle} variant="SurfaceVariant" direction="Column" gap="300">
+                  <Box gap="200" alignItems="Center">
+                    <Icon src={Icons.ArrowGoRightPlus} size="100" />
+                    <Text size="T300">
+                      Доступно обновление: <b>{describePlotinaVersion(state.version)}</b>
+                    </Text>
+                  </Box>
+                  {state.notes && (
+                    <Text size="T200" priority="300" style={{ whiteSpace: 'pre-wrap' }}>
+                      {state.notes}
+                    </Text>
+                  )}
+                  <Text size="T200" priority="400">
+                    {state.size ? `Размер загрузки: ${humanBytes(state.size)}` : ''}
+                    {state.sizeUnknown ? 'Размер станет известен в начале загрузки.' : ''}
+                    {state.date ? ` Опубликовано: ${state.date}` : ''}
+                  </Text>
+                  <Box gap="200">
+                    <Button
+                      size="400"
+                      variant="Primary"
+                      radii="Pill"
+                      before={<Icon src={Icons.Download} size="100" />}
+                      onClick={handleInstall}
+                    >
+                      <Text size="B300">Скачать и установить</Text>
+                    </Button>
+                    <Button
+                      size="400"
+                      variant="Secondary"
+                      fill="Soft"
+                      radii="Pill"
+                      onClick={() => {
+                        updateRef.current?.close().catch(() => undefined);
+                        updateRef.current = undefined;
+                        setState({ kind: 'idle' });
+                      }}
+                    >
+                      <Text size="B300">Не сейчас</Text>
+                    </Button>
+                  </Box>
+                </SequenceCard>
+              )}
+
+              {state.kind === 'downloading' && (
+                <SequenceCard className={SequenceCardStyle} variant="SurfaceVariant" direction="Column" gap="300">
+                  <Box grow="Yes" gap="200" alignItems="Center">
+                    <Badge variant="Secondary" fill="Solid" radii="300">
+                      <Text size="L400">
+                        Загрузка: {state.total ? `${downloadPercent(state.received, state.total)}%` : '…'}
+                      </Text>
+                    </Badge>
+                    <Box grow="Yes">
+                      <ProgressBar
+                        variant="Primary"
+                        size="300"
+                        min={0}
+                        max={state.total ?? Math.max(state.received, 1)}
+                        value={state.received}
+                      />
+                    </Box>
+                    <Text size="T200" priority="300">
+                      {`${humanBytes(state.received)}${state.total ? ` / ${humanBytes(state.total)}` : ''}`}
+                    </Text>
+                    <Spinner size="50" variant="Secondary" fill="Soft" />
+                  </Box>
+                </SequenceCard>
+              )}
+
+              {state.kind === 'installing' && (
+                <StatusCard
+                  variant="Secondary"
+                  text={
+                    installKind === 'nsis'
+                      ? 'Устанавливаем обновление. Приложение сейчас перезапустится.'
+                      : 'Заменяем AppImage обновлённым…'
+                  }
+                  busy
+                />
+              )}
+
+              {state.kind === 'installed' && (
+                <SequenceCard className={SequenceCardStyle} variant="SurfaceVariant" direction="Column" gap="300">
+                  <SettingTile
+                    title={`Обновление до ${describePlotinaVersion(state.version)} установлено`}
+                    description="Перезапустите приложение, чтобы заработала новая версия."
+                    after={
+                      <Button
+                        size="300"
+                        variant="Primary"
+                        radii="Pill"
+                        before={<Icon src={Icons.ArrowGoRight} size="100" />}
+                        onClick={handleRelaunch}
+                      >
+                        <Text size="B400">Перезапустить</Text>
+                      </Button>
+                    }
+                  />
+                </SequenceCard>
+              )}
+
+              {manual && (
+                <StatusCard variant="Warning" icon={Icons.Warning} title={manual.title} text={manual.body} />
+              )}
+
+              {state.kind === 'error' && (
+                <StatusCard
+                  variant="Critical"
+                  icon={Icons.Warning}
+                  title="Не удалось проверить обновления"
+                  text={state.message}
+                  action={{ label: 'Повторить', onClick: handleCheck }}
+                />
+              )}
+            </Box>
+          </PageContent>
+        </Scroll>
+      </Box>
+    </Page>
+  );
+}
+
+function installKindLabel(kind: InstallKind): string {
+  if (kind === 'appimage') return 'AppImage';
+  if (kind === 'nsis') return 'NSIS (Windows)';
+  if (kind === 'msi') return 'MSI (Windows)';
+  if (kind === 'package') return 'deb/rpm';
+  if (kind === 'web') return 'веб-версия';
+  if (kind === 'other') return 'ручная установка';
+  return 'тип установки неизвестен';
+}
+
+type StatusCardProps = {
+  variant: 'Primary' | 'Secondary' | 'Success' | 'Warning' | 'Critical';
+  title?: string;
+  text: string;
+  busy?: boolean;
+  icon?: IconSrc;
+  action?: { label: string; onClick: () => void };
+};
+
+function StatusCard({ variant, title, text, busy, icon, action }: StatusCardProps) {
+  return (
+    <SequenceCard className={SequenceCardStyle} variant="SurfaceVariant" direction="Column" gap="200">
+      <Box gap="200" alignItems="Center">
+        {icon && <Icon src={icon} size="100" />}
+        {title && (
+          <Text size="T300">
+            <b>{title}</b>
+          </Text>
+        )}
+        {busy && <Spinner size="50" variant={variant} fill="Soft" />}
+      </Box>
+      <Text size="T200" priority="300" style={{ wordBreak: 'break-word' }}>
+        {text}
+      </Text>
+      {action && (
+        <Box>
+          <Button
+            size="300"
+            variant="Secondary"
+            fill="Soft"
+            radii="Pill"
+            before={<Icon src={Icons.ArrowGoRight} size="100" />}
+            onClick={action.onClick}
+          >
+            <Text size="B400">{action.label}</Text>
+          </Button>
+        </Box>
+      )}
+    </SequenceCard>
+  );
+}
+
+export type { UpdaterState };
