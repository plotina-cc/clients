diff --git a/src/plotina/updater.ts b/src/plotina/updater.ts
new file mode 100644
index 0000000..11af04d
--- /dev/null
+++ b/src/plotina/updater.ts
@@ -0,0 +1,212 @@
+/**
+ * Plotina Lite Desktop — the Tauri updater, wrapped for a codebase that is also
+ * built for the browser.
+ *
+ * Every Tauri module is loaded dynamically and only from functions that first
+ * proved they are running inside the desktop shell (`isTauriDesktop`). A browser
+ * build therefore resolves none of it at runtime: Settings simply does not show
+ * the update row, and nothing tries to talk to a non-existent IPC layer.
+ *
+ * The install kind matters more here than it looks. Our feed carries one signed
+ * artifact per platform — the AppImage and the NSIS setup.exe — and the plugin
+ * resolves `<os>-<arch>-<installer>` before falling back to the bare
+ * `<os>-<arch>`. So a deb/rpm install that asks this feed would be handed an
+ * AppImage to `dpkg -i`, and an MSI install an NSIS setup.exe to run over a
+ * Windows Installer product: two uninstall entries and a package database that
+ * no longer matches the files on disk. Rather than let that happen, we ask the
+ * shell which kind of install this is and show a manual-install state instead —
+ * the user then updates through apt/dnf or by installing the new MSI, which is
+ * what those managers are for anyway. See `src-tauri/src/install_kind.rs` and
+ * the "Updater" section of cinny/README.md.
+ */
+
+export type InstallKind =
+  | 'appimage'
+  | 'nsis'
+  | 'msi'
+  | 'package'
+  | 'other'
+  | 'unknown'
+  | 'web';
+
+/** Kinds the built-in updater can actually complete for. */
+export function isUpdatableKind(kind: InstallKind): boolean {
+  return kind === 'appimage' || kind === 'nsis';
+}
+
+export const DL_BASE = 'https://plotina.cc/dl/';
+
+/** Stable manual-install artifacts, one per non-updatable install kind. These
+ * are the aliases the edge mirrors from our releases (infra scripts/assets.map),
+ * so they always point at the newest build. */
+export const MANUAL_ARTIFACTS: Record<string, string> = {
+  msi: 'Plotina-Lite-Desktop.msi',
+  package: 'Plotina-Lite-Desktop.deb',
+  appimage: 'Plotina-Lite-Desktop.AppImage',
+  other: 'Plotina-Lite-Desktop.AppImage',
+  unknown: 'Plotina-Lite-Desktop.AppImage',
+};
+
+export function manualDownloadUrl(kind: InstallKind): string {
+  return `${DL_BASE}${MANUAL_ARTIFACTS[kind] ?? MANUAL_ARTIFACTS.other}`;
+}
+
+export function isTauriDesktop(): boolean {
+  return typeof window !== 'undefined' && '__TAURI_INTERNALS__' in window;
+}
+
+/**
+ * Version the app was built with, e.g. '4.12.818'.
+ *
+ * CI stamps it as <major>.<minor>.<upstream patch * 100 + build counter> so
+ * that successive Plotina builds compare correctly (see cinny/scripts/
+ * build_config.py for why a plain semver prerelease is not usable: '-' is
+ * illegal in an RPM Version). This turns it back into what the user expects.
+ */
+export function describePlotinaVersion(version?: string): string {
+  const raw = (version ?? '').trim().replace(/^v/, '');
+  const parts = raw.split('.');
+  if (parts.length !== 3 || parts.some((part) => !/^\d+$/.test(part))) {
+    return raw || '—';
+  }
+  const [major, minor, patch] = parts.map((part) => Number.parseInt(part, 10));
+  const base = `${major}.${minor}.${Math.floor(patch / 100)}`;
+  const build = patch % 100;
+  return build === 0 ? `${base} (dev-сборка)` : `${base}, сборка ${build}`;
+}
+
+/** 15461882 -> '14.7 МБ'. Deliberately Russian: the whole update flow is. */
+export function humanBytes(bytes?: number): string {
+  if (typeof bytes !== 'number' || !Number.isFinite(bytes) || bytes <= 0) return '';
+  const units = ['Б', 'КБ', 'МБ', 'ГБ'];
+  let value = bytes;
+  let unit = 0;
+  while (value >= 1024 && unit < units.length - 1) {
+    value /= 1024;
+    unit += 1;
+  }
+  const rounded = value >= 10 || unit === 0 ? Math.round(value) : Math.round(value * 10) / 10;
+  return `${rounded} ${units[unit]}`;
+}
+
+/** Percent for a progress bar; never above 100 and never NaN. */
+export function downloadPercent(received: number, total?: number): number {
+  if (!total || total <= 0) return 0;
+  return Math.min(100, Math.max(0, Math.round((received / total) * 100)));
+}
+
+export type UpdaterInfo = {
+  version: string;
+  currentVersion: string;
+  notes?: string;
+  date?: string;
+  /** Where the artifact will be downloaded from, when the feed told us. */
+  artifactUrl?: string;
+};
+
+export type UpdaterHandle = {
+  info: UpdaterInfo;
+  /** Downloads the signed artifact; `total` is unknown until the transfer starts. */
+  download: (onProgress: (received: number, total?: number) => void) => Promise<void>;
+  install: () => Promise<void>;
+  close: () => Promise<void>;
+};
+
+export async function fetchInstallKind(): Promise<InstallKind> {
+  if (!isTauriDesktop()) return 'web';
+  try {
+    const { invoke } = await import('@tauri-apps/api/core');
+    const kind = await invoke<string>('plotina_install_kind');
+    const normalised = typeof kind === 'string' ? kind.toLowerCase() : 'unknown';
+    const known: InstallKind[] = ['appimage', 'nsis', 'msi', 'package', 'other', 'unknown'];
+    return known.indexOf(normalised as InstallKind) !== -1 ? (normalised as InstallKind) : 'unknown';
+  } catch {
+    // No answer from the shell: treat the install as manual rather than
+    // starting a download that may end half-applied.
+    return 'unknown';
+  }
+}
+
+export async function fetchAppVersion(): Promise<string> {
+  if (!isTauriDesktop()) return '';
+  try {
+    const { getVersion } = await import('@tauri-apps/api/app');
+    return await getVersion();
+  } catch {
+    return '';
+  }
+}
+
+/** The artifact this platform would download, read out of the feed response. */
+function artifactUrlFor(raw: Record<string, unknown>, kind: InstallKind): string | undefined {
+  const platforms = raw?.platforms as Record<string, { url?: unknown }> | undefined;
+  if (!platforms || typeof platforms !== 'object') return undefined;
+  const suffix = kind === 'nsis' || kind === 'msi' ? '.exe' : '.AppImage';
+  const entries = Object.keys(platforms).map((key) => platforms[key]);
+  for (const entry of entries) {
+    if (entry && typeof entry.url === 'string' && entry.url.endsWith(suffix)) return entry.url;
+  }
+  return undefined;
+}
+
+/**
+ * Ask the feed for an update. Resolves to `null` when there is nothing newer.
+ * Throws with a readable message when the check itself failed (no network, no
+ * endpoint, a manifest we cannot verify) — the caller shows that as an error.
+ */
+export async function checkForUpdate(kind: InstallKind): Promise<UpdaterHandle | null> {
+  const { check } = await import('@tauri-apps/plugin-updater');
+  const update = await check({ timeout: 30000 });
+  if (!update) return null;
+  const raw = (update.rawJson ?? {}) as Record<string, unknown>;
+  const handle: UpdaterHandle = {
+    info: {
+      version: update.version,
+      currentVersion: update.currentVersion,
+      notes: typeof update.body === 'string' ? update.body : undefined,
+      date: update.date,
+      artifactUrl: artifactUrlFor(raw, kind),
+    },
+    download: async (onProgress) => {
+      let received = 0;
+      let total: number | undefined;
+      await update.download((event) => {
+        if (event.event === 'Started') {
+          total = event.data.contentLength;
+          received = 0;
+        } else if (event.event === 'Progress') {
+          received += event.data.chunkLength;
+        }
+        onProgress(received, total);
+      });
+    },
+    install: () => update.install(),
+    close: () => update.close(),
+  };
+  return handle;
+}
+
+/**
+ * Size of the artifact before the download starts, from a HEAD request through
+ * the Tauri HTTP plugin (a browser fetch would be CORS-blocked). Purely
+ * cosmetic: any failure just means the dialog shows the size once the transfer
+ * has begun.
+ */
+export async function probeArtifactSize(url?: string): Promise<number | undefined> {
+  if (!url || !isTauriDesktop()) return undefined;
+  try {
+    const { fetch: tauriFetch } = await import('@tauri-apps/plugin-http');
+    const response = await tauriFetch(url, { method: 'HEAD' });
+    if (!response.ok) return undefined;
+    const header = response.headers.get('content-length');
+    const size = header ? Number.parseInt(header, 10) : Number.NaN;
+    return Number.isFinite(size) && size > 0 ? size : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+export async function relaunchApp(): Promise<void> {
+  const { relaunch } = await import('@tauri-apps/plugin-process');
+  await relaunch();
+}
