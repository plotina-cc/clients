index 0000000..893d2b2
--- /dev/null
+++ b/src/plotina/noiseLevel.ts
@@ -0,0 +1,134 @@
+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+/**
+ * Plotina: the noise-suppression level, as the UI sees it.
+ *
+ * Element Call has no level of its own. DeepFilterNet3 is attached by
+ * /noise/plotina-dfn.js, a plain script served next to this bundle, which
+ * publishes the setter as window.__plotinaSetLevel and its state as
+ * window.__plotinaDfn. This module is the only place in the bundle that reads
+ * or calls either of them, so every control agrees on one storage key and on
+ * the order values are taken in.
+ *
+ * The key is shared with the other clients' sliders: what "level 60" means must
+ * not depend on which one wrote it.
+ */
+
+export const NOISE_LEVEL_STORAGE_KEY = "plotina.noise.level";
+export const DEFAULT_NOISE_LEVEL = 40;
+
+interface NoiseBridgeState {
+  status?: string;
+  level?: number;
+  applied?: number;
+  bypass?: boolean;
+}
+
+type NoiseLevelSetter = (
+  value: number,
+  options?: { persist?: boolean; report?: boolean },
+) => number;
+
+declare global {
+  interface Window {
+    /** Defined by /noise/plotina-dfn.js, absent when that script did not load. */
+    __plotinaSetLevel?: NoiseLevelSetter;
+    __plotinaDfn?: NoiseBridgeState;
+  }
+}
+
+/** A level the bridge and the slider both accept: an integer in 0–100. */
+export function clampNoiseLevel(value: unknown): number {
+  const n = Math.round(Number(value));
+  if (!isFinite(n)) return DEFAULT_NOISE_LEVEL;
+  return Math.max(0, Math.min(100, n));
+}
+
+/** Whether the noise bridge is on the page at all. */
+export function isNoiseSuppressionAvailable(): boolean {
+  return typeof window.__plotinaSetLevel === "function";
+}
+
+/* The bridge is the authority once it has a value: it is what the microphone
+   track is actually running with, including a ?plotina-level= the call was
+   opened with. Same order as storedLevel() in the old floating panel, minus
+   the panel: bridge state, URL, storage, default. */
+function levelFromUrl(): number | null {
+  try {
+    const search = new URLSearchParams(window.location.search).get(
+      "plotina-level",
+    );
+    if (search !== null && search !== "") return clampNoiseLevel(search);
+    const hash = window.location.hash ?? "";
+    const mark = hash.indexOf("?");
+    if (mark !== -1) {
+      const fromHash = new URLSearchParams(hash.slice(mark + 1)).get(
+        "plotina-level",
+      );
+      if (fromHash !== null && fromHash !== "")
+        return clampNoiseLevel(fromHash);
+    }
+  } catch {
+    /* a malformed URL is not a reason to lose the setting */
+  }
+  return null;
+}
+
+export function readNoiseLevel(): number {
+  const state = window.__plotinaDfn;
+  if (state && typeof state.level === "number")
+    return clampNoiseLevel(state.level);
+
+  const fromUrl = levelFromUrl();
+  if (fromUrl !== null) return fromUrl;
+
+  try {
+    const stored = localStorage.getItem(NOISE_LEVEL_STORAGE_KEY);
+    if (stored !== null && stored !== "") return clampNoiseLevel(stored);
+  } catch {
+    /* private mode blocks storage; the default still works */
+  }
+  return DEFAULT_NOISE_LEVEL;
+}
+
+function storeLevel(level: number): void {
+  try {
+    localStorage.setItem(NOISE_LEVEL_STORAGE_KEY, String(level));
+  } catch {
+    /* private mode */
+  }
+}
+
+/**
+ * Apply a level: to the processor that is attached right now, and to storage.
+ *
+ * `commit: false` is a slider still moving — the level reaches the processor
+ * and nothing else, exactly like the old panel's drag. `commit: true` is the
+ * value the user settled on: it is persisted, and the bridge reports it.
+ *
+ * The bridge persists on commit itself; the key is written here as well because
+ * it is the contract with the other clients' sliders, and a write that happens
+ * twice is a write that cannot be missed.
+ */
+export function setNoiseLevel(value: number, commit = true): number {
+  const level = clampNoiseLevel(value);
+  const bridge = window.__plotinaSetLevel;
+
+  if (typeof bridge === "function") {
+    bridge(level, { persist: commit, report: commit });
+  }
+  if (commit) storeLevel(level);
+  if (typeof bridge !== "function") {
+    // Nothing applied it, so tell whoever else draws this setting (Plotina Lite
+    // keeps its own selector) that it changed.
+    document.dispatchEvent(
+      new CustomEvent("plotina-noise-level", { detail: level }),
+    );
+  }
+  return level;
+}
