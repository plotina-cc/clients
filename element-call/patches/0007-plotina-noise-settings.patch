@@ -0,0 +1,120 @@
+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import {
+  DEFAULT_NOISE_LEVEL,
+  NOISE_LEVEL_STORAGE_KEY,
+  clampNoiseLevel,
+  isNoiseSuppressionAvailable,
+  readNoiseLevel,
+  setNoiseLevel,
+} from "./noiseLevel";
+
+// The level is ours, not Element Call's: it lives in localStorage and in the
+// DeepFilterNet3 bridge (/noise/plotina-dfn.js), which is a plain script and so
+// only visible as a window global.
+
+describe("clampNoiseLevel", () => {
+  it("keeps a level inside 0–100 and rounds it", () => {
+    expect(clampNoiseLevel(150)).toBe(100);
+    expect(clampNoiseLevel(-5)).toBe(0);
+    expect(clampNoiseLevel(41.6)).toBe(42);
+    expect(clampNoiseLevel("70")).toBe(70);
+  });
+
+  it("falls back to the default for a value that is not a number", () => {
+    expect(clampNoiseLevel("loud")).toBe(DEFAULT_NOISE_LEVEL);
+    expect(clampNoiseLevel(NaN)).toBe(DEFAULT_NOISE_LEVEL);
+    expect(clampNoiseLevel(undefined)).toBe(DEFAULT_NOISE_LEVEL);
+  });
+});
+
+describe("isNoiseSuppressionAvailable", () => {
+  it("is true only once the noise bridge is on the page", () => {
+    expect(isNoiseSuppressionAvailable()).toBe(false);
+    window.__plotinaSetLevel = (value: number): number => value;
+    expect(isNoiseSuppressionAvailable()).toBe(true);
+  });
+});
+
+describe("readNoiseLevel", () => {
+  beforeEach(() => {
+    localStorage.clear();
+    window.history.replaceState({}, "", "/");
+  });
+
+  it("prefers the value the bridge is running with", () => {
+    localStorage.setItem(NOISE_LEVEL_STORAGE_KEY, "20");
+    window.__plotinaDfn = { status: "attached", level: 65 };
+    expect(readNoiseLevel()).toBe(65);
+  });
+
+  it("uses the level from the URL before the stored one", () => {
+    localStorage.setItem(NOISE_LEVEL_STORAGE_KEY, "20");
+    window.history.replaceState(
+      {},
+      "",
+      "/room/!call:example.org?plotina-level=30",
+    );
+    expect(readNoiseLevel()).toBe(30);
+  });
+
+  it("falls back to the stored level, then to the default", () => {
+    expect(readNoiseLevel()).toBe(DEFAULT_NOISE_LEVEL);
+    localStorage.setItem(NOISE_LEVEL_STORAGE_KEY, "55");
+    expect(readNoiseLevel()).toBe(55);
+  });
+});
+
+describe("setNoiseLevel", () => {
+  beforeEach(() => {
+    localStorage.clear();
+  });
+
+  it("hands the value to the bridge and persists it on commit", () => {
+    const bridge = vi.fn((value: number): number => value);
+    window.__plotinaSetLevel = bridge;
+
+    expect(setNoiseLevel(70, true)).toBe(70);
+
+    expect(bridge).toHaveBeenCalledWith(70, { persist: true, report: true });
+    expect(localStorage.getItem(NOISE_LEVEL_STORAGE_KEY)).toBe("70");
+  });
+
+  it("does not write storage or report while the slider is still moving", () => {
+    const bridge = vi.fn((value: number): number => value);
+    window.__plotinaSetLevel = bridge;
+
+    setNoiseLevel(55, false);
+
+    expect(bridge).toHaveBeenCalledWith(55, { persist: false, report: false });
+    expect(localStorage.getItem(NOISE_LEVEL_STORAGE_KEY)).toBeNull();
+  });
+
+  it("still stores the committed value when the bridge is not loaded", () => {
+    expect(setNoiseLevel(35, true)).toBe(35);
+    expect(localStorage.getItem(NOISE_LEVEL_STORAGE_KEY)).toBe("35");
+  });
+
+  it("clamps what the slider can hand it", () => {
+    const bridge = vi.fn((value: number): number => value);
+    window.__plotinaSetLevel = bridge;
+
+    setNoiseLevel(180, true);
+
+    expect(bridge).toHaveBeenCalledWith(100, { persist: true, report: true });
+    expect(localStorage.getItem(NOISE_LEVEL_STORAGE_KEY)).toBe("100");
+  });
+});
+
+afterEach(() => {
+  delete window.__plotinaSetLevel;
+  delete window.__plotinaDfn;
+  localStorage.clear();
+});
