--- /dev/null
+++ b/src/plotina/NoiseSuppressionSetting.tsx
@@ -0,0 +1,114 @@
+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { type FC, useCallback, useEffect, useRef, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { AudioIcon } from "@vector-im/compound-design-tokens/assets/web/icons";
+
+import styles from "./NoiseSuppressionSetting.module.css";
+import { Slider } from "../Slider";
+import {
+  isNoiseSuppressionAvailable,
+  readNoiseLevel,
+  setNoiseLevel,
+} from "./noiseLevel";
+
+/** A drag asks for a value per pixel; the processor gets one every 60 ms. */
+const APPLY_INTERVAL_MS = 60;
+
+/**
+ * Plotina: the noise-suppression row in Settings → Audio.
+ *
+ * A slider and the level it produces, next to the microphone picker. The
+ * value goes to the DeepFilterNet3 worklet through window.__plotinaSetLevel and
+ * is stored under the same key the other clients use, so it survives the call
+ * and applies to the next one.
+ */
+export const NoiseSuppressionSetting: FC = () => {
+  const { t } = useTranslation();
+  // Read once per mount: the settings modal mounts when it opens, and the
+  // bridge is a plain script that is either there for the whole session or not
+  // at all.
+  const [available] = useState(isNoiseSuppressionAvailable);
+  const [level, setLevel] = useState(readNoiseLevel);
+  const [sliderValue, setSliderValue] = useState(level);
+  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+  const stopTimer = useCallback(() => {
+    if (timer.current !== null) {
+      clearTimeout(timer.current);
+      timer.current = null;
+    }
+  }, []);
+
+  useEffect(() => stopTimer, [stopTimer]);
+
+  const onValueChange = useCallback(
+    (next: number) => {
+      setSliderValue(next);
+      // Live during the drag: the processor is cheap to talk to, the log and
+      // the stored value are not, so the commit below is what persists.
+      stopTimer();
+      timer.current = setTimeout(() => {
+        timer.current = null;
+        setNoiseLevel(next, false);
+      }, APPLY_INTERVAL_MS);
+    },
+    [stopTimer],
+  );
+
+  const onValueCommit = useCallback(
+    (next: number) => {
+      stopTimer();
+      setLevel(next);
+      setSliderValue(next);
+      setNoiseLevel(next, true);
+    },
+    [stopTimer],
+  );
+
+  const label = t("settings.noise_suppression_label");
+  const unit = t("settings.noise_suppression_unit");
+  const format = useCallback(
+    (value: number): string =>
+      value === 0 ? t("settings.noise_suppression_off") : `${value} ${unit}`,
+    [t, unit],
+  );
+
+  return (
+    <div
+      className={styles.noiseSuppression}
+      data-testid="plotina-noise-suppression"
+    >
+      <label className={styles.label}>
+        <AudioIcon className={styles.icon} aria-hidden />
+        {/* One text run, not siblings: the flex gap would otherwise render as
+            "Noise suppression : 40 dB". */}
+        <span className={styles.name}>
+          {`${label}: `}
+          <span className={styles.value}>{format(level)}</span>
+        </span>
+      </label>
+      <p>
+        {available
+          ? t("settings.noise_suppression_description")
+          : t("settings.noise_suppression_unavailable")}
+      </p>
+      <Slider
+        label={label}
+        value={sliderValue}
+        onValueChange={onValueChange}
+        onValueCommit={onValueCommit}
+        min={0}
+        max={100}
+        step={1}
+        disabled={!available}
+        tooltipFormatter={format}
+      />
+    </div>
+  );
+};
diff --git a/src/plotina/noiseLevel.test.ts b/src/plotina/noiseLevel.test.ts
new file mode 100644
