@@ -0,0 +1,138 @@
+/*
+Copyright 2026 Element Creations Ltd.
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { fireEvent, render, screen, within } from "@testing-library/react";
+import { TooltipProvider } from "@vector-im/compound-web";
+import { type MatrixClient } from "matrix-js-sdk";
+
+import { NoiseSuppressionSetting } from "./NoiseSuppressionSetting";
+import { NOISE_LEVEL_STORAGE_KEY } from "./noiseLevel";
+import { SettingsModal } from "../settings/SettingsModal";
+import { MediaDevicesContext } from "../MediaDevicesContext";
+import { mockMediaDevices } from "../utils/test";
+
+// The audio tab also renders the background-blur checkbox, which wants the
+// processor context; our row does not depend on it.
+vi.mock("../livekit/TrackProcessorContext", () => ({
+  useTrackProcessor: (): { supported: boolean; processor: undefined } => ({
+    supported: false,
+    processor: undefined,
+  }),
+  useTrackProcessorSync: (): void => {},
+}));
+
+function renderSetting(): HTMLElement {
+  render(
+    <TooltipProvider>
+      <NoiseSuppressionSetting />
+    </TooltipProvider>,
+  );
+  return noiseRow();
+}
+
+/* The compound tooltip names our slider after its own value, so the row is
+   found by its test id and the slider is queried inside it. */
+function noiseRow(): HTMLElement {
+  return screen.getByTestId("plotina-noise-suppression");
+}
+
+function withBridge(): ReturnType<typeof vi.fn> {
+  const bridge = vi.fn((value: number): number => value);
+  window.__plotinaSetLevel = bridge;
+  return bridge;
+}
+
+const mockClient = {
+  getUserId: (): string => "@user:example.org",
+  getDeviceId: (): string => "DEVICE",
+  getUser: (): null => null,
+  getCrypto: (): undefined => undefined,
+  credentials: { userId: "@user:example.org" },
+} as Partial<MatrixClient> as MatrixClient;
+
+describe("NoiseSuppressionSetting", () => {
+  beforeEach(() => {
+    localStorage.clear();
+    delete window.__plotinaDfn;
+    delete window.__plotinaSetLevel;
+  });
+
+  it("shows the stored level next to the slider", () => {
+    localStorage.setItem(NOISE_LEVEL_STORAGE_KEY, "60");
+    withBridge();
+
+    const row = renderSetting();
+
+    expect(within(row).getByText("60 dB")).toBeInTheDocument();
+    // One space after the colon, none before it: the label and the value are
+    // siblings in a flex row, and a gap would push them apart.
+    expect(row).toHaveTextContent(/^Noise suppression: 60 dB/);
+    expect(within(row).getByRole("slider")).toHaveAttribute(
+      "aria-valuenow",
+      "60",
+    );
+  });
+
+  it("sends a moved slider to the noise bridge and to localStorage", () => {
+    const bridge = withBridge();
+    const row = renderSetting();
+
+    const slider = within(row).getByRole("slider");
+    expect(slider).toHaveAttribute("aria-valuenow", "40");
+
+    fireEvent.keyDown(slider, { key: "ArrowRight" });
+
+    expect(bridge).toHaveBeenCalledWith(41, { persist: true, report: true });
+    expect(localStorage.getItem(NOISE_LEVEL_STORAGE_KEY)).toBe("41");
+    expect(slider).toHaveAttribute("aria-valuenow", "41");
+    expect(within(row).getByText("41 dB")).toBeInTheDocument();
+  });
+
+  it("says so instead of offering an empty slider when the bridge is missing", () => {
+    const row = renderSetting();
+
+    expect(within(row).getByRole("slider")).toHaveAttribute("data-disabled");
+    expect(
+      within(row).getByText(/noise suppression is not available/i),
+    ).toBeInTheDocument();
+  });
+});
+
+describe("the audio tab of the settings modal", () => {
+  beforeEach(() => {
+    localStorage.clear();
+    delete window.__plotinaSetLevel;
+  });
+
+  it("carries the noise suppression row", () => {
+    withBridge();
+
+    render(
+      <TooltipProvider>
+        <MediaDevicesContext
+          value={mockMediaDevices({ requestDeviceNames: (): void => {} })}
+        >
+          <SettingsModal
+            open
+            onDismiss={vi.fn()}
+            tab="audio"
+            onTabChange={vi.fn()}
+            client={mockClient}
+          />
+        </MediaDevicesContext>
+      </TooltipProvider>,
+    );
+
+    const row = noiseRow();
+    expect(within(row).getByRole("slider")).toHaveAttribute(
+      "aria-valuenow",
+      "40",
+    );
+    expect(within(row).getByText("40 dB")).toBeInTheDocument();
+  });
+});
