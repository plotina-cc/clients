+Please see LICENSE in the repository root for full details.
+*/
+
+import { beforeEach, describe, expect, test, vi } from "vitest";
+import { Track, type RemoteTrackPublication } from "livekit-client";
+
+import {
+  mockRemoteParticipant,
+  mockRemoteScreenShare,
+  mockRtcMembership,
+} from "../../utils/test";
+import {
+  ACCOUNT_DATA_TYPE,
+  LOCAL_STORAGE_KEY,
+  persistentVolumeStore,
+  STREAM_VIDEO_KEY_SUFFIX,
+  streamVideoKey,
+  type VoiceVolumeClient,
+  type VoiceVolumeEvent,
+} from "../PersistentVolume";
+import { type RemoteScreenShareViewModel } from "./RemoteScreenShareViewModel";
+
+const ALICE = "@alice:example.org";
+const BOB = "@bob:example.org";
+const rtcMembership = mockRtcMembership(ALICE, "AAAA");
+
+interface FakePublication {
+  publication: RemoteTrackPublication;
+  setSubscribed: ReturnType<typeof vi.fn>;
+}
+
+/** A publication that records the subscription changes made to it. */
+function fakePublication(): FakePublication {
+  const setSubscribed = vi.fn();
+  return {
+    publication: { setSubscribed } as unknown as RemoteTrackPublication,
+    setSubscribed,
+  };
+}
+
+interface FakeClient {
+  client: VoiceVolumeClient;
+  setAccountData: ReturnType<typeof vi.fn>;
+  /** Delivers account data as if it had arrived from another device. */
+  emit(content: unknown): void;
+}
+
+/** A Matrix client that only knows the bits the store touches. */
+function fakeClient(initial?: unknown): FakeClient {
+  const listeners = new Set<(event: VoiceVolumeEvent) => void>();
+  const setAccountData = vi.fn().mockResolvedValue({});
+  const client: VoiceVolumeClient = {
+    getUserId: (): string => "@me:example.org",
+    getAccountData: (type: string): { getContent(): unknown } | undefined =>
+      type === ACCOUNT_DATA_TYPE && initial !== undefined
+        ? { getContent: () => initial }
+        : undefined,
+    setAccountData,
+    on: (_event: string, listener: (event: VoiceVolumeEvent) => void): void => {
+      listeners.add(listener);
+    },
+    off: (
+      _event: string,
+      listener: (event: VoiceVolumeEvent) => void,
+    ): void => {
+      listeners.delete(listener);
+    },
+  };
+  return {
+    client,
+    setAccountData,
+    emit: (content: unknown): void => {
+      for (const listener of listeners) {
+        listener({
+          getType: () => ACCOUNT_DATA_TYPE,
+          getContent: () => content,
+        });
+      }
+    },
+  };
+}
+
+/** Creates the screen share of `mxid`, publishing through `publication`. */
+function screenShare(
+  publication: RemoteTrackPublication = fakePublication().publication,
+  mxid: string = ALICE,
+): RemoteScreenShareViewModel {
+  const participant = mockRemoteParticipant({
+    getTrackPublication: (source?: Track.Source): RemoteTrackPublication =>
+      (source === Track.Source.ScreenShare
+        ? publication
+        : undefined) as RemoteTrackPublication,
+    setVolume: vi.fn(),
+  });
+  return mockRemoteScreenShare(
+    mxid === ALICE ? rtcMembership : mockRtcMembership(mxid, "BBBB"),
+    {},
+    participant,
+  );
+}
+
+/** Points the shared store at a fake account, with a clean cache. */
+function useAccount(initial?: unknown): FakeClient {
+  const fake = fakeClient(initial);
+  (window as unknown as { matrixclient: unknown }).matrixclient = fake.client;
+  account = fake;
+  return fake;
+}
+
+/** The account the most recent test is signed in to. */
+let account: FakeClient;
+
+beforeEach(() => {
+  window.localStorage.clear();
+  // The store is a process-wide singleton that remembers its account, so each
+  // test starts from the same state a page load would: an empty cache and a
+  // client it has not seen before.
+  persistentVolumeStore().dispose();
+  useAccount();
+});
+
+describe("screen share video visibility", () => {
+  test("a stream is hidden, and not received, by default", () => {
+    // Somebody else's share arrives hidden: the viewer turns it on with the
+    // tile's button (t_6d5f61b4). Nothing is stored for "hidden", so a fresh
+    // account, a fresh share and a fresh call all start the same way.
+    const { publication, setSubscribed } = fakePublication();
+    const vm = screenShare(publication);
+    expect(vm.videoVisible$.value).toBe(false);
+    expect(setSubscribed).toHaveBeenCalledWith(false);
+  });
+
+  test("a stored choice to show a stream still shows it", () => {
+    // What an older build wrote when the default was "show": honoured, so the
+    // upgrade does not hide a stream this viewer asked to watch.
+    useAccount({ [streamVideoKey(ALICE)]: { visible: true, ts: 1_700_000 } });
+    const { publication, setSubscribed } = fakePublication();
+    const vm = screenShare(publication);
+    expect(vm.videoVisible$.value).toBe(true);
+    expect(setSubscribed).toHaveBeenCalledWith(true);
+  });
+
+  test("hiding a stream unsubscribes its video track", () => {
+    const { publication, setSubscribed } = fakePublication();
+    const vm = screenShare(publication);
+    // The viewer asked for this stream, then hides it again: the video must be
+    // taken out of the subscription, not merely left for the renderer to skip.
+    vm.setVideoVisible(true);
+    vm.setVideoVisible(false);
+    expect(vm.videoVisible$.value).toBe(false);
