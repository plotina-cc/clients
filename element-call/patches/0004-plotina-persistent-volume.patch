+
+import { type MatrixClient } from "matrix-js-sdk/lib/matrix";
+import { beforeEach, describe, expect, test, vi } from "vitest";
+
+import { constant } from "./Behavior";
+import { createVolumeControls } from "./VolumeControls";
+import { testScope } from "../utils/test";
+import {
+  ACCOUNT_DATA_TYPE,
+  LOCAL_STORAGE_KEY,
+  MAX_ENTRIES,
+  mergeVolumeMaps,
+  parseStoredVolumes,
+  PersistentVolumeStore,
+  persistentVolumeStore,
+  rememberParticipantVolume,
+  screenShareVolumeKey,
+  WRITE_DEBOUNCE_MS,
+  type SavedVoiceVolume,
+  type VoiceVolumeClient,
+  type VoiceVolumeEvent,
+  type VoiceVolumeMap,
+} from "./PersistentVolume";
+
+const ALICE = "@alice:example.org";
+
+interface FakeClient {
+  client: VoiceVolumeClient;
+  setAccountData: ReturnType<typeof vi.fn>;
+  emit(content: unknown): void;
+}
+
+/** A Matrix client that only knows the bits the store touches. */
+function mockClient(initial?: unknown): FakeClient {
+  const listeners = new Set<(event: VoiceVolumeEvent) => void>();
+  const writes: [string, unknown][] = [];
+  const setAccountData = vi.fn(async (type: string, content: unknown) => {
+    await Promise.resolve();
+    writes.push([type, content]);
+    return {};
+  });
+  const client: VoiceVolumeClient = {
+    getUserId: (): string => ALICE,
+    getAccountData: (type: string): { getContent(): unknown } | undefined =>
+      type === ACCOUNT_DATA_TYPE && initial !== undefined
+        ? { getContent: () => initial }
+        : undefined,
+    setAccountData,
+    on: (_event: string, listener: (event: VoiceVolumeEvent) => void): void => {
+      listeners.add(listener);
+    },
+    off: (
+      _event: string,
+      listener: (event: VoiceVolumeEvent) => void,
+    ): void => {
+      listeners.delete(listener);
+    },
+  };
+  return {
+    client,
+    setAccountData,
+    emit: (content: unknown): void => {
+      for (const listener of listeners) {
+        listener({
+          getType: () => ACCOUNT_DATA_TYPE,
+          getContent: () => content,
+        });
+      }
+    },
+  };
+}
+
+function storeWith(
+  client: FakeClient,
+  storage: Storage = window.localStorage,
+): PersistentVolumeStore {
+  return new PersistentVolumeStore({
+    client: client.client,
+    storage,
+    now: () => Date.now(),
+  });
+}
+
+beforeEach(() => {
+  window.localStorage.clear();
+});
+
+describe("mergeVolumeMaps", () => {
+  test("keeps keys only one side knows about", () => {
+    const merged = mergeVolumeMaps(
+      { [ALICE]: { volume: 0.5, muted: false, ts: 100 } },
+      { "@bob:example.org": { volume: 0.2, muted: false, ts: 50 } },
+    );
+    expect(Object.keys(merged).sort()).toEqual([ALICE, "@bob:example.org"]);
+  });
+
+  test("the newer write wins per key", () => {
+    const merged = mergeVolumeMaps(
+      { [ALICE]: { volume: 0.5, muted: false, ts: 100 } },
+      { [ALICE]: { volume: 0.8, muted: true, ts: 200 } },
+    );
+    expect(merged[ALICE]).toEqual({ volume: 0.8, muted: true, ts: 200 });
+  });
+
+  test("an older write does not overwrite the newer one", () => {
+    const merged = mergeVolumeMaps(
+      { [ALICE]: { volume: 0.5, muted: false, ts: 200 } },
+      { [ALICE]: { volume: 0.8, muted: true, ts: 100 } },
+    );
+    expect(merged[ALICE]).toEqual({ volume: 0.5, muted: false, ts: 200 });
+  });
+
+  test("a tie goes to the writer we merged in", () => {
+    const merged = mergeVolumeMaps(
+      { [ALICE]: { volume: 0.5, muted: false, ts: 100 } },
+      { [ALICE]: { volume: 0.8, muted: false, ts: 100 } },
+    );
+    expect(merged[ALICE].volume).toBe(0.8);
+  });
+});
+
+describe("parseStoredVolumes", () => {
+  test("broken JSON is a cold start, not an exception", () => {
+    expect(parseStoredVolumes("{not json")).toEqual({});
+    expect(parseStoredVolumes("[]")).toEqual({});
+    expect(parseStoredVolumes("null")).toEqual({});
+    expect(parseStoredVolumes(null)).toEqual({});
+  });
+
+  test("drops entries that are not about a Matrix user", () => {
+    expect(
+      parseStoredVolumes(
+        JSON.stringify({
+          "not-an-mxid": { volume: 0.5, muted: false, ts: 1 },
+          "@ok:example.org": { volume: 0.5, muted: false, ts: 1 },
+        }),
+      ),
+    ).toEqual({
+      "@ok:example.org": { volume: 0.5, muted: false, ts: 1 },
+    });
+  });
+
+  test("clamps volumes and treats a zero volume as muted", () => {
+    const parsed = parseStoredVolumes(
+      JSON.stringify({
+        "@a:example.org": { volume: 4, muted: false, ts: 1 },
+        "@b:example.org": { volume: -1, muted: false, ts: 1 },
+        "@c:example.org": { volume: 0, muted: false, ts: 1 },
+      }),
+    );
+    expect(parsed["@a:example.org"].volume).toBe(1);
+    expect(parsed["@b:example.org"]).toMatchObject({ volume: 0, muted: true });
+    expect(parsed["@c:example.org"]).toMatchObject({ volume: 0, muted: true });
+  });
+
+  test("drops entries whose volume is not a number", () => {
+    expect(
+      parseStoredVolumes(JSON.stringify({ [ALICE]: { volume: "loud" } })),
+    ).toEqual({});
+  });
+});
+
+describe("PersistentVolumeStore", () => {
+  test("nothing is remembered until the user adjusts somebody", () => {
+    const store = storeWith(mockClient());
+    expect(store.get(ALICE)).toEqual(null);
+  });
+
+  test("remembers the volume across a restart", () => {
+    storeWith(mockClient()).set(ALICE, 0.7);
+    // A restart is a fresh store reading the same cache.
+    expect(storeWith(mockClient()).get(ALICE)).toEqual({
+      volume: 0.7,
+      muted: false,
+    });
+  });
+
+  test("remembers muting, and the level to unmute back to", () => {
+    const store = storeWith(mockClient());
+    store.set(ALICE, 0.7);
+    store.set(ALICE, 0, true);
+    expect(store.get(ALICE)).toEqual({ volume: 0.7, muted: true });
+    expect(storeWith(mockClient()).get(ALICE)).toEqual({
+      volume: 0.7,
+      muted: true,
+    });
+  });
+
+  test("rejects volumes that are not numbers", () => {
+    const store = storeWith(mockClient());
+    store.set(ALICE, Number.NaN);
+    // @ts-expect-error - the point of the test is a value of the wrong type
+    store.set(ALICE, "0.5");
+    expect(store.get(ALICE)).toEqual(null);
+  });
+
+  test("clamps out-of-range volumes", () => {
+    const store = storeWith(mockClient());
+    store.set(ALICE, 12);
+    expect(store.get(ALICE)?.volume).toBe(1);
+    store.set(ALICE, -3);
+    expect(store.get(ALICE)).toMatchObject({ volume: 1, muted: true });
+  });
+
+  test("keeps the microphone and the screen share apart", () => {
+    const store = storeWith(mockClient());
+    store.set(ALICE, 0.4);
+    store.set(screenShareVolumeKey(ALICE), 0.9);
+    expect(store.get(ALICE)?.volume).toBe(0.4);
+    expect(store.get(screenShareVolumeKey(ALICE))?.volume).toBe(0.9);
+  });
+
+  test("writes account data once the slider settles", async () => {
+    vi.useFakeTimers();
+    try {
+      const client = mockClient();
+      const store = storeWith(client);
+      store.set(ALICE, 0.6);
+      store.set(ALICE, 0.7);
+      store.set(ALICE, 0.8);
+      expect(client.setAccountData).not.toHaveBeenCalled();
+      await vi.advanceTimersByTimeAsync(499);
+      expect(client.setAccountData).not.toHaveBeenCalled();
+      await vi.advanceTimersByTimeAsync(1);
+      expect(client.setAccountData).toHaveBeenCalledTimes(1);
+      expect(client.setAccountData).toHaveBeenCalledWith(ACCOUNT_DATA_TYPE, {
+        [ALICE]: { volume: 0.8, muted: false, ts: expect.any(Number) },
+      });
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  test("what the laptop saves is what the phone starts with", async () => {
+    vi.useFakeTimers();
+    try {
+      const laptop = mockClient();
+      storeWith(laptop).set(ALICE, 0.35);
+      await vi.advanceTimersByTimeAsync(WRITE_DEBOUNCE_MS);
+      const [type, content] = laptop.setAccountData.mock.calls[0] as [
+        string,
+        VoiceVolumeMap,
+      ];
+      expect(type).toBe(ACCOUNT_DATA_TYPE);
+      // The phone has never seen this account: its cache is empty, so all it
+      // has is the server's copy.
+      window.localStorage.clear();
+      expect(storeWith(mockClient(content)).get(ALICE)).toEqual({
+        volume: 0.35,
+        muted: false,
+      });
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  test("does not re-write a value it just applied from account data", async () => {
+    vi.useFakeTimers();
+    try {
+      const client = mockClient({
+        [ALICE]: { volume: 0.3, muted: false, ts: 10 },
+      });
+      storeWith(client);
+      await vi.advanceTimersByTimeAsync(1000);
+      expect(client.setAccountData).not.toHaveBeenCalled();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  test("reads the server's copy at start", () => {
+    const client = mockClient({
+      [ALICE]: { volume: 0.3, muted: false, ts: 10 },
+    });
+    expect(storeWith(client).get(ALICE)).toEqual({ volume: 0.3, muted: false });
+  });
+
+  test("applies a change made on another device", () => {
+    const client = mockClient();
+    const store = storeWith(client);
+    const seen: SavedVoiceVolume[] = [];
+    store.onChange(ALICE, () => {
+      seen.push(store.get(ALICE)!);
+    });
+
+    client.emit({ [ALICE]: { volume: 0.2, muted: true, ts: 20 } });
+    expect(seen).toEqual([{ volume: 0.2, muted: true }]);
+    // …and the cache is updated for the next start.
+    expect(storeWith(mockClient()).get(ALICE)).toEqual({
+      volume: 0.2,
+      muted: true,
+    });
+  });
+
+  test("ignores junk in account data", () => {
+    const client = mockClient();
+    const store = storeWith(client);
+    store.set(ALICE, 0.5);
+    expect(() => {
+      client.emit("not a map");
+      client.emit({ [ALICE]: 42 });
+      client.emit({ "@x:example.org": { volume: "loud" } });
+    }).not.toThrow();
+    expect(store.get(ALICE)?.volume).toBe(0.5);
+  });
+
+  test(`keeps at most ${MAX_ENTRIES} entries, dropping the oldest`, async () => {
+    vi.useFakeTimers();
+    try {
+      const client = mockClient();
+      const store = storeWith(client);
+      let ts = 1000;
+      for (let i = 0; i < MAX_ENTRIES + 100; i++) {
+        vi.setSystemTime(ts++);
+        store.set(`@user${i}:example.org`, 0.5);
+      }
+      await vi.advanceTimersByTimeAsync(1000);
+      const written = client.setAccountData.mock.calls[0][1] as VoiceVolumeMap;
+      expect(Object.keys(written)).toHaveLength(MAX_ENTRIES);
+      // The newest entries survived, the oldest were evicted.
+      expect(written["@user99:example.org"]).toBeUndefined();
+      expect(written[`@user${MAX_ENTRIES + 99}:example.org`]).toBeDefined();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  test("works from the cache when there is no account data, and survives a failed write", async () => {
+    vi.useFakeTimers();
+    try {
+      const client = mockClient();
+      client.setAccountData.mockRejectedValueOnce(
+        new Error("M_LIMIT_EXCEEDED"),
+      );
+      const store = storeWith(client);
+      store.set(ALICE, 0.6);
+      await vi.advanceTimersByTimeAsync(500);
+      expect(store.get(ALICE)?.volume).toBe(0.6);
+      expect(storeWith(mockClient()).get(ALICE)?.volume).toBe(0.6);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  test("survives a corrupt cache", () => {
+    window.localStorage.setItem(LOCAL_STORAGE_KEY, "{oops");
+    const store = storeWith(mockClient());
+    expect(store.get(ALICE)).toEqual(null);
+    store.set(ALICE, 0.5);
+    expect(store.get(ALICE)?.volume).toBe(0.5);
+  });
+});
+
+describe("rememberParticipantVolume", () => {
+  test("restores the saved level into a fresh set of controls", () => {
+    const client = mockClient({
+      [ALICE]: { volume: 0.4, muted: false, ts: 10 },
+    });
+    window.matrixclient = client.client as unknown as MatrixClient;
+    const sink = vi.fn();
+    const scope = testScope();
