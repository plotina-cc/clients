+      controls.adjustPlaybackVolume(0.3);
+      controls.adjustPlaybackVolume(0.25);
+      controls.commitPlaybackVolume();
+      await vi.advanceTimersByTimeAsync(500);
+      const written = client.setAccountData.mock.lastCall?.[1] as
+        | VoiceVolumeMap
+        | undefined;
+      expect(written?.["@slider:example.org"]).toEqual({
+        volume: 0.25,
+        muted: false,
+        ts: expect.any(Number),
+      });
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  test("does not record anything just because a tile appeared", async () => {
+    vi.useFakeTimers();
+    try {
+      const client = mockClient();
+      window.matrixclient = client.client as unknown as MatrixClient;
+      const scope = testScope();
+      const controls = createVolumeControls(scope, {
+        pretendToBeDisconnected$: constant(false),
+        sink$: constant(vi.fn()),
