+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import * as Sentry from "@sentry/react";
+
+/**
+ * Plotina: early error reporting for the Element Call we serve at
+ * call.plotina.cc.
+ *
+ * Upstream initialises Sentry from the runtime config (config.json -> sentry)
+ * only once config.json has loaded, in initializer.tsx. That is too late for
+ * the failures we care about most: a crash in the first render, a failed
+ * config fetch, a broken widget handshake. This module initialises from the
+ * build environment instead and is called from src/main.tsx before anything
+ * renders.
+ *
+ * The DSN comes from VITE_SENTRY_DSN at build time, the release from
+ * VITE_SENTRY_RELEASE (the tag CI built from). Both are optional: an empty DSN
+ * is the normal case for `pnpm dev` and for a plain fork, and turns reporting
+ * off without touching anything else. Nothing here throws without a DSN.
+ */
+
+const dsn = String(import.meta.env.VITE_SENTRY_DSN ?? "").trim();
+
+/** True when this build was given a DSN. */
+export const plotinaSentryEnabled = dsn !== "";
+
+export function initPlotinaSentry(): void {
+  if (!plotinaSentryEnabled) return;
+
+  const release =
+    String(import.meta.env.VITE_SENTRY_RELEASE ?? "").trim() ||
+    `element-call@${import.meta.env.VITE_APP_VERSION || "dev"}`;
+
+  Sentry.init({
+    dsn,
+    release,
+    environment: "production",
+    // Errors only: this host is small and the call UI has no backend tracing
+    // worth paying for.
+    tracesSampleRate: 0,
+    sendDefaultPii: false,
+    initialScope: {
+      tags: { client: "element-call" },
+    },
+  });
+}
