+Please see LICENSE in the repository root for full details.
+*/
+
+/**
+ * Plotina: DeepFilterNet3 as a LiveKit track processor.
+ *
+ * This file is only the bridge. The processor itself lives in
+ * /noise/plotina-dfn.js, loaded as a plain script by index.html, so the attach
+ * strategy, the level and the debug badge can be changed by replacing one file
+ * on the edge — no Element Call rebuild, no new release.
+ */
+
+type AttachFn = (track: unknown) => void;
+type EventFn = (source: string, hasTrack: boolean) => void;
+type ReportFn = (kind: string, extra?: Record<string, string>) => void;
+
+const w = window as unknown as {
+  __plotinaAttach?: AttachFn;
+  __plotinaEvent?: EventFn;
+  __plotinaReport?: ReportFn;
+};
+
+export function attachPlotinaDfn(track: unknown): void {
+  if (typeof w.__plotinaAttach === "function") {
+    w.__plotinaAttach(track);
+  } else {
+    console.warn("[plotina] /noise/plotina-dfn.js is not loaded");
+  }
+}
+
+export function notePlotinaEvent(source: string, hasTrack: boolean): void {
+  if (typeof w.__plotinaEvent === "function") {
+    w.__plotinaEvent(source, hasTrack);
+  }
+}
+
+/** Free-form beacon for the hook itself, before any track exists. */
+export function reportPlotina(
+  kind: string,
+  extra?: Record<string, string>,
+): void {
+  if (typeof w.__plotinaReport === "function") w.__plotinaReport(kind, extra);
+}
