# Pins for element-call/. Sourced by build.sh and by
# .github/workflows/build-element-call.yml. Plain KEY=VALUE lines: no quotes,
# no trailing comments on the value lines.

# Element Call web, https://github.com/element-hq/element-call
#
# v0.26.1 is the version the clients in this repository already ship:
#   - Element X Android v26.10.1 embeds io.element.android:element-call-embedded:0.26.1
#   - Element Web v1.12.32 embeds @element-hq/element-call-embedded:0.26.0
# Bumping this means bumping the clients, not just the server: the widget URL
# parameters and the MatrixRTC transport handshake are a contract between the
# two ends of the postMessage bridge.
EC_TAG=v0.26.1

# sha256 of releases/download/v0.26.1/element-call-0.26.1.tar.gz, measured on
# 2026-10-28. The tarball ships index.html, favicon.png and assets/ only — the
# config.json is the operator's to add, which is why this build exists.
EC_TARBALL_SHA256=552e16f81d602c5947087d0b1d7d5d0d5546f1bd34e5d5e84c9605d621e8f254

EC_REPO=https://github.com/element-hq/element-call

# Toolchain for --mode source (upstream .node-version is 24; packageManager in
# package.json is pnpm 11.21.0). Unused in the default release mode.
NODE_VERSION=24
PNPM_VERSION=11.21.0

# DeepFilterNet3 assets consumed by noise/vendor/dfn.esm.js at runtime, laid out
# under dist/noise/dfn/. Same two digests as element-web/Dockerfile and
# cinny/noise.lock.json: bump all three together or the clients disagree about
# what "level 60" means.
DFN_BASE=https://cdn.mezon.ai/AI/models/datas/noise_suppression/deepfilternet3/v3
DFN_WASM_SHA256=440b5d12b6ea7d95008736f844221d7874ee15de5cb10d3015002470fdba0432
DFN_MODEL_SHA256=c94d91f70911001c946e0fabb4aa9adc37045f45a03b56008cb0c8244cb63616
